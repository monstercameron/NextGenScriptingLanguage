{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://execute.invalid/schemas/ai-productivity-external-package-1.json",
  "title": "Externally owned sealed Execute AI productivity task package",
  "type": "object",
  "required": ["schema", "preregistration_sha256", "randomization_seed", "frozen_utc", "tasks"],
  "properties": {
    "schema": {"const": "execute.ai-productivity.external-package/1"},
    "preregistration_sha256": {"$ref": "#/$defs/sha256"},
    "randomization_seed": {"type": "integer"},
    "frozen_utc": {"type": "string", "format": "date-time"},
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "criterion": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
    "input": {
      "type": "object",
      "required": ["environment", "program_input", "default"],
      "properties": {
        "environment": {"type": "string", "pattern": "^EVAL_[A-Z0-9_]+$"},
        "program_input": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "default": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["case_id", "files", "expected"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
        "files": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "inputs": {"type": "object", "additionalProperties": {"type": "string"}},
        "expected": {}
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": ["task_id", "family_id", "split", "stratum", "prompt", "oracle", "criteria", "inputs", "output_path", "cases"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
        "family_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
        "split": {"enum": ["development", "calibration", "held_out"]},
        "stratum": {"enum": ["workflow_cli", "desktop_composition", "maintenance_change"]},
        "prompt": {"type": "string", "minLength": 1},
        "oracle": {
          "type": "object",
          "required": ["kind"],
          "properties": {"kind": {"enum": ["utf8_exact", "json_value", "json_lines"]}},
          "additionalProperties": true
        },
        "criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/criterion"}},
        "optional_criteria": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/criterion"}},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
        "output_path": {"type": "string", "minLength": 1},
        "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
      },
      "additionalProperties": false
    }
  }
}
