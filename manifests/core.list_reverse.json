{
  "name": "list.reverse",
  "description": "Return the input list in reverse order without changing its values.",
  "phrases": [
    "list reverse",
    "items reverse"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "items": {
      "type": "json",
      "required": true,
      "description": "List to reverse."
    }
  },
  "arguments": [
    {
      "literal": "list.reverse"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "list",
      "items": {
        "type": "json"
      }
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "items": {
          "delivery": "single",
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "items": {
              "type": "json"
            },
            "type": "list"
          }
        }
      }
    },
    "capabilities": [
      "data.transform"
    ]
  },
  "examples": [
    {
      "program": "run list.reverse with items [1, 2, 3] as result",
      "expected_output": [
        3,
        2,
        1
      ]
    }
  ]
}
