{
  "name": "list.chunk",
  "description": "Provides list.chunk for controlled scripts.",
  "phrases": [
    "list chunk",
    "items chunk"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "items": {
      "type": "json"
    },
    "size": {
      "type": "integer"
    }
  },
  "arguments": [
    {
      "literal": "list.chunk"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "list",
      "items": {
        "type": "json"
      }
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "items": {
          "delivery": "single",
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          }
        },
        "size": {
          "delivery": "single",
          "schema": {
            "type": "integer"
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "items": {
              "type": "json"
            },
            "type": "list"
          }
        }
      }
    },
    "capabilities": [
      "data.transform"
    ]
  }
}
