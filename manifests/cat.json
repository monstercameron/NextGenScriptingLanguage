{
  "name": "cat",
  "description": "Copies the contents of the selected files to standard output; with no file argument, it reads standard input.",
  "phrases": [
    "copy"
  ],
  "binary": "cat",
  "accepts_stdin": true,
  "cacheable": false,
  "parameters": {
    "path": {
      "type": "string"
    },
    "files": {
      "type": "list",
      "items": "string",
      "min_items": 1
    }
  },
  "arguments": [
    {
      "literal": "--"
    },
    {
      "when_present": "path",
      "append": [
        {
          "parameter": "path"
        }
      ]
    },
    {
      "when_present": "files",
      "append": [
        {
          "spread": "files"
        }
      ]
    }
  ]
}
