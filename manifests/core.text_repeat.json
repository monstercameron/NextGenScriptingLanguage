{
  "name": "text.repeat",
  "description": "Provides text.repeat for controlled scripts.",
  "phrases": [
    "repeat text"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string"
    },
    "count": {
      "type": "unsigned_integer",
      "required": true
    }
  },
  "parameter_alternatives": [
    {
      "message": "count must be a nonnegative integer",
      "any_of": [
        [
          {
            "test": "nonnegative_integer",
            "parameter": "count"
          }
        ]
      ]
    }
  ],
  "arguments": [
    {
      "literal": "text.repeat"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "text"
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        },
        "count": {
          "delivery": "single",
          "schema": {
            "type": "usize"
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        }
      }
    },
    "capabilities": [
      "text.transform"
    ]
  }
}
