{
  "name": "fs.unlink_checked",
  "description": "Provides the fs unlink checked operation for controlled scripts.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "stdio": {
    "stderr": "discard"
  },
  "parameters": {
    "path": {
      "type": "path",
      "required": true
    },
    "expected_snapshot": {
      "type": "string",
      "required": true
    },
    "lock": {
      "type": "path"
    },
    "lock_timeout_ms": {
      "type": "integer"
    }
  },
  "arguments": [
    {
      "literal": "fs.unlink_checked"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "command",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "json",
      "encoding": "json"
    },
    "outcomes": [
      {
        "status": 0,
        "name": "success",
        "kind": "success"
      },
      {
        "status": 1,
        "name": "absence",
        "kind": "absence"
      },
      {
        "status": 2,
        "name": "failure",
        "kind": "failure"
      },
      {
        "status": 75,
        "name": "retryable",
        "kind": "retryable"
      },
      {
        "status": 76,
        "name": "uncertain_effect",
        "kind": "failure"
      }
    ],
    "capabilities": [
      "filesystem.read",
      "filesystem.write",
      "filesystem.lock"
    ],
    "effects": [
      "filesystem.write",
      "filesystem.lock"
    ],
    "result_envelope": true
  }
}
