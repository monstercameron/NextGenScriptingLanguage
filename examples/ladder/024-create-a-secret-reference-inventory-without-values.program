# Purpose: Inventory only variable names designated by this project's SECRET_ prefix convention; this is not general secret detection.
# Inputs: secrets/runtime.env follows that convention; DB_PASSWORD and API_TOKEN decoys are intentionally not classified.
# Outputs: reports/secret-variable-names.txt contains sorted SECRET_ names only; values and nonmatching keys are omitted.
accept runtime_path as text with default "secrets/runtime.env"
run mkdir with flags ["-p"] and paths ["reports"]
run cat with path runtime_path
pipe to grep with pattern "^SECRET_"
pipe to cut with delimiter "=" and fields "1"
pipe to sort
pipe to uniq
then save to "reports/secret-variable-names.txt"
