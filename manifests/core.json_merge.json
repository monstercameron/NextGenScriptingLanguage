{
  "name": "json.merge",
  "description": "Combines two JSON objects, with right-hand values replacing left-hand values for duplicate keys.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "left": {
      "type": "record",
      "required": true,
      "fields": {},
      "additional_properties": {
        "type": "json"
      },
      "description": "First JSON object supplying the initial members."
    },
    "right": {
      "type": "record",
      "required": true,
      "fields": {},
      "additional_properties": {
        "type": "json"
      },
      "description": "Second JSON object whose members are added or replace matching keys from left."
    }
  },
  "arguments": [
    {
      "literal": "json.merge"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "json"
    },
    "capabilities": [
      "json.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "left": {
          "schema": {
            "type": "record",
            "fields": {},
            "additionalProperties": {
              "type": "json"
            }
          },
          "delivery": "single"
        },
        "right": {
          "schema": {
            "type": "record",
            "fields": {},
            "additionalProperties": {
              "type": "json"
            }
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "json"
          }
        }
      }
    }
  },
  "phrases": [
    "json merge"
  ],
  "examples": [
    {
      "program": "run json.merge with left {\"name\":\"Ada\",\"role\":\"writer\"} and right {\"role\":\"editor\"} as result",
      "expected_output": {
        "name": "Ada",
        "role": "editor"
      }
    }
  ]
}
