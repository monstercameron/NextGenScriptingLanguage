{
  "name": "fs.glob",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "pattern": {
      "type": "string",
      "required": true
    },
    "include_hidden": {
      "type": "boolean"
    }
  },
  "arguments": [
    { "literal": "fs.glob" },
    { "literal": "--args" },
    { "json_arguments": true }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": { "kind": "oneshot" },
    "output": {
      "type": "list",
      "encoding": "json",
      "items": { "type": "text" }
    },
    "capabilities": ["filesystem.read"],
    "effects": [],
    "ports": {
      "inputs": {
        "pattern": {
          "schema": { "type": "text" },
          "delivery": "single"
        },
        "include_hidden": {
          "schema": { "type": "boolean" },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "list",
            "items": { "type": "text" }
          },
          "delivery": "single"
        }
      }
    }
  }
}
