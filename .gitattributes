# Keep source consistent across native Windows and Unix checkouts.
* text=auto
*.rs text eol=lf
*.py text eol=lf
*.program text eol=lf
*.sh text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Makefile text eol=lf
*.png binary
*.wasm binary
*.vsix binary
/bin/execute binary

# Separate upstream source and retained evidence from project code statistics.
vendor/** linguist-vendored
docs/** linguist-documentation
benchmarks/optimization-pass/** linguist-documentation
work/** linguist-documentation

# Hash-pinned benchmark artifacts retain their exact raw bytes across checkouts.
benchmarks/**/*.bin binary
benchmarks/**/*.patch binary
# This is an immutable measured source snapshot, including its original whitespace.
benchmarks/payload-size-paired-macos-linux-20261016/source/direct-size-harness.rs binary

# Immutable graph-run logs, patches, and the original audited source keep raw whitespace.
benchmarks/graph-collector-queue-macos-arm64-20261016/** -text
benchmarks/graph-collector-queue-macos-arm64-20261016/**/*.log binary
benchmarks/graph-collector-queue-macos-arm64-20261016/**/*.diff binary
benchmarks/graph-collector-queue-macos-arm64-20261016/collector-e2e/audit/audit_graph_transport_e2e.py binary

# Immutable scalar-run inputs and reports retain their recorded byte hashes.
benchmarks/typed-json-carry-scalar-mixed-20261016/** -text
benchmarks/typed-json-carry-scalar-mixed-20261016/**/*.log binary
benchmarks/typed-json-carry-scalar-mixed-20261016/**/*.diff binary

# Immutable structured JSON and hosted collector evidence retain exact bytes.
benchmarks/typed-json-carry-structured-20261016/** -text
benchmarks/typed-json-carry-structured-20261016/**/*.log binary
benchmarks/typed-json-carry-structured-20261016/**/*.diff binary
benchmarks/graph-collector-hosted-linux-proof-20261016/** -text
benchmarks/graph-collector-hosted-linux-proof-20261016/**/*.log binary
benchmarks/graph-collector-hosted-linux-proof-20261016/**/*.diff binary

# Immutable line-framing source snapshots and raw measurements.
benchmarks/line-framing-memchr-macos-arm64-20261016/** -text
benchmarks/line-framing-memchr-macos-arm64-20261016/**/*.log binary
benchmarks/line-framing-memchr-macos-arm64-20261016/**/*.diff binary

# Immutable public decoder source snapshots, reports, and retained failures.
benchmarks/text-json-decoder-macos-arm64-20261016/** -text
benchmarks/text-json-decoder-macos-arm64-20261016/**/*.log binary
benchmarks/text-json-decoder-macos-arm64-20261016/**/*.diff binary
# Bundled manifest index: text with LF endings, and a binary compressed body blob.
src/bundled_manifests/index.tsv text eol=lf
src/bundled_manifests/bodies.bin binary

# Model fixtures match the exact request text, so their sources must keep LF on every checkout.
examples/ai-gauntlet/** text eol=lf
