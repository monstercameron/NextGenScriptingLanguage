{
  "name": "text.starts_with",
  "description": "Returns whether the input text begins with the exact supplied prefix.",
  "phrases": [
    "check text prefix"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "description": "Text to inspect; omitted text is read from UTF-8 stdin."
    },
    "prefix": {
      "type": "string",
      "required": true,
      "description": "Exact beginning to test; an empty prefix matches."
    }
  },
  "arguments": [
    {
      "literal": "text.starts_with"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "boolean"
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        },
        "prefix": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "boolean"
          }
        }
      }
    },
    "capabilities": [
      "text.transform"
    ]
  },
  "examples": [
    {
      "program": "run text.starts_with with text \"release-notes\" and prefix \"release\" as value",
      "expected_output": true
    }
  ]
}
