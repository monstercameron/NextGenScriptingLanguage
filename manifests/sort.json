{
  "name": "sort",
  "description": "Provides the sort operation for controlled scripts.",
  "binary": "sort",
  "accepts_stdin": true,
  "parameters": {
    "flags": {
      "type": "list",
      "items": "string"
    }
  },
  "arguments": [
    {
      "when_present": "flags",
      "append": [
        {
          "spread": "flags"
        }
      ]
    }
  ]
}
