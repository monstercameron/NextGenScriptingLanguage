{
  "name": "ini.stringify",
  "description": "Serializes a JSON object of scalar top-level values and one-level section objects as the supported INI subset.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "value": {
      "type": "record",
      "required": true,
      "fields": {},
      "additional_properties": {
        "type": "json"
      },
      "description": "Object containing top-level scalar values and/or section objects whose members are scalar; arrays, nulls, nested sections and multiline values are unsupported."
    }
  },
  "arguments": [
    {
      "literal": "ini.stringify"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "json"
    },
    "capabilities": [
      "text.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "value": {
          "schema": {
            "type": "record",
            "fields": {},
            "additionalProperties": {
              "type": "json"
            }
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "ini stringify"
  ],
  "examples": [
    {
      "program": "run ini.stringify with value {\"server\":{\"host\":\"localhost\"}} as ini",
      "expected_output": "[server]\nhost = localhost\n"
    }
  ]
}
