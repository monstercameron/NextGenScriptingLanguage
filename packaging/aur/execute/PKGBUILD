# Maintainer: Execute maintainers <noreply@github.com>
# Builds the tagged source with cargo. tools/aur.py renders _tag and the checksum for each release.
pkgname=execute
_tag=0.9.0-rc.5
pkgver=${_tag//-/_}
pkgrel=1
pkgdesc='Readable native command workflows (built from source)'
arch=('x86_64' 'aarch64')
url='https://github.com/monstercameron/NextGenScriptingLanguage'
license=('MIT')
makedepends=('rust')
provides=('execute')
conflicts=('execute-bin')
_srcname="NextGenScriptingLanguage-${_tag}"
source=("${_srcname}.tar.gz::${url}/archive/refs/tags/v${_tag}.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$_srcname"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$_srcname"
  export CARGO_TARGET_DIR=target
  cargo build --locked --profile dist --bins
}

package() {
  cd "$_srcname"
  install -Dm755 target/dist/execute "$pkgdir/usr/bin/execute"
  install -Dm755 target/dist/execute-model "$pkgdir/usr/bin/execute-model"
  install -Dm755 target/dist/execute-applet "$pkgdir/usr/bin/execute-applet"
  install -dm755 "$pkgdir/usr/share/execute"
  cp -a manifests "$pkgdir/usr/share/execute/manifests"
  install -dm755 "$pkgdir/usr/share/execute/docs"
  for doc in language.md grammar.md windows.md releases.md; do
    install -Dm644 "docs/$doc" "$pkgdir/usr/share/execute/docs/$doc"
  done
  install -Dm644 editors/vscode/syntaxes/execute.tmLanguage.json \
    "$pkgdir/usr/share/execute/editors/vscode/syntaxes/execute.tmLanguage.json"
  install -Dm644 editors/vscode/language-configuration.json \
    "$pkgdir/usr/share/execute/editors/vscode/language-configuration.json"
  install -Dm644 README.md "$pkgdir/usr/share/execute/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/execute/LICENSE"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 completions/execute.bash "$pkgdir/usr/share/bash-completion/completions/execute"
  install -Dm644 completions/_execute "$pkgdir/usr/share/zsh/site-functions/_execute"
  install -Dm644 completions/execute.fish "$pkgdir/usr/share/fish/vendor_completions.d/execute.fish"
  install -Dm644 docs/man/execute.1 "$pkgdir/usr/share/man/man1/execute.1"
}
