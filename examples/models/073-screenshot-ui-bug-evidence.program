# Purpose: Combine OCR element IDs, role hints, and visible text into a bug-report draft that keeps uncertain interpretation separate.
# Inputs: JSON OCR capture is a synthetic local accessibility test export keyed by SHOT-* IDs.
# Outputs: out/073-screenshot-ui-bug-evidence.json: reproducible evidence summary, not a claim about live UI behavior.
accept live as boolean with default false
accept source_path as text with default "fixtures/073/source-high.json"
accept report_path as text with default "out/073-screenshot-ui-bug-evidence.json"
accept classify_fixture_path as text with default "fixtures/073/classify-high.json"
accept draft_fixture_path as text with default "fixtures/073/draft.json"
accept generator_model as text with default "gpt-6-luna"
accept env_file as text with default ".env"
# Refuse an output path that aliases an existing evidence or schema file.
run "test" with arguments ["!", source_path, "-ef", report_path]
run cat with path source_path
then jq with filter ".elements[] | [.id, .role, .text, .bounds] | @tsv" and flags ["-r"] as evidence
if live is true
  then jev.classify with question "Does this OCR and role snapshot provide a specific reproducible UI accessibility bug lead?" and labels ["reproducible-ui-lead", "needs-human"] and minimum 80 and env_file env_file as class_raw # execute-allow: lint.unused_binding intentional model-result capture for acceptance analysis and downstream parsing
otherwise
  then jev.classify with question "Does this OCR and role snapshot provide a specific reproducible UI accessibility bug lead?" and labels ["reproducible-ui-lead", "needs-human"] and minimum 80 and fixture classify_fixture_path and env_file env_file as class_raw
then parse json as classification
take text at "/label" from classification as label
take integer at "/confidence_percent" from classification as confidence
take boolean at "/accepted" from classification as accepted
if accepted is true
  if label is "reproducible-ui-lead"
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "label", label, "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "{label:$label,confidence_percent:$confidence,evidence:$evidence}"]
    if live is true
      then llm.ask with model generator_model and instruction "Draft a bug evidence bundle from supplied SHOT-* rows: expected versus visible role/text, coordinates, and reproduction questions. Cite IDs; identify OCR uncertainty and never infer hidden behavior from pixels alone." and env_file env_file as draft_raw # execute-allow: lint.unused_binding intentional generated-text capture for review validation and downstream parsing
    otherwise
      then llm.ask with model generator_model and instruction "Draft a bug evidence bundle from supplied SHOT-* rows: expected versus visible role/text, coordinates, and reproduction questions. Cite IDs; identify OCR uncertainty and never infer hidden behavior from pixels alone." and fixture draft_fixture_path and env_file env_file as draft_raw
    then parse json as draft_result
    take text at "/text" from draft_result as draft
    run jq with flags ["-n", "-r", "--arg", "draft", draft, "--arg", "evidence", evidence] and filter "($draft | rtrimstr(\"\\n\")) as $candidate | if ($candidate | startswith(\"EVIDENCE:\")) and ([$evidence | scan(\"[A-Z][A-Z0-9]+-[A-Z0-9-]+\") | . as $id | select($candidate | contains($id))] | length > 0) then $candidate else error(\"draft must start with EVIDENCE and cite an ID present in the bounded evidence\") end" as validated_draft
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "screenshot_ui_bug_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "draft", validated_draft, "--arg", "action", "Tester reproduces the issue in the actual interface and attaches approved evidence.", "{artifact:$artifact,status:\"draft-for-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,bug_evidence_bundle:$draft,action:$action}"]
    then save to report_path
  otherwise
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "screenshot_ui_bug_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "review_action", "The workflow processes a supplied snapshot only; it does not inspect a desktop or file a ticket.", "{artifact:$artifact,status:\"needs-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,bug_evidence_bundle:null,reason:\"Classifier selected the human-review label above the confidence threshold; no LLM draft was requested.\",action:$review_action}"]
    then save to report_path
  then cat with path report_path
otherwise
  then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "screenshot_ui_bug_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "review_action", "The workflow processes a supplied snapshot only; it does not inspect a desktop or file a ticket.", "{artifact:$artifact,status:\"needs-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,bug_evidence_bundle:null,reason:\"Classifier confidence is below the configured 80 percent threshold; no LLM draft was requested.\",action:$review_action}"]
  then save to report_path
then cat with path report_path
