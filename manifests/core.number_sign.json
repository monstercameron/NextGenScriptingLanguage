{
  "name": "number.sign",
  "description": "Return -1 for a negative number, 0 for zero, and 1 for a positive number.",
  "phrases": [
    "number sign",
    "value sign"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "value": {
      "type": "json",
      "required": true,
      "description": "Finite JSON number whose sign to return."
    }
  },
  "arguments": [
    {
      "literal": "number.sign"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "number"
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "number"
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "number"
          }
        }
      }
    },
    "capabilities": [
      "number.compute"
    ]
  },
  "examples": [
    {
      "program": "run number.sign with value -12 as result",
      "expected_output": -1
    }
  ]
}
