{
  "name": "list.sum",
  "description": "Add all numeric values in the input list and return their sum.",
  "phrases": [
    "sum values",
    "add list numbers"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "items": {
      "type": "list",
      "items": "json",
      "description": "List of finite numeric JSON values to add."
    },
    "key": {
      "type": "string",
      "description": "Accepted for compatibility; this sum operation reads numeric list values directly."
    },
    "n": {
      "type": "integer",
      "description": "Accepted for compatibility; this operation sums all values."
    },
    "collect": {
      "type": "boolean",
      "description": "Accepted for compatibility; this operation returns only the sum."
    },
    "delimiter": {
      "type": "string",
      "description": "Accepted for compatibility; this operation does not split input fields."
    },
    "field": {
      "type": "integer",
      "description": "Accepted for compatibility; this operation does not select an input field."
    }
  },
  "arguments": [
    {
      "literal": "list.sum"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "number",
      "encoding": "json"
    },
    "capabilities": [
      "data.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "items": {
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          },
          "delivery": "single"
        },
        "key": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "n": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "collect": {
          "schema": {
            "type": "boolean"
          },
          "delivery": "single"
        },
        "delimiter": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "field": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "number"
          },
          "delivery": "single"
        }
      }
    }
  },
  "examples": [
    {
      "program": "run list.sum with items [2, 3, 5] as result",
      "expected_output": 10
    }
  ]
}
