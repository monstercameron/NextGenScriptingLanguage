    def test_artifact_provenance_accepts_exact_test_and_helper_paths(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory) / "candidate"
            target_dir = Path(directory) / "target"
            (root / "Cargo.toml").parent.mkdir(parents=True)
            (root / "Cargo.toml").write_text("[package]\nname='execute'\n")
            test_source = root / "tests/opt_typed_json_carry.rs"
            test_source.parent.mkdir()
            test_source.write_text("// fixed harness\n")
            helper_source = root / "src/bin/execute-applet.rs"
            helper_source.parent.mkdir(parents=True)
            helper_source.write_text("fn main() {}\n")
            test_binary = target_dir / "release/deps/opt_typed_json_carry-hash"
            test_binary.parent.mkdir(parents=True)
            test_binary.write_bytes(b"test binary")
            helper_binary = target_dir / "release/execute-applet"
            helper_binary.parent.mkdir(parents=True, exist_ok=True)
            helper_binary.write_bytes(b"helper binary")

            def row(name, source, binary, kind, test):
                return {
                    "reason": "compiler-artifact",
                    "fresh": False,
                    "package_id": f"path+{root.as_uri()}#execute@0.1.0",
                    "manifest_path": str(root / "Cargo.toml"),
                    "target": {"name": name, "src_path": str(source), "kind": [kind], "test": test},
                    "profile": {"test": test, "opt_level": "3", "debug_assertions": False},
                    "executable": str(binary),
                    "filenames": [str(binary)],
                }

            selected = pair.validate_artifact_row(
                row("opt_typed_json_carry", test_source, test_binary, "test", True),
                side="candidate", root=root, target_name="opt_typed_json_carry",
                expected_source=Path("tests/opt_typed_json_carry.rs"), test_profile=True,
                target_dir=target_dir,
            )
            self.assertEqual(selected, test_binary.resolve())
            selected_helper = pair.validate_helper_artifact(
                row("execute-applet", helper_source, helper_binary, "bin", False),
                side="candidate", root=root, target_dir=target_dir,
            )
            self.assertEqual(selected_helper, helper_binary.resolve())

