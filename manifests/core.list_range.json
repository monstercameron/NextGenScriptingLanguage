{
  "name": "list.range",
  "description": "Generate integers from start up to, but not including, stop using the requested step.",
  "phrases": [
    "list range",
    "start range"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "start": {
      "type": "integer",
      "required": true,
      "description": "First integer in the generated range."
    },
    "stop": {
      "type": "integer",
      "required": true,
      "description": "Exclusive upper or lower bound; generation stops before this integer."
    },
    "step": {
      "type": "integer",
      "description": "Nonzero increment between values; defaults to 1 or -1 according to the direction from start to stop."
    }
  },
  "parameter_alternatives": [
    {
      "message": "step must be a nonzero integer",
      "any_of": [
        [
          {
            "test": "absent",
            "parameter": "step"
          }
        ],
        [
          {
            "test": "nonzero_integer",
            "parameter": "step"
          }
        ]
      ]
    }
  ],
  "arguments": [
    {
      "literal": "list.range"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "list",
      "items": {
        "type": "json"
      }
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "start": {
          "delivery": "single",
          "schema": {
            "type": "integer"
          }
        },
        "stop": {
          "delivery": "single",
          "schema": {
            "type": "integer"
          }
        },
        "step": {
          "delivery": "single",
          "schema": {
            "type": "integer"
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "items": {
              "type": "json"
            },
            "type": "list"
          }
        }
      }
    },
    "capabilities": [
      "data.transform"
    ]
  },
  "examples": [
    {
      "program": "run list.range with start 2 and stop 8 and step 2 as result",
      "expected_output": [
        2,
        4,
        6
      ]
    }
  ]
}
