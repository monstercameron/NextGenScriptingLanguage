# Purpose: Review a proposed backup exclusion.
# Inputs: source_path, fixture paths, live=false.
# Outputs: out/019.json; candidate only; model text is never command code.
# Bash would need: a directory-name policy misses contextual claims about what is regenerable.
accept source_path as text with default "fixtures/019/source.txt"
accept fixture as text with default "fixtures/019/confident.json"
accept live as boolean with default false
try
  read source_path
  if live is true
    then jev.judge with question "Does this proposal exclude only regenerable build outputs while explicitly retaining source and user documents?" and minimum 80 and timeout_ms 3000 and max_bytes 65536 as raw
  otherwise
    then jev.judge with question "Does this proposal exclude only regenerable build outputs while explicitly retaining source and user documents?" and minimum 80 and timeout_ms 3000 and max_bytes 65536 and fixture fixture as raw
  then parse json as verdict
  take boolean at "/accepted" from verdict as accepted
  take integer at "/confidence_percent" from verdict as confidence
  take boolean at "/decision" from verdict as decision
  if accepted is true
    if decision is true
      run json.set with document {"action":"Review against the original input before acting.","result":null,"status":"candidate-for-review"} and pointer "/result" and value "candidate exclusion: project/target/; verify with a dry run"
    otherwise
      run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
  otherwise
    run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
catch failure
  run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
then save to "out/019.json"
