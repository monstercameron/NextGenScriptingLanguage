{
  "name": "jev.score",
  "description": "Scores the question against the ordered levels and returns the score, confidence, and separate threshold-based accepted flag. The env_file and fixture options read files, and live requests connect to the model endpoint.",
  "binary": "@execute-model",
  "accepts_stdin": true,
  "cacheable": false,
  "uncertain_on_failure": true,
  "parameters": {
    "question": {
      "type": "string",
      "required": true,
      "min_length": 1,
      "nonempty": true
    },
    "levels": {
      "type": "list",
      "items": "string",
      "required": true,
      "min_items": 2
    },
    "model": {
      "type": "string",
      "min_length": 1,
      "nonempty": true
    },
    "minimum": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Confidence percentage required for `accepted` to be true; ranges from 0 to 100 and defaults to 0, independent of the label or yes/no decision."
    },
    "max_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "env_file": {
      "type": "path"
    },
    "fixture": {
      "type": "path"
    }
  },
  "arguments": [
    {
      "literal": "score"
    },
    {
      "literal": "--provider"
    },
    {
      "literal": "jev"
    },
    {
      "when_present": "model",
      "append": [
        {
          "literal": "--model"
        },
        {
          "parameter": "model"
        }
      ]
    },
    {
      "literal": "--question"
    },
    {
      "parameter": "question"
    },
    {
      "literal": "--levels"
    },
    {
      "spread": "levels"
    },
    {
      "when_present": "minimum",
      "append": [
        {
          "literal": "--minimum"
        },
        {
          "parameter": "minimum"
        }
      ]
    },
    {
      "when_present": "max_bytes",
      "append": [
        {
          "literal": "--max-bytes"
        },
        {
          "parameter": "max_bytes"
        }
      ]
    },
    {
      "when_present": "timeout_ms",
      "append": [
        {
          "literal": "--timeout-ms"
        },
        {
          "parameter": "timeout_ms"
        }
      ]
    },
    {
      "when_present": "env_file",
      "append": [
        {
          "literal": "--env-file"
        },
        {
          "parameter": "env_file"
        }
      ]
    },
    {
      "when_present": "fixture",
      "append": [
        {
          "literal": "--fixture"
        },
        {
          "parameter": "fixture"
        }
      ]
    }
  ],
  "contract": {
    "version": 1,
    "backend": "command",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "record",
      "encoding": "json",
      "fields": {
        "protocol": {
          "type": "text"
        },
        "provider": {
          "type": "text"
        },
        "model": {
          "type": "text"
        },
        "kind": {
          "type": "text"
        },
        "transport": {
          "type": "text"
        },
        "usage": {
          "type": "record",
          "fields": {
            "input_tokens": {
              "type": "integer"
            },
            "output_tokens": {
              "type": "integer"
            },
            "total_tokens": {
              "type": "integer"
            }
          },
          "required": [
            "input_tokens",
            "output_tokens",
            "total_tokens"
          ]
        },
        "score": {
          "type": "number"
        },
        "confidence_percent": {
          "type": "integer"
        },
        "accepted": {
          "type": "boolean"
        }
      },
      "required": [
        "protocol",
        "provider",
        "model",
        "kind",
        "transport",
        "usage",
        "score",
        "confidence_percent",
        "accepted"
      ]
    },
    "capabilities": [
      "process.exec",
      "filesystem.read",
      "network.connect"
    ],
    "effects": [
      "filesystem.read",
      "network.connect"
    ]
  }
}
