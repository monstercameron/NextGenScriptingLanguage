{
  "name": "number.divmod",
  "description": "Divide two integers and return both the truncated quotient and signed remainder.",
  "phrases": [
    "number divmod",
    "left divmod"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "left": {
      "type": "json",
      "required": true,
      "description": "Integer dividend."
    },
    "right": {
      "type": "json",
      "required": true,
      "description": "Nonzero integer divisor."
    }
  },
  "arguments": [
    {
      "literal": "number.divmod"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "json"
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "left": {
          "delivery": "single",
          "schema": {
            "type": "number"
          }
        },
        "right": {
          "delivery": "single",
          "schema": {
            "type": "number"
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "json"
          }
        }
      }
    },
    "capabilities": [
      "number.compute"
    ]
  },
  "examples": [
    {
      "program": "run number.divmod with left 17 and right 5 as result",
      "expected_output": {
        "quotient": 3,
        "remainder": 2
      }
    }
  ]
}
