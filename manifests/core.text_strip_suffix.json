{
  "name": "text.strip_suffix",
  "description": "Removes one exact suffix when present and otherwise returns the input text unchanged.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "description": "Text to transform; omitted text is read from UTF-8 stdin."
    },
    "suffix": {
      "type": "string",
      "required": true,
      "description": "Exact ending to remove when present."
    }
  },
  "arguments": [
    {
      "literal": "text.strip_suffix"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "json"
    },
    "capabilities": [
      "text.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "suffix": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "text strip_suffix",
    "remove text suffix"
  ],
  "examples": [
    {
      "program": "run text.strip_suffix with text \"archive.zip\" and suffix \".zip\" as value",
      "expected_output": "archive"
    }
  ]
}
