--- /dev/null
+++ b/tests/opt_services_checkpoint_listener.rs
@@ -0,0 +1,67 @@
+use std::io::{Read, Write};
+use std::path::Path;
+use std::process::{Child, Command, ExitStatus, Stdio};
+use std::thread;
+use std::time::{Duration, Instant};
++
+fn wait_bounded(child: &mut Child) -> ExitStatus {
+    let deadline = Instant::now() + Duration::from_secs(5);
+    loop {
+        match child.try_wait() {
+            Ok(Some(status)) => return status,
+            Ok(None) if Instant::now() < deadline => thread::sleep(Duration::from_millis(10)),
+            Ok(None) | Err(_) => {
+                let _ = child.kill();
+                let _ = child.wait();
+                panic!("checkpointed listener exceeded its five-second test deadline");
+            }
+        }
+    }
+}
+
+#[test]
+fn fresh_checkpointed_listener_keeps_each_record_and_binding() {
+    let directory = tempfile::tempdir().unwrap();
+    let manifests = Path::new(env!("CARGO_MANIFEST_DIR")).join("manifests");
+    let workflow = directory.path().join("listener.program");
+    let checkpoint = directory.path().join("checkpoint");
+    std::fs::write(
+        &workflow,
+        "listen to stdin\nwhenever a line arrives as record\n  run printf with message record\n",
+    )
+    .unwrap();
+
+    let mut child = Command::new(env!("CARGO_BIN_EXE_execute"))
+        .current_dir(directory.path())
+        .arg(&workflow)
+        .arg("--manifest-dir")
+        .arg(&manifests)
+        .arg("--checkpoint")
+        .arg(&checkpoint)
+        .arg("--max-runs")
+        .arg("2")
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .unwrap();
+    child
+        .stdin
+        .as_mut()
+        .unwrap()
+        .write_all(b"first record\nsecond record\n")
+        .unwrap();
+    drop(child.stdin.take());
+
+    let status = wait_bounded(&mut child);
+    let mut output = Vec::new();
+    let mut errors = Vec::new();
+    child.stdout.take().unwrap().read_to_end(&mut output).unwrap();
+    child.stderr.take().unwrap().read_to_end(&mut errors).unwrap();
+    assert!(
+        status.success(),
+        "{}",
+        String::from_utf8_lossy(&errors)
+    );
+    assert_eq!(output, b"first record\nsecond record\n");
+}
