{
  "name": "list.top",
  "description": "Return up to n largest values, sorted ascending by whole value or a JSON Pointer-selected value.",
  "phrases": [
    "top values",
    "largest records"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "items": {
      "type": "list",
      "items": "json",
      "description": "List of values to rank."
    },
    "key": {
      "type": "string",
      "description": "Optional JSON Pointer used to select a value for ranking; omit to compare whole values."
    },
    "n": {
      "type": "unsigned_integer",
      "required": true,
      "description": "Maximum number of largest values to return; must be a nonnegative integer."
    },
    "collect": {
      "type": "boolean",
      "description": "Accepted for compatibility; this operation returns the selected values directly."
    }
  },
  "parameter_alternatives": [
    {
      "message": "n must be a nonnegative integer",
      "any_of": [
        [
          {
            "test": "nonnegative_integer",
            "parameter": "n"
          }
        ]
      ]
    }
  ],
  "arguments": [
    {
      "literal": "list.top"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "list",
      "encoding": "json",
      "items": {
        "type": "json"
      },
      "same_as_parameter": "items"
    },
    "capabilities": [
      "data.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "items": {
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          },
          "delivery": "single"
        },
        "key": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "n": {
          "schema": {
            "type": "usize"
          },
          "delivery": "single"
        },
        "collect": {
          "schema": {
            "type": "boolean"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          },
          "delivery": "single"
        }
      }
    }
  },
  "examples": [
    {
      "program": "run list.top with items [3, 8, 1, 6] and n 2 as result",
      "expected_output": [
        8,
        6
      ]
    }
  ]
}
