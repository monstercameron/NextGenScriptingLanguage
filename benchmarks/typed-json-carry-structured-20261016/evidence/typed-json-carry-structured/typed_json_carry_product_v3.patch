+#[test]
+fn deep_in_process_json_binding_matches_cache_hit_byte_decoding() {
+    let directory = tempfile::tempdir().unwrap();
+    let cache_directory = directory.path().join("cache");
+    let mut cache_builder = fs::DirBuilder::new();
+    cache_builder.mode(0o700).create(&cache_directory).unwrap();
+    let mut manifest: JsonValue =
+        serde_json::from_str(include_str!("../manifests/core.json_get.json")).unwrap();
+    manifest["cacheable"] = json!(true);
+    let catalog = registry(&[manifest]);
+    let program = parser::parse(
+        "accept payload as json\nrun json.get with document payload and pointer \"\" as result and cache\nthen encode result as json\n",
+    )
+    .unwrap();
+    let payload = (0..70).fold(Value::Null, |nested, _| Value::List(vec![nested]));
+    let mut run_options = options(directory.path());
+    run_options.cache_directory = Some(cache_directory);
+    run_options.inputs.insert("payload".into(), payload);
+
+    let cache_miss = runtime::run(&program, &catalog, &run_options).unwrap();
+    let cache_hit = runtime::run(&program, &catalog, &run_options).unwrap();
+    assert_eq!(cache_miss.cache_hits, 0);
+    assert_eq!(cache_hit.cache_hits, 1);
+    assert_eq!(cache_hit.output, cache_miss.output);
+}
