{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Execute static check result, protocol 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "validation",
    "ok",
    "path",
    "path_bytes",
    "diagnostics"
  ],
  "properties": {
    "protocol": {
      "const": "execute.check/1"
    },
    "validation": {
      "const": "static"
    },
    "ok": {
      "type": "boolean"
    },
    "path": {
      "type": "string"
    },
    "path_bytes": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 10001,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "code",
          "message"
        ],
        "properties": {
          "severity": {
            "enum": [
              "error",
              "warning",
              "information",
              "hint"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string"
          },
          "span": {
            "$ref": "#/$defs/span"
          },
          "fixes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/fix"
            }
          },
          "causes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "diagnostics": {
            "items": {
              "properties": {
                "severity": {
                  "not": {
                    "const": "error"
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "diagnostics": {
            "contains": {
              "properties": {
                "severity": {
                  "const": "error"
                }
              },
              "required": [
                "severity"
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_byte",
        "end_byte",
        "line",
        "column",
        "end_line",
        "end_column",
        "precision"
      ],
      "properties": {
        "start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_byte": {
          "type": "integer",
          "minimum": 0
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_column": {
          "type": "integer",
          "minimum": 1
        },
        "precision": {
          "enum": [
            "token",
            "line"
          ]
        }
      }
    },
    "fix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message",
        "edits"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "edits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "span",
              "replacement"
            ],
            "properties": {
              "span": {
                "$ref": "#/$defs/span"
              },
              "replacement": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
