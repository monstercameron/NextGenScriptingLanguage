#!/usr/bin/env -S execute --
# Port of bin/omarchy-hyprland-toggle-disabled (see original.sh). Exit 0 when the Hyprland
# toggle's flag file is missing.
execute 1
accept arguments as list of text from arguments # execute-allow: lint.unused_input intentional compatibility input; this wrapper accepts but ignores extra arguments
accept name_arg as text from argument 1 with default ""
accept home_dir as text from public environment "HOME" with default ""
run text.concat with parts [home_dir, "/.local/state/omarchy/toggles/hypr/", name_arg, ".lua"] as flag_path
if run "test" with arguments ["-f", flag_path] succeeds
  exit with status 1
otherwise
  exit with status 0
