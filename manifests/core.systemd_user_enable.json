{
  "name": "systemd.user.enable",
  "description": "Provides the systemd user enable operation for controlled scripts.",
  "binary": "systemctl",
  "accepts_stdin": false,
  "cacheable": false,
  "uncertain_on_failure": true,
  "parameters": {
    "unit": {
      "type": "string",
      "required": true
    }
  },
  "arguments": [
    {
      "literal": "--user"
    },
    {
      "literal": "enable"
    },
    {
      "literal": "--"
    },
    {
      "parameter": "unit"
    }
  ],
  "contract": {
    "version": 1,
    "backend": "command",
    "lifecycle": {
      "kind": "oneshot"
    },
    "outcomes": [
      {
        "status": 0,
        "name": "success",
        "kind": "success"
      },
      {
        "status": 127,
        "name": "not_found",
        "kind": "absence"
      }
    ],
    "capabilities": [
      "systemd.control"
    ],
    "effects": [
      "systemd.control"
    ],
    "ports": {
      "inputs": {
        "unit": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      }
    }
  }
}
