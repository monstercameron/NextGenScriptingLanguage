# Purpose: Group non-success keyboard test events by scenario to turn raw logs into a reproducible accessibility triage note.
# Inputs: Pipe-delimited KBT-* test records include scenario, key, result, and target.
# Outputs: out/057-keyboard-barrier-clusters.json: grouped failure evidence and a reproduction outline.
accept live as boolean with default false
accept source_path as text with default "fixtures/057/source-high.txt"
accept report_path as text with default "out/057-keyboard-barrier-clusters.json"
accept classify_fixture_path as text with default "fixtures/057/classify-high.json"
accept draft_fixture_path as text with default "fixtures/057/draft.json"
accept generator_model as text with default "gpt-6-luna"
accept env_file as text with default ".env"
# Refuse an output path that aliases an existing evidence or schema file.
run "test" with arguments ["!", source_path, "-ef", report_path]
run cat with path source_path
then awk with delimiter "|" and program "$4 != \"focus-moved\" { print $1 \"\\t\" $2 \"\\t\" $3 \"\\t\" $4 }"
then sort with flags ["-k2,2", "-k1,1"] as evidence
if live is true
  then jev.classify with question "Which keyboard scenarios show repeatable focus or activation barriers in these logged events?" and labels ["keyboard-barrier", "needs-human"] and minimum 80 and env_file env_file as class_raw # execute-allow: lint.unused_binding intentional model-result capture for acceptance analysis and downstream parsing
otherwise
  then jev.classify with question "Which keyboard scenarios show repeatable focus or activation barriers in these logged events?" and labels ["keyboard-barrier", "needs-human"] and minimum 80 and fixture classify_fixture_path and env_file env_file as class_raw
then parse json as classification
take text at "/label" from classification as label
take integer at "/confidence_percent" from classification as confidence
take boolean at "/accepted" from classification as accepted
if accepted is true
  if label is "keyboard-barrier"
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "label", label, "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "{label:$label,confidence_percent:$confidence,evidence:$evidence}"]
    if live is true
      then llm.ask with model generator_model and instruction "Cluster the failed events by scenario, key, and target. Draft a minimal reproduction checklist citing KBT-* IDs; separate logged behavior from hypotheses and include no automatic remediation." and env_file env_file as draft_raw # execute-allow: lint.unused_binding intentional generated-text capture for review validation and downstream parsing
    otherwise
      then llm.ask with model generator_model and instruction "Cluster the failed events by scenario, key, and target. Draft a minimal reproduction checklist citing KBT-* IDs; separate logged behavior from hypotheses and include no automatic remediation." and fixture draft_fixture_path and env_file env_file as draft_raw
    then parse json as draft_result
    take text at "/text" from draft_result as draft
    run jq with flags ["-n", "-r", "--arg", "draft", draft, "--arg", "evidence", evidence] and filter "($draft | rtrimstr(\"\\n\")) as $candidate | if ($candidate | startswith(\"EVIDENCE:\")) and ([$evidence | scan(\"[A-Z][A-Z0-9]+-[A-Z0-9-]+\") | . as $id | select($candidate | contains($id))] | length > 0) then $candidate else error(\"draft must start with EVIDENCE and cite an ID present in the bounded evidence\") end" as validated_draft
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "keyboard_barrier_triage", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "draft", validated_draft, "--arg", "action", "QA owner reproduces with keyboard-only and assistive-technology checks.", "{artifact:$artifact,status:\"draft-for-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,keyboard_reproduction_clusters:$draft,action:$action}"]
    then save to report_path
  otherwise
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "keyboard_barrier_triage", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "review_action", "Logs are sampled evidence; no user-facing behavior is changed.", "{artifact:$artifact,status:\"needs-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,keyboard_reproduction_clusters:null,reason:\"Classifier selected the human-review label above the confidence threshold; no LLM draft was requested.\",action:$review_action}"]
    then save to report_path
  then cat with path report_path
otherwise
  then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "keyboard_barrier_triage", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "review_action", "Logs are sampled evidence; no user-facing behavior is changed.", "{artifact:$artifact,status:\"needs-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,keyboard_reproduction_clusters:null,reason:\"Classifier confidence is below the configured 80 percent threshold; no LLM draft was requested.\",action:$review_action}"]
  then save to report_path
then cat with path report_path
