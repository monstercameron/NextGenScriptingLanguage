{
  "name": "json.map",
  "description": "Maps an array to values selected from each item by a JSON Pointer, substituting default for missing or null selections.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "document": {
      "type": "json",
      "description": "JSON document containing the target array; stdin is used when omitted."
    },
    "pointer": {
      "type": "string",
      "description": "JSON Pointer locating the array; an empty pointer selects the root array."
    },
    "select": {
      "type": "string",
      "required": true,
      "description": "JSON Pointer evaluated on each array item to select its output value."
    },
    "default": {
      "type": "json",
      "description": "JSON value substituted when an item has no selected value or its selection is null."
    }
  },
  "arguments": [
    {
      "literal": "json.map"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "list",
      "encoding": "json",
      "items": {
        "type": "json"
      }
    },
    "capabilities": [
      "json.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "document": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        },
        "pointer": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "select": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "json"
          },
          "delivery": "single",
          "encoding": "json"
        },
        "default": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "map JSON values",
    "select JSON fields"
  ],
  "examples": [
    {
      "program": "run json.map with document [{\"name\":\"Ada\"},{\"name\":\"Lin\"}] and select \"/name\" as result",
      "expected_output": [
        "Ada",
        "Lin"
      ]
    }
  ]
}
