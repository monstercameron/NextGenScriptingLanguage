{
  "name": "ini.parse",
  "description": "Parses the supported INI subset into a JSON object, keeping all values as strings and rejecting duplicate keys or sections.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "description": "INI document text to parse; when omitted, the applet reads the document from its input stream."
    }
  },
  "arguments": [
    {
      "literal": "ini.parse"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "json",
      "encoding": "json"
    },
    "capabilities": [
      "text.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "ini parse"
  ],
  "examples": [
    {
      "program": "run ini.parse with text \"port=8080\\n[server]\\nhost=localhost\\n\" as config",
      "expected_output": {
        "port": "8080",
        "server": {
          "host": "localhost"
        }
      }
    }
  ]
}
