+#[test]
+fn no_selector_keeps_the_existing_local_manifest_directory_authoritative() {
+    let fixture = Fixture::new();
+    let local = fixture.temp.path().join("manifests");
+    fs::create_dir(&local).unwrap();
+    let local_manifest: Value = json!({
+        "name": "local.default",
+        "binary": "printf",
+        "arguments": []
+    });
+    fs::write(
+        local.join("local.json"),
+        serde_json::to_vec(&local_manifest).unwrap(),
+    )
+    .unwrap();
+    let packed_only: Value = json!({
+        "name": "packed.only",
+        "binary": "printf",
+        "arguments": []
+    });
+    fs::write(
+        &fixture.manifest_catalog,
+        serde_json::to_vec(&json!({
+            "format": "execute.manifest-catalog",
+            "version": 1,
+            "manifests": [packed_only]
+        }))
+        .unwrap(),
+    )
+    .unwrap();
+
+    let output = fixture.cli(&["applets", "list"]);
+    assert!(output.status.success());
+    let listed: Value = serde_json::from_slice(&output.stdout).unwrap();
+    assert_eq!(listed["applets"].as_array().unwrap().len(), 1);
+    assert_eq!(listed["applets"][0]["name"], "local.default");
+}
