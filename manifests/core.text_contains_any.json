{
  "name": "text.contains_any",
  "description": "Reports whether the input text contains at least one supplied literal string; an empty needle matches any text.",
  "phrases": [
    "find any text"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "description": "Text to search; omitted text is read from UTF-8 stdin."
    },
    "needles": {
      "type": "list",
      "required": true,
      "items": "string",
      "description": "Literal substrings to look for; the result is true when any one occurs."
    }
  },
  "arguments": [
    {
      "literal": "text.contains_any"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "boolean"
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        },
        "needles": {
          "delivery": "single",
          "schema": {
            "type": "list",
            "items": {
              "type": "text"
            }
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "boolean"
          }
        }
      }
    },
    "capabilities": [
      "text.transform"
    ]
  },
  "examples": [
    {
      "program": "run text.contains_any with text \"release ready\" and needles [\"error\", \"ready\"] as value",
      "expected_output": true
    }
  ]
}
