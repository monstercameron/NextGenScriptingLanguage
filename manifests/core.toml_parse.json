{
  "name": "toml.parse",
  "description": "Parses the supported TOML subset into JSON-compatible records, arrays, strings, numbers, and booleans; unsupported date/time and nonfinite values fail.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "description": "TOML document to parse; omitted text is read from UTF-8 stdin."
    }
  },
  "arguments": [
    {
      "literal": "toml.parse"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "json",
      "encoding": "json"
    },
    "capabilities": [
      "text.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "toml parse"
  ],
  "examples": [
    {
      "program": "run toml.parse with text \"name = \\\"Ada\\\"\\nactive = true\" as value",
      "expected_output": {
        "name": "Ada",
        "active": true
      }
    }
  ]
}
