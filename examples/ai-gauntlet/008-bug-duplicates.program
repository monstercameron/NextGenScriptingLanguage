# Purpose: Identify near-duplicate bug reports without merging.
# Inputs: source_path, fixture paths, live=false.
# Outputs: out/008.json; candidate only; model text is never command code.
# Bash would need: fuzzy string metrics miss semantic paraphrases and need a review threshold.
accept source_path as text with default "fixtures/008/source.json"
accept fixture as text with default "fixtures/008/confident.json"
accept live as boolean with default false
try
  read source_path
  if live is true
    then jev.judge with question "Do these reports describe the same trigger and observed symptom, rather than merely the same component?" and minimum 80 and timeout_ms 3000 and max_bytes 65536 as raw # execute-allow: lint.unused_binding intentional model-result capture for acceptance analysis and downstream parsing
  otherwise
    then jev.judge with question "Do these reports describe the same trigger and observed symptom, rather than merely the same component?" and minimum 80 and timeout_ms 3000 and max_bytes 65536 and fixture fixture as raw
  then parse json as verdict
  take boolean at "/accepted" from verdict as accepted
  take integer at "/confidence_percent" from verdict as confidence # execute-allow: lint.unused_binding intentional typed take validates the model confidence field
  take boolean at "/decision" from verdict as decision
  if accepted is true
    if decision is true
      run json.set with document {"action":"Review against the original input before acting.","result":null,"status":"candidate-for-review"} and pointer "/result" and value {"duplicate_candidates":["A","B"],"merge":false}
    otherwise
      run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
  otherwise
    run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
catch failure # execute-allow: lint.unused_binding intentional catch control binding; recovery uses the handler path rather than the error value
  run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
then save to "out/008.json"
