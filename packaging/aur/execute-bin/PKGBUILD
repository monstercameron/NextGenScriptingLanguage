# Maintainer: Execute maintainers <noreply@github.com>
# Prebuilt release binaries. tools/aur.py renders _tag and the checksums for each release.
pkgname=execute-bin
_tag=0.9.0-rc.5
pkgver=${_tag//-/_}
pkgrel=1
pkgdesc='Readable native command workflows (prebuilt release binaries)'
arch=('x86_64' 'aarch64')
url='https://github.com/monstercameron/NextGenScriptingLanguage'
license=('MIT')
provides=('execute')
conflicts=('execute')
source_x86_64=("execute-${_tag}-linux-x64.tar.gz::${url}/releases/download/v${_tag}/execute-${_tag}-linux-x64.tar.gz")
source_aarch64=("execute-${_tag}-linux-arm64.tar.gz::${url}/releases/download/v${_tag}/execute-${_tag}-linux-arm64.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  cd "$srcdir/execute-$_tag"
  install -Dm755 bin/execute "$pkgdir/usr/bin/execute"
  install -Dm755 bin/execute-model "$pkgdir/usr/bin/execute-model"
  install -Dm755 bin/execute-applet "$pkgdir/usr/bin/execute-applet"
  install -dm755 "$pkgdir/usr/share/execute"
  cp -a manifests "$pkgdir/usr/share/execute/manifests"
  cp -a docs "$pkgdir/usr/share/execute/docs"
  cp -a editors "$pkgdir/usr/share/execute/editors"
  install -Dm644 README.md "$pkgdir/usr/share/execute/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/execute/LICENSE"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 completions/execute.bash "$pkgdir/usr/share/bash-completion/completions/execute"
  install -Dm644 completions/_execute "$pkgdir/usr/share/zsh/site-functions/_execute"
  install -Dm644 completions/execute.fish "$pkgdir/usr/share/fish/vendor_completions.d/execute.fish"
  install -Dm644 man/execute.1 "$pkgdir/usr/share/man/man1/execute.1"
}
