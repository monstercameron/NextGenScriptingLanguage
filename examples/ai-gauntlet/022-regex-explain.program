# Purpose: Explain a saved regular expression.
# Inputs: source_path, fixture paths, live=false.
# Outputs: out/022.json; candidate only; model text is never command code.
# Bash would need: a regex parser plus plain-language templates or a separate generation client.
accept source_path as text with default "fixtures/022/source.txt"
accept fixture as text with default "fixtures/022/confident.json"
accept live as boolean with default false
accept result_fixture as text with default "fixtures/022/result.json"
try
  read source_path
  if live is true
    then jev.judge with question "Is there a complete literal pattern and an explicit validation purpose to explain?" and minimum 80 and timeout_ms 3000 and max_bytes 65536 as raw
  otherwise
    then jev.judge with question "Is there a complete literal pattern and an explicit validation purpose to explain?" and minimum 80 and timeout_ms 3000 and max_bytes 65536 and fixture fixture as raw
  then parse json as verdict
  take boolean at "/accepted" from verdict as accepted
  take integer at "/confidence_percent" from verdict as confidence
  take boolean at "/decision" from verdict as decision
  if accepted is true
    if decision is true
      read source_path
      if live is true
        then llm.ask with model "gpt-6-luna" and instruction "Explain the supplied regex in plain language and give a matching example; do not generate or execute code." and timeout_ms 3000 and max_bytes 65536 as result_raw
      otherwise
        then llm.ask with model "gpt-6-luna" and instruction "Explain the supplied regex in plain language and give a matching example; do not generate or execute code." and timeout_ms 3000 and max_bytes 65536 and fixture result_fixture as result_raw
      then parse json as generated
      take text at "/text" from generated as content
      if content is ""
        run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
      otherwise
        run json.set with document {"action":"Review against the original input before acting.","result":null,"status":"candidate-for-review"} and pointer "/result" and value content
    otherwise
      run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
  otherwise
    run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
catch failure
  run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
then save to "out/022.json"
