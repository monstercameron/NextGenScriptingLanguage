{
  "name": "json.filter",
  "description": "Keeps array items that satisfy every JSON Pointer predicate in where and returns them in input order.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "document": {
      "type": "json",
      "description": "JSON array to filter; stdin is used when omitted."
    },
    "pointer": {
      "type": "string",
      "description": "JSON Pointer locating the array inside document; an empty pointer selects the root array."
    },
    "where": {
      "type": "json",
      "required": true,
      "schema": {
        "type": "list",
        "max_items": 32,
        "items": {
          "type": "json",
          "one_of": [
            {
              "type": "record",
              "fields": {
                "pointer": {
                  "type": "string"
                },
                "exists": {
                  "type": "boolean"
                }
              },
              "required": [
                "exists"
              ]
            },
            {
              "type": "record",
              "fields": {
                "pointer": {
                  "type": "string"
                },
                "equals": {
                  "type": "json"
                }
              },
              "required": [
                "equals"
              ]
            },
            {
              "type": "record",
              "fields": {
                "pointer": {
                  "type": "string"
                },
                "not_equals": {
                  "type": "json"
                }
              },
              "required": [
                "not_equals"
              ]
            },
            {
              "type": "record",
              "fields": {
                "pointer": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "null",
                    "boolean",
                    "number",
                    "string",
                    "array",
                    "object"
                  ]
                }
              },
              "required": [
                "type"
              ]
            }
          ]
        }
      },
      "description": "List of predicates; each item must contain a JSON Pointer and exactly one of exists, equals, not_equals, or type."
    }
  },
  "arguments": [
    {
      "literal": "json.filter"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "list",
      "encoding": "json",
      "items": {
        "type": "json"
      }
    },
    "capabilities": [
      "json.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "document": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        },
        "pointer": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "where": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "json"
          },
          "delivery": "single",
          "encoding": "json"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "json filter",
    "filter json records"
  ],
  "examples": [
    {
      "program": "run json.filter with document [{\"name\":\"Ada\",\"active\":true},{\"name\":\"Lin\",\"active\":false}] and where [{\"pointer\":\"/active\",\"equals\":true}] as result",
      "expected_output": [
        {
          "active": true,
          "name": "Ada"
        }
      ]
    }
  ]
}
