{
  "name": "text.replace",
  "description": "Replaces every nonoverlapping occurrence of a nonempty literal string with the supplied replacement text.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "description": "Text in which occurrences are replaced; omitted text is read from UTF-8 stdin."
    },
    "old": {
      "type": "string",
      "required": true,
      "description": "Nonempty literal substring to find."
    },
    "new": {
      "type": "string",
      "required": true,
      "description": "Text inserted for each occurrence of old."
    }
  },
  "arguments": [
    {
      "literal": "text.replace"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "parameter_alternatives": [
    {
      "message": "text.replace old must be nonempty",
      "any_of": [
        [
          {
            "test": "nonempty",
            "parameter": "old"
          }
        ]
      ]
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "json"
    },
    "capabilities": [
      "text.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "old": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "new": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "text replace",
    "replace text"
  ],
  "examples": [
    {
      "program": "run text.replace with text \"one fish, two fish\" and old \"fish\" and new \"bird\" as value",
      "expected_output": "one bird, two bird"
    }
  ]
}
