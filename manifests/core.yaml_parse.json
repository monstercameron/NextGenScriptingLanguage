{
  "name": "yaml.parse",
  "description": "Parses the supported YAML subset into JSON-compatible values; duplicate keys and unsupported features such as anchors, aliases, tags, and multiple documents fail.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "description": "YAML document to parse; omitted text is read from UTF-8 stdin."
    }
  },
  "arguments": [
    {
      "literal": "yaml.parse"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "json",
      "encoding": "json"
    },
    "capabilities": [
      "text.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "yaml parse",
    "parse yaml",
    "read yaml"
  ],
  "examples": [
    {
      "program": "run yaml.parse with text \"name: Ada\\nactive: true\" as value",
      "expected_output": {
        "name": "Ada",
        "active": true
      }
    }
  ]
}
