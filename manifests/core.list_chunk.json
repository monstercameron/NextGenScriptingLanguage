{
  "name": "list.chunk",
  "description": "Split an input list into consecutive sublists of the requested positive size.",
  "phrases": [
    "list chunk",
    "items chunk"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "items": {
      "type": "json",
      "required": true,
      "description": "List of JSON values to divide into chunks."
    },
    "size": {
      "type": "unsigned_integer",
      "required": true,
      "description": "Number of values in each chunk; must be a positive integer."
    }
  },
  "parameter_alternatives": [
    {
      "message": "size must be a positive integer",
      "any_of": [
        [
          {
            "test": "positive_integer",
            "parameter": "size"
          }
        ]
      ]
    }
  ],
  "arguments": [
    {
      "literal": "list.chunk"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "list",
      "items": {
        "type": "json"
      }
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "items": {
          "delivery": "single",
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          }
        },
        "size": {
          "delivery": "single",
          "schema": {
            "type": "usize"
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "items": {
              "type": "json"
            },
            "type": "list"
          }
        }
      }
    },
    "capabilities": [
      "data.transform"
    ]
  },
  "examples": [
    {
      "program": "run list.chunk with items [1, 2, 3, 4, 5] and size 2 as result",
      "expected_output": [
        [
          1,
          2
        ],
        [
          3,
          4
        ],
        [
          5
        ]
      ]
    }
  ]
}
