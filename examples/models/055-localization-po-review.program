# Purpose: Compare source and translated PO entries for placeholder preservation and plural-form review, without editing localization files.
# Inputs: PO excerpts contain LOC-* record markers followed by msgid and msgstr lines.
# Outputs: out/055-localization-po-review.json: cited locale review memo and source excerpt.
accept live as boolean with default false
accept source_path as text with default "fixtures/055/source-high.txt"
accept report_path as text with default "out/055-localization-po-review.json"
accept classify_fixture_path as text with default "fixtures/055/classify-high.json"
accept draft_fixture_path as text with default "fixtures/055/draft.json"
accept generator_model as text with default "gpt-6-luna"
accept env_file as text with default ".env"
# Refuse an output path that aliases an existing evidence or schema file.
run "test" with arguments ["!", source_path, "-ef", report_path]
run cat with path source_path
then grep with flags ["-E"] and pattern "^# LOC-|^msgid |^msgstr " as evidence
if live is true
  then jev.classify with question "Which supplied translation entries need a human placeholder or plural-form review?" and labels ["placeholder-risk", "needs-human"] and minimum 80 and env_file env_file as class_raw # execute-allow: lint.unused_binding intentional model-result capture for acceptance analysis and downstream parsing
otherwise
  then jev.classify with question "Which supplied translation entries need a human placeholder or plural-form review?" and labels ["placeholder-risk", "needs-human"] and minimum 80 and fixture classify_fixture_path and env_file env_file as class_raw
then parse json as classification
take text at "/label" from classification as label
take integer at "/confidence_percent" from classification as confidence
take boolean at "/accepted" from classification as accepted
if accepted is true
  if label is "placeholder-risk"
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "label", label, "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "{label:$label,confidence_percent:$confidence,evidence:$evidence}"]
    if live is true
      then llm.ask with model generator_model and instruction "Review the msgid/msgstr pairs for likely placeholder or plural risks using only the supplied excerpt. Cite LOC-* IDs, quote only relevant tokens, and ask a native-language reviewer to decide; do not claim a translation is correct." and env_file env_file as draft_raw # execute-allow: lint.unused_binding intentional generated-text capture for review validation and downstream parsing
    otherwise
      then llm.ask with model generator_model and instruction "Review the msgid/msgstr pairs for likely placeholder or plural risks using only the supplied excerpt. Cite LOC-* IDs, quote only relevant tokens, and ask a native-language reviewer to decide; do not claim a translation is correct." and fixture draft_fixture_path and env_file env_file as draft_raw
    then parse json as draft_result
    take text at "/text" from draft_result as draft
    run jq with flags ["-n", "-r", "--arg", "draft", draft, "--arg", "evidence", evidence] and filter "($draft | rtrimstr(\"\\n\")) as $candidate | if ($candidate | startswith(\"EVIDENCE:\")) and ([$evidence | scan(\"[A-Z][A-Z0-9]+-[A-Z0-9-]+\") | . as $id | select($candidate | contains($id))] | length > 0) then $candidate else error(\"draft must start with EVIDENCE and cite an ID present in the bounded evidence\") end" as validated_draft
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "localization_placeholder_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "draft", validated_draft, "--arg", "action", "Locale maintainer confirms grammar and runtime plural rules.", "{artifact:$artifact,status:\"draft-for-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,localization_review_notes:$draft,action:$action}"]
    then save to report_path
  otherwise
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "localization_placeholder_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "review_action", "Do not rewrite or save a PO source file.", "{artifact:$artifact,status:\"needs-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,localization_review_notes:null,reason:\"Classifier selected the human-review label above the confidence threshold; no LLM draft was requested.\",action:$review_action}"]
    then save to report_path
  then cat with path report_path
otherwise
  then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "localization_placeholder_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "review_action", "Do not rewrite or save a PO source file.", "{artifact:$artifact,status:\"needs-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,localization_review_notes:null,reason:\"Classifier confidence is below the configured 80 percent threshold; no LLM draft was requested.\",action:$review_action}"]
  then save to report_path
then cat with path report_path
