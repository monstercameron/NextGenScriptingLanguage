{
  "name": "ls",
  "description": "Lists entries in the selected directory, or the current working directory when no path is supplied.",
  "binary": "ls",
  "parameters": {
    "flags": {
      "type": "list",
      "items": "string"
    },
    "path": {
      "type": "string"
    }
  },
  "arguments": [
    {
      "when_present": "flags",
      "append": [
        {
          "spread": "flags"
        }
      ]
    },
    {
      "when_present": "path",
      "append": [
        {
          "literal": "--"
        },
        {
          "parameter": "path"
        }
      ]
    }
  ],
  "contract": {
    "version": 1,
    "backend": "command",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "raw"
    },
    "capabilities": [
      "process.exec",
      "filesystem.read"
    ],
    "effects": [
      "filesystem.read"
    ]
  }
}
