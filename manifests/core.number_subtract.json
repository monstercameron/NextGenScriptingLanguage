{
  "name": "number.subtract",
  "description": "Subtract right from left and return the finite numeric difference.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "left": {
      "type": "json",
      "required": true,
      "description": "Finite minuend."
    },
    "right": {
      "type": "json",
      "required": true,
      "description": "Finite subtrahend."
    }
  },
  "arguments": [
    {
      "literal": "number.subtract"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "number",
      "encoding": "json"
    },
    "capabilities": [
      "number.compute"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "left": {
          "schema": {
            "type": "number"
          },
          "delivery": "single"
        },
        "right": {
          "schema": {
            "type": "number"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "number"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "number subtract"
  ],
  "examples": [
    {
      "program": "run number.subtract with left 10 and right 4 as result",
      "expected_output": 6
    }
  ]
}
