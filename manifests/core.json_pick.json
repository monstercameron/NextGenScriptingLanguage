{
  "name": "json.pick",
  "description": "Returns a copy of the root object containing only the named top-level members that exist.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "document": {
      "type": "record",
      "required": true,
      "fields": {},
      "additional_properties": {
        "type": "json"
      },
      "description": "JSON object to select from; stdin is used when omitted."
    },
    "keys": {
      "type": "list",
      "items": "string",
      "required": true,
      "description": "Names of top-level object members to include in the result."
    }
  },
  "arguments": [
    {
      "literal": "json.pick"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "json"
    },
    "capabilities": [
      "json.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "document": {
          "schema": {
            "type": "record",
            "fields": {},
            "additionalProperties": {
              "type": "json"
            }
          },
          "delivery": "single"
        },
        "keys": {
          "schema": {
            "type": "list",
            "items": {
              "type": "text"
            }
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "json"
          }
        }
      }
    }
  },
  "phrases": [
    "json pick"
  ],
  "examples": [
    {
      "program": "run json.pick with document {\"name\":\"Ada\",\"score\":8,\"active\":true} and keys [\"name\",\"score\"] as result",
      "expected_output": {
        "name": "Ada",
        "score": 8
      }
    }
  ]
}
