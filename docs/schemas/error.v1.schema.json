{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://execute.invalid/schemas/error.v1.schema.json",
  "title": "Execute structured runtime error, protocol execute.error/1",
  "description": "The single JSON object written as the final stderr line when `--json-errors` is given. Codes are stable; new codes are additive within protocol 1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "code", "category", "message", "exit_code"],
  "properties": {
    "protocol": { "const": "execute.error/1" },
    "code": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "command_failed",
            "applet_invocation_failed",
            "applet_failed",
            "policy_denied",
            "remote_failed",
            "auth_failed",
            "execution_failed",
            "task_failed",
            "interrupted",
            "execute_error"
          ]
        },
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$",
          "description": "A diagnostic registry code, reported with category static."
        }
      ]
    },
    "category": {
      "type": "string",
      "enum": ["process", "applet", "policy", "remote", "auth", "execution", "signal", "runtime", "static"]
    },
    "message": { "type": "string" },
    "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
    "span": {
      "type": "object",
      "description": "Present with category static: the source location of the diagnostic. Line and column are one-based.",
      "required": ["start_byte", "end_byte", "line", "column", "end_line", "end_column", "precision"],
      "properties": {
        "start_byte": { "type": "integer", "minimum": 0 },
        "end_byte": { "type": "integer", "minimum": 0 },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "end_column": { "type": "integer", "minimum": 1 },
        "precision": { "type": "string" },
        "path": { "type": "string" }
      }
    }
  }
}
