{
  "name": "time.format",
  "description": "Formats a Unix epoch second with Chrono strftime directives in UTC, local time, or a fixed signed offset measured in seconds.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "format": {
      "type": "string",
      "required": true,
      "description": "Chrono strftime format string used to render the date and time."
    },
    "zone": {
      "type": "string",
      "required": false,
      "description": "Time zone: `utc`, `local`, or a signed UTC offset in seconds; defaults to `utc`."
    },
    "epoch": {
      "type": "integer",
      "required": true,
      "description": "Unix timestamp in whole seconds to format."
    }
  },
  "arguments": [
    {
      "literal": "time.format"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "text"
    },
    "capabilities": [
      "clock.read"
    ],
    "effects": [
      "clock.read"
    ],
    "ports": {
      "inputs": {
        "format": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "zone": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "epoch": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        }
      }
    }
  },
  "phrases": [
    "time format"
  ],
  "examples": [
    {
      "program": "run time.format with epoch 0 and format \"%Y-%m-%d %H:%M:%S\" and zone \"utc\" as value",
      "expected_output": "1970-01-01 00:00:00"
    }
  ]
}
