{
  "name": "tail.follow",
  "description": "Streams new content appended to the path, starting at the current end and following file replacement.",
  "phrases": [
    "follow file"
  ],
  "binary": "tail",
  "cacheable": false,
  "parameters": {
    "path": {
      "type": "string",
      "required": true
    }
  },
  "arguments": [
    {
      "literal": "-n"
    },
    {
      "literal": "0"
    },
    {
      "literal": "-F"
    },
    {
      "literal": "--"
    },
    {
      "parameter": "path"
    }
  ],
  "contract": {
    "version": 1,
    "backend": "command",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "raw"
    },
    "capabilities": [
      "process.exec",
      "filesystem.read"
    ],
    "effects": [
      "filesystem.read"
    ]
  }
}
