# Purpose: Normalize local PDF or HTML accessibility checker findings into a reviewer-oriented structure map.
# Inputs: JSON export lists pages, elements, finding codes, and stable STR-* IDs.
# Outputs: out/056-document-structure-findings.json: an issue-by-issue review plan with page provenance.
accept live as boolean with default false
accept source_path as text with default "fixtures/056/source-high.json"
accept report_path as text with default "out/056-document-structure-findings.json"
accept classify_fixture_path as text with default "fixtures/056/classify-high.json"
accept draft_fixture_path as text with default "fixtures/056/draft.json"
accept generator_model as text with default "gpt-6-luna"
accept env_file as text with default ".env"
# Refuse an output path that aliases an existing evidence or schema file.
run "test" with arguments ["!", source_path, "-ef", report_path]
run cat with path source_path
then jq with filter ".issues[] | [.id, .page, .element, .finding, .context] | @tsv" and flags ["-r"] as evidence
if live is true
  then jev.classify with question "Which structural findings have enough local context to prioritize a document remediation review?" and labels ["structure-finding", "needs-human"] and minimum 80 and env_file env_file as class_raw
otherwise
  then jev.classify with question "Which structural findings have enough local context to prioritize a document remediation review?" and labels ["structure-finding", "needs-human"] and minimum 80 and fixture classify_fixture_path and env_file env_file as class_raw
then parse json as classification
take text at "/label" from classification as label
take integer at "/confidence_percent" from classification as confidence
take boolean at "/accepted" from classification as accepted
if accepted is true
  if label is "structure-finding"
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "label", label, "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "{label:$label,confidence_percent:$confidence,evidence:$evidence}"]
    if live is true
      then llm.ask with model generator_model and instruction "Organize the supplied structural findings into a practical remediation review queue. Cite every STR-* ID and page, distinguish the checker finding from an interpretation, and request a rendered-document check before changes." and env_file env_file as draft_raw
    otherwise
      then llm.ask with model generator_model and instruction "Organize the supplied structural findings into a practical remediation review queue. Cite every STR-* ID and page, distinguish the checker finding from an interpretation, and request a rendered-document check before changes." and fixture draft_fixture_path and env_file env_file as draft_raw
    then parse json as draft_result
    take text at "/text" from draft_result as draft
    run jq with flags ["-n", "-r", "--arg", "draft", draft, "--arg", "evidence", evidence] and filter "($draft | rtrimstr(\"\\n\")) as $candidate | if ($candidate | startswith(\"EVIDENCE:\")) and ([$evidence | scan(\"[A-Z][A-Z0-9]+-[A-Z0-9-]+\") | . as $id | select($candidate | contains($id))] | length > 0) then $candidate else error(\"draft must start with EVIDENCE and cite an ID present in the bounded evidence\") end" as validated_draft
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "structural_finding_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "draft", validated_draft, "--arg", "action", "Document owner reviews the source and checker output before changing structure.", "{artifact:$artifact,status:\"draft-for-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,structural_remediation_queue:$draft,action:$action}"]
    then save to report_path
  otherwise
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "structural_finding_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "review_action", "This is a review map, not a conformance statement.", "{artifact:$artifact,status:\"needs-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,structural_remediation_queue:null,reason:\"Classifier selected the human-review label above the confidence threshold; no LLM draft was requested.\",action:$review_action}"]
    then save to report_path
  then cat with path report_path
otherwise
  then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "structural_finding_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "review_action", "This is a review map, not a conformance statement.", "{artifact:$artifact,status:\"needs-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,structural_remediation_queue:null,reason:\"Classifier confidence is below the configured 80 percent threshold; no LLM draft was requested.\",action:$review_action}"]
  then save to report_path
then cat with path report_path
