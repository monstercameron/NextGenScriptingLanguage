{
  "name": "uniq",
  "description": "Collapses or reports adjacent duplicate lines from standard input according to the selected uniq flags. Flag operands can name an input file and an output file, so file arguments read and write files.",
  "binary": "uniq",
  "accepts_stdin": true,
  "parameters": {
    "flags": {
      "type": "list",
      "items": "string"
    }
  },
  "arguments": [
    {
      "when_present": "flags",
      "append": [
        {
          "spread": "flags"
        }
      ]
    }
  ],
  "contract": {
    "version": 1,
    "backend": "command",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "raw"
    },
    "capabilities": [
      "process.exec",
      "filesystem.read",
      "filesystem.write"
    ],
    "effects": [
      "filesystem.read",
      "filesystem.write"
    ]
  }
}
