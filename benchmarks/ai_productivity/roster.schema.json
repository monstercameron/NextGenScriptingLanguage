{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://execute.invalid/schemas/ai-productivity-roster-1.json",
  "title": "Execute AI productivity evaluation task roster",
  "type": "object",
  "required": ["schema", "fixture_only", "frozen_utc", "task_package_sha256", "tasks"],
  "properties": {
    "schema": {"const": "execute.ai-productivity.roster/1"},
    "fixture_only": {"type": "boolean"},
    "frozen_utc": {"type": "string", "format": "date-time"},
    "task_package_sha256": {"$ref": "#/$defs/sha256"},
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "task": {
      "type": "object",
      "required": ["task_id", "family_id", "split", "stratum", "prompt_sha256", "oracle_sha256", "criteria"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
        "family_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
        "split": {"enum": ["development", "calibration", "held_out"]},
        "stratum": {"enum": ["workflow_cli", "desktop_composition", "maintenance_change"]},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "oracle_sha256": {"$ref": "#/$defs/sha256"},
        "criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}},
        "optional_criteria": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}}
      },
      "additionalProperties": false
    }
  }
}
