{
  "name": "text.truncate",
  "description": "Keeps text at or below a character-width limit, replacing the tail with an ellipsis string when truncation is needed.",
  "phrases": [
    "shorten text"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "description": "Text to shorten; omitted text is read from UTF-8 stdin."
    },
    "width": {
      "type": "unsigned_integer",
      "required": true,
      "description": "Maximum output width in Unicode scalar values, including ellipsis."
    },
    "ellipsis": {
      "type": "string",
      "description": "Ending used after truncation; defaults to the single-character ellipsis `…`."
    }
  },
  "parameter_alternatives": [
    {
      "message": "width must be a nonnegative integer",
      "any_of": [
        [
          {
            "test": "nonnegative_integer",
            "parameter": "width"
          }
        ]
      ]
    }
  ],
  "arguments": [
    {
      "literal": "text.truncate"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "text"
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        },
        "width": {
          "delivery": "single",
          "schema": {
            "type": "usize"
          }
        },
        "ellipsis": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        }
      }
    },
    "capabilities": [
      "text.transform"
    ]
  },
  "examples": [
    {
      "program": "run text.truncate with text \"abcdef\" and width 4 as value",
      "expected_output": "abc…"
    }
  ]
}
