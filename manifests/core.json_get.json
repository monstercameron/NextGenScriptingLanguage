{
  "name": "json.get",
  "description": "Returns the first non-null value found by a JSON Pointer or ordered pointer list, using default when none matches.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "document": {
      "type": "json",
      "description": "JSON value to search; stdin is used when omitted."
    },
    "pointer": {
      "type": "string",
      "description": "Single JSON Pointer to try before returning default."
    },
    "default": {
      "type": "json",
      "description": "JSON value returned when every candidate pointer is absent or null."
    },
    "pointers": {
      "type": "list",
      "items": "string",
      "description": "Ordered JSON Pointer candidates; the first present non-null value wins."
    }
  },
  "arguments": [
    {
      "literal": "json.get"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "json",
      "encoding": "json"
    },
    "capabilities": [
      "json.inspect"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "document": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        },
        "pointer": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "json"
          },
          "delivery": "single",
          "encoding": "json"
        },
        "default": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        },
        "pointers": {
          "schema": {
            "type": "list",
            "items": {
              "type": "text"
            }
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "get JSON value",
    "use JSON fallback"
  ],
  "examples": [
    {
      "program": "run json.get with document {\"name\":\"Ada\"} and pointer \"/name\" as result",
      "expected_output": "Ada"
    }
  ]
}
