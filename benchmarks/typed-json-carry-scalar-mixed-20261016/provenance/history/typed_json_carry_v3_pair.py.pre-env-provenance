    )
    expected = target_dir.resolve() / "release" / HELPER_NAME
    _expect(binary == expected, f"{side} helper is not the exact release/execute-applet artifact")
    return binary


def _artifact_identity(
    side: str,
    target_name: str,
    receipt: Mapping[str, Any],
    root: Path,
) -> dict[str, Any]:
    item = receipt["artifacts"].get(target_name)
    _expect(isinstance(item, dict), f"{side}/{target_name} receipt entry missing")
    expected_saved = BUILD_RUN / side / "binaries" / f"{target_name}-test-binary"
    saved = Path(item.get("saved_binary", "")).resolve(strict=True)
    _expect(saved == expected_saved.resolve(strict=True), f"{side}/{target_name} saved test binary path mismatch")
    saved_original = expected_saved
    _expect(not saved_original.is_symlink(), f"{side}/{target_name} saved test binary must be a regular copied file")
    artifact = item.get("cargo_artifact")
    binary = validate_artifact_row(
        artifact,
        side=side,
        root=root,
        target_name=target_name,
        expected_source=BUILD_TARGETS[target_name],
        test_profile=True,
        target_dir=TARGET,
    )
    _expect(Path(item.get("binary_path", "")).resolve() == binary, f"{side}/{target_name} original binary path mismatch")
    digest = item.get("saved_binary_sha256")
    _expect(isinstance(digest, str) and SHA256_RE.fullmatch(digest) is not None, f"{side}/{target_name} binary digest invalid")
    _expect(sha_file(saved) == digest and item.get("binary_sha256") == digest, f"{side}/{target_name} saved binary digest mismatch")
    _expect(os.access(saved, os.X_OK), f"{side}/{target_name} saved test binary is not executable")
    _expect(item.get("saved_binary_mode") == "0o555", f"{side}/{target_name} saved binary mode mismatch")
    _expect(stat.S_IMODE(saved.stat().st_mode) == 0o555, f"{side}/{target_name} saved test binary is writable or has unexpected mode")
    _expect(sha_file(binary) == item.get("binary_sha256"), f"{side}/{target_name} Cargo binary differs from its saved copy")
    return {
        "artifact": artifact,
        "cargo_binary": str(binary),
        "binary": str(saved),
        "binary_sha256": digest,
    }


