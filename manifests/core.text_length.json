{
  "name": "text.length",
  "description": "Counts Unicode scalar values or UTF-8 bytes in the input text and returns the selected count as an integer.",
  "phrases": [
    "count text characters"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "description": "Text whose length is measured; omitted text is read from UTF-8 stdin."
    },
    "unit": {
      "type": "string",
      "enum": [
        "chars",
        "bytes"
      ],
      "description": "Length unit: `chars` counts Unicode scalar values and `bytes` counts UTF-8 bytes; defaults to `chars`."
    }
  },
  "arguments": [
    {
      "literal": "text.length"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "integer"
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        },
        "unit": {
          "delivery": "single",
          "schema": {
            "type": "text",
            "enum": [
              "chars",
              "bytes"
            ]
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "integer"
          }
        }
      }
    },
    "capabilities": [
      "text.transform"
    ]
  },
  "examples": [
    {
      "program": "run text.length with text \"é🙂\" and unit \"bytes\" as value",
      "expected_output": 6
    }
  ]
}
