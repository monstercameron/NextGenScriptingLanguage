{
  "name": "fs.glob",
  "description": "Matches pathname components with *, ?, character sets and ** recursion, returning unique sorted paths while skipping hidden entries by default.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "pattern": {
      "type": "string",
      "required": true,
      "description": "Nonempty pathname pattern resolved from the program working directory; *, ? and character sets match within a component, and ** matches directory levels."
    },
    "include_hidden": {
      "type": "boolean",
      "description": "Set true to let wildcard components match names beginning with .; an explicitly dot-prefixed component matches hidden names regardless."
    }
  },
  "arguments": [
    {
      "literal": "fs.glob"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "parameter_alternatives": [
    {
      "message": "fs.glob pattern must be nonempty",
      "any_of": [
        [
          {
            "test": "nonempty",
            "parameter": "pattern"
          }
        ]
      ]
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "list",
      "encoding": "json",
      "items": {
        "type": "text"
      }
    },
    "capabilities": [
      "filesystem.read"
    ],
    "effects": [
      "filesystem.read"
    ],
    "ports": {
      "inputs": {
        "pattern": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "include_hidden": {
          "schema": {
            "type": "boolean"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "list",
            "items": {
              "type": "text"
            }
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "fs glob"
  ],
  "examples": [
    {
      "program": "run fs.glob with pattern \"catalog-example-no-match-494-*\" as matches",
      "expected_output": []
    }
  ]
}
