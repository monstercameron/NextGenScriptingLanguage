# Purpose: Tag a downloaded document by its content.
# Inputs: source_path, fixture paths, live=false.
# Outputs: out/010.json; candidate only; model text is never command code.
# Bash would need: content regex per document type plus metadata and uncertainty handling.
accept source_path as text with default "fixtures/010/source.txt"
accept fixture as text with default "fixtures/010/confident.json"
accept live as boolean with default false
try
  read source_path
  if live is true
    then jev.classify with question "Tag this file by content, using only invoice, notes, source, or unknown." and labels ["invoice","notes","source","unknown"] and minimum 80 and timeout_ms 3000 and max_bytes 65536 as raw # execute-allow: lint.unused_binding intentional model-result capture for acceptance analysis and downstream parsing
  otherwise
    then jev.classify with question "Tag this file by content, using only invoice, notes, source, or unknown." and labels ["invoice","notes","source","unknown"] and minimum 80 and timeout_ms 3000 and max_bytes 65536 and fixture fixture as raw
  then parse json as verdict
  take boolean at "/accepted" from verdict as accepted
  take integer at "/confidence_percent" from verdict as confidence # execute-allow: lint.unused_binding intentional typed take validates the model confidence field
  take text at "/label" from verdict as label
  if accepted is true
    if label is "invoice"
      run json.set with document {"action":"Review against the original input before acting.","result":null,"status":"candidate-for-review"} and pointer "/result" and value "invoice"
    otherwise
      run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
  otherwise
    run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
catch failure # execute-allow: lint.unused_binding intentional catch control binding; recovery uses the handler path rather than the error value
  run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
then save to "out/010.json"
