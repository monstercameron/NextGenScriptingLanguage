{
  "name": "list.concat",
  "description": "Concatenate a list of lists into one flat list, preserving each sublist’s order.",
  "phrases": [
    "list concat",
    "items concat"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "items": {
      "type": "json",
      "required": true,
      "description": "List of lists whose values will be appended in order."
    }
  },
  "arguments": [
    {
      "literal": "list.concat"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "list",
      "items": {
        "type": "json"
      }
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "items": {
          "delivery": "single",
          "schema": {
            "type": "list",
            "items": {
              "type": "list",
              "items": {
                "type": "json"
              }
            }
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "items": {
              "type": "json"
            },
            "type": "list"
          }
        }
      }
    },
    "capabilities": [
      "data.transform"
    ]
  },
  "examples": [
    {
      "program": "run list.concat with items [[1, 2], [3]] as result",
      "expected_output": [
        1,
        2,
        3
      ]
    }
  ]
}
