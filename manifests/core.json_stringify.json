{
  "name": "json.stringify",
  "description": "Serializes a JSON value as compact JSON text with deterministic object-key ordering.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "value": {
      "type": "json",
      "required": true,
      "description": "JSON value to serialize into compact JSON text."
    }
  },
  "arguments": [
    {
      "literal": "json.stringify"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "json"
    },
    "capabilities": [
      "json.convert"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "value": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "json stringify"
  ],
  "examples": [
    {
      "program": "run json.stringify with value {\"name\":\"Ada\",\"score\":8} as result",
      "expected_output": "{\"name\":\"Ada\",\"score\":8}"
    }
  ]
}
