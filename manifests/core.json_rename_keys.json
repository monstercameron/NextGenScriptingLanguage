{
  "name": "json.rename_keys",
  "description": "Renames selected top-level object keys while preserving values and rejecting name collisions.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "document": {
      "type": "record",
      "required": true,
      "fields": {},
      "additional_properties": {
        "type": "json"
      },
      "description": "JSON object whose top-level keys may be renamed; stdin is used when omitted."
    },
    "renames": {
      "type": "record",
      "required": true,
      "fields": {},
      "additional_properties": {
        "type": "string"
      },
      "description": "Object mapping existing key names to replacement string names; unlisted keys stay unchanged."
    }
  },
  "arguments": [
    {
      "literal": "json.rename_keys"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "json"
    },
    "capabilities": [
      "json.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "document": {
          "schema": {
            "type": "record",
            "fields": {},
            "additionalProperties": {
              "type": "json"
            }
          },
          "delivery": "single"
        },
        "renames": {
          "schema": {
            "type": "record",
            "fields": {},
            "additionalProperties": {
              "type": "text"
            }
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "json"
          }
        }
      }
    }
  },
  "phrases": [
    "json rename_keys"
  ],
  "examples": [
    {
      "program": "run json.rename_keys with document {\"name\":\"Ada\",\"score\":8} and renames {\"name\":\"display_name\"} as result",
      "expected_output": {
        "display_name": "Ada",
        "score": 8
      }
    }
  ]
}
