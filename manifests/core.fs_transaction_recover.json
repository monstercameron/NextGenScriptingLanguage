{
  "name": "fs.transaction.recover",
  "description": "Completes or rolls back an interrupted filesystem transaction when each target still matches a recorded before or after state; conflicting changes require manual recovery.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "journal": {
      "type": "path",
      "required": true
    },
    "decision": {
      "type": "string",
      "required": true,
      "enum": [
        "complete",
        "rollback"
      ]
    },
    "lock_timeout_ms": {
      "type": "integer"
    }
  },
  "arguments": [
    {
      "literal": "fs.transaction.recover"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "command",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "json",
      "encoding": "json"
    },
    "outcomes": [
      {
        "status": 0,
        "name": "success",
        "kind": "success"
      },
      {
        "status": 1,
        "name": "absence",
        "kind": "absence"
      },
      {
        "status": 2,
        "name": "failure",
        "kind": "failure"
      },
      {
        "status": 75,
        "name": "retryable",
        "kind": "retryable"
      },
      {
        "status": 76,
        "name": "uncertain_effect",
        "kind": "failure"
      }
    ],
    "capabilities": [
      "filesystem.read",
      "filesystem.write",
      "filesystem.lock"
    ],
    "effects": [
      "filesystem.write",
      "filesystem.lock"
    ],
    "result_envelope": true
  },
  "parameter_alternatives": [
    {
      "message": "lock_timeout_ms must be an integer from 0 through 300000",
      "any_of": [
        [
          {
            "test": "absent",
            "parameter": "lock_timeout_ms"
          }
        ],
        [
          {
            "test": "number_range",
            "parameter": "lock_timeout_ms",
            "minimum": 0,
            "maximum": 300000
          }
        ]
      ]
    }
  ]
}
