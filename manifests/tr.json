{
  "name": "tr",
  "description": "Translates or deletes characters in standard input using the supplied character sets and tr flags.",
  "binary": "tr",
  "accepts_stdin": true,
  "cacheable": true,
  "parameters": {
    "from": {
      "type": "string",
      "required": true
    },
    "to": {
      "type": "string",
      "required": true
    },
    "flags": {
      "type": "list",
      "items": "string"
    }
  },
  "arguments": [
    {
      "when_present": "flags",
      "append": [
        {
          "spread": "flags"
        }
      ]
    },
    {
      "literal": "--"
    },
    {
      "parameter": "from"
    },
    {
      "parameter": "to"
    }
  ]
}
