{
  "name": "wait.until",
  "description": "Polls a file or TCP readiness probe until it succeeds or the timeout expires, returning readiness and elapsed milliseconds.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "probe": {
      "type": "string",
      "required": true,
      "enum": [
        "file_exists",
        "file_readable",
        "socket_exists",
        "tcp_port_open"
      ],
      "description": "Readiness check: file_exists, file_readable, socket_exists (a Unix domain socket at path; unsupported off Unix), or tcp_port_open."
    },
    "host": {
      "type": "string",
      "required": false,
      "description": "Host name or IP address for tcp_port_open; required for that probe."
    },
    "path": {
      "type": "string",
      "required": false,
      "description": "Path checked by file_exists, file_readable or socket_exists, resolved relative to the program working directory."
    },
    "interval_ms": {
      "type": "integer",
      "required": false,
      "description": "Delay between probes in milliseconds; defaults to 50 and must be 1 through 10,000."
    },
    "port": {
      "type": "integer",
      "required": false,
      "description": "TCP port checked by tcp_port_open."
    },
    "timeout_ms": {
      "type": "integer",
      "required": false,
      "description": "Maximum wait in milliseconds, from 0 through 86,400,000. Required unless deadline_ms is given; not allowed with deadline_ms."
    },
    "deadline_ms": {
      "type": "integer",
      "required": false,
      "description": "Optional absolute deadline in Unix epoch milliseconds on the time.now clock; the wait becomes the time remaining, or zero when the deadline has passed. Not allowed with timeout_ms."
    }
  },
  "arguments": [
    {
      "literal": "wait.until"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "json"
    },
    "capabilities": [
      "filesystem.read",
      "network.loopback"
    ],
    "effects": [
      "network.loopback"
    ],
    "ports": {
      "inputs": {
        "probe": {
          "schema": {
            "type": "text",
            "enum": [
              "file_exists",
              "file_readable",
              "socket_exists",
              "tcp_port_open"
            ]
          },
          "delivery": "single"
        },
        "host": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "path": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "interval_ms": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "port": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "timeout_ms": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "deadline_ms": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "json"
          }
        }
      }
    }
  },
  "phrases": [
    "wait until"
  ],
  "parameter_alternatives": [
    {
      "message": "timeout_ms or deadline_ms is required",
      "any_of": [
        [
          {
            "test": "present",
            "parameter": "timeout_ms"
          }
        ],
        [
          {
            "test": "present",
            "parameter": "deadline_ms"
          }
        ]
      ]
    },
    {
      "message": "provide either timeout_ms or deadline_ms, not both",
      "any_of": [
        [
          {
            "test": "absent",
            "parameter": "deadline_ms"
          }
        ],
        [
          {
            "test": "absent",
            "parameter": "timeout_ms"
          }
        ]
      ]
    },
    {
      "message": "timeout_ms must be an integer from 0 through 86400000",
      "any_of": [
        [
          {
            "test": "absent",
            "parameter": "timeout_ms"
          }
        ],
        [
          {
            "test": "number_range",
            "parameter": "timeout_ms",
            "minimum": 0,
            "maximum": 86400000
          }
        ]
      ]
    },
    {
      "message": "interval_ms must be an integer from 1 through 10000",
      "any_of": [
        [
          {
            "test": "absent",
            "parameter": "interval_ms"
          }
        ],
        [
          {
            "test": "number_range",
            "parameter": "interval_ms",
            "minimum": 1,
            "maximum": 10000
          }
        ]
      ]
    },
    {
      "message": "path is required when probe is file_exists",
      "any_of": [
        [
          {
            "test": "string_not_equals",
            "parameter": "probe",
            "value": "file_exists"
          }
        ],
        [
          {
            "test": "present",
            "parameter": "path"
          }
        ]
      ]
    },
    {
      "message": "path is required when probe is file_readable",
      "any_of": [
        [
          {
            "test": "string_not_equals",
            "parameter": "probe",
            "value": "file_readable"
          }
        ],
        [
          {
            "test": "present",
            "parameter": "path"
          }
        ]
      ]
    },
    {
      "message": "path is required when probe is socket_exists",
      "any_of": [
        [
          {
            "test": "string_not_equals",
            "parameter": "probe",
            "value": "socket_exists"
          }
        ],
        [
          {
            "test": "present",
            "parameter": "path"
          }
        ]
      ]
    },
    {
      "message": "host is required when probe is tcp_port_open",
      "any_of": [
        [
          {
            "test": "string_not_equals",
            "parameter": "probe",
            "value": "tcp_port_open"
          }
        ],
        [
          {
            "test": "present",
            "parameter": "host"
          }
        ]
      ]
    },
    {
      "message": "port is required when probe is tcp_port_open",
      "any_of": [
        [
          {
            "test": "string_not_equals",
            "parameter": "probe",
            "value": "tcp_port_open"
          }
        ],
        [
          {
            "test": "present",
            "parameter": "port"
          }
        ]
      ]
    },
    {
      "message": "port must be an integer from 0 through 65535 when probe is tcp_port_open",
      "any_of": [
        [
          {
            "test": "string_not_equals",
            "parameter": "probe",
            "value": "tcp_port_open"
          }
        ],
        [
          {
            "test": "number_range",
            "parameter": "port",
            "minimum": 0,
            "maximum": 65535
          }
        ]
      ]
    }
  ],
  "examples": [
    {
      "program": "run wait.until with probe \"file_exists\" and path \".\" and interval_ms 1 and timeout_ms 100 as value",
      "expected_output": {
        "ready": true,
        "waited_ms": 0
      }
    }
  ]
}
