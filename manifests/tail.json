{
  "name": "tail",
  "description": "Prints the final lines of the selected file, or standard input when no path is supplied, with optional tail flags.",
  "binary": "tail",
  "accepts_stdin": true,
  "cacheable": false,
  "parameters": {
    "flags": {
      "type": "list",
      "items": "string"
    },
    "path": {
      "type": "string"
    }
  },
  "arguments": [
    {
      "when_present": "flags",
      "append": [
        {
          "spread": "flags"
        }
      ]
    },
    {
      "when_present": "path",
      "append": [
        {
          "literal": "--"
        },
        {
          "parameter": "path"
        }
      ]
    }
  ]
}
