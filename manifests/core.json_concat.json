{
  "name": "json.concat",
  "description": "Joins two JSON arrays in order and returns a new array.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "left": {
      "type": "json",
      "required": true,
      "description": "First JSON array to place at the start of the result."
    },
    "right": {
      "type": "json",
      "required": true,
      "description": "Second JSON array to append after every item in left."
    }
  },
  "arguments": [
    {
      "literal": "json.concat"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "items": {
        "type": "json"
      },
      "type": "list"
    },
    "capabilities": [
      "json.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "left": {
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          },
          "delivery": "single"
        },
        "right": {
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          }
        }
      }
    }
  },
  "phrases": [
    "json concat"
  ],
  "examples": [
    {
      "program": "run json.concat with left [1, 2] and right [3] as result",
      "expected_output": [
        1,
        2,
        3
      ]
    }
  ]
}
