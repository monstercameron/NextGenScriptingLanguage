{
  "name": "text.trim_final_lf",
  "description": "Removes at most one final LF byte from text and preserves all preceding content, including any earlier newline.",
  "binary": "@execute-applet",
  "cacheable": true,
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "description": "Text to inspect; omitted text is read from UTF-8 stdin."
    }
  },
  "arguments": [
    {
      "literal": "text.trim_final_lf"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "json"
    },
    "capabilities": [
      "text.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "text trim_final_lf"
  ],
  "examples": [
    {
      "program": "run text.trim_final_lf with text \"value\\n\\n\" as value",
      "expected_output": "value\n"
    }
  ]
}
