{
  "name": "number.ceil",
  "description": "Round a finite number toward positive infinity to the nearest integer value.",
  "phrases": [
    "number ceil",
    "value ceil"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "value": {
      "type": "json",
      "required": true,
      "description": "Finite JSON number to round upward."
    }
  },
  "arguments": [
    {
      "literal": "number.ceil"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "number"
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "number"
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "number"
          }
        }
      }
    },
    "capabilities": [
      "number.compute"
    ]
  },
  "examples": [
    {
      "program": "run number.ceil with value 2.2 as result",
      "expected_output": 3.0
    }
  ]
}
