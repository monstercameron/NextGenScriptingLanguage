{
  "name": "encode.url",
  "description": "Percent-encodes text or input-stream bytes for a URL component, optionally using + for spaces in form data.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "required": false,
      "description": "Optional text to percent-encode; when omitted, the applet encodes bytes from its input stream."
    },
    "form": {
      "type": "boolean",
      "required": false,
      "description": "Set true to encode spaces as + for form data; omitted or false encodes spaces as %20."
    }
  },
  "arguments": [
    {
      "literal": "encode.url"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "text"
    },
    "capabilities": [
      "text.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "form": {
          "schema": {
            "type": "boolean"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        }
      }
    }
  },
  "phrases": [
    "encode url"
  ],
  "examples": [
    {
      "program": "run encode.url with text \"a b/~\" as encoded",
      "expected_output": "a%20b%2F~"
    }
  ]
}
