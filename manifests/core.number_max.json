{
  "name": "number.max",
  "description": "Return the largest number in a nonempty list of numbers.",
  "phrases": [
    "number max",
    "values max"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "values": {
      "type": "list",
      "items": "number",
      "required": true,
      "min_items": 1,
      "description": "Nonempty list of finite numeric values to compare."
    }
  },
  "arguments": [
    {
      "literal": "number.max"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "number"
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "values": {
          "delivery": "single",
          "schema": {
            "type": "list",
            "items": {
              "type": "number"
            },
            "min_items": 1
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "number"
          }
        }
      }
    },
    "capabilities": [
      "number.compute"
    ]
  },
  "examples": [
    {
      "program": "run number.max with values [4, 9, 2] as result",
      "expected_output": 9
    }
  ]
}
