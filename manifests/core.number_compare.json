{
  "name": "number.compare",
  "description": "Compare two finite numbers and return -1, 0, or 1 according to their ordering.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "left": {
      "type": "json",
      "required": true,
      "description": "First finite number to compare."
    },
    "right": {
      "type": "json",
      "required": true,
      "description": "Second finite number to compare."
    }
  },
  "arguments": [
    {
      "literal": "number.compare"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "integer",
      "encoding": "json"
    },
    "capabilities": [
      "number.compute"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "left": {
          "schema": {
            "type": "number"
          },
          "delivery": "single"
        },
        "right": {
          "schema": {
            "type": "number"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "number compare"
  ],
  "examples": [
    {
      "program": "run number.compare with left 9 and right 10 as result",
      "expected_output": -1
    }
  ]
}
