{
  "name": "gh.repo",
  "description": "Fetches a GitHub repository’s name, star and fork counts, description, URL, and last-update time as JSON. It reads local gh credential and configuration files and connects to the GitHub API.",
  "binary": "gh",
  "cacheable": false,
  "parameters": {
    "repository": {
      "type": "string",
      "required": true
    }
  },
  "arguments": [
    {
      "literal": "repo"
    },
    {
      "literal": "view"
    },
    {
      "literal": "--json"
    },
    {
      "literal": "nameWithOwner,stargazerCount,forkCount,description,url,updatedAt"
    },
    {
      "literal": "--"
    },
    {
      "parameter": "repository"
    }
  ],
  "contract": {
    "version": 1,
    "backend": "command",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "raw"
    },
    "capabilities": [
      "process.exec",
      "filesystem.read",
      "network.connect"
    ],
    "effects": [
      "filesystem.read",
      "network.connect"
    ]
  }
}
