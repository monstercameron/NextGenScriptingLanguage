{
  "name": "decode.url",
  "description": "Percent-decodes URL text to UTF-8, optionally interpreting + as a space for form-encoded values.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "text": {
      "type": "string",
      "required": true,
      "description": "Percent-encoded UTF-8 text to decode."
    },
    "form": {
      "type": "boolean",
      "description": "Set true to decode + as a space as in application/x-www-form-urlencoded data; omitted or false preserves + literally."
    }
  },
  "arguments": [
    {
      "literal": "decode.url"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "text"
    },
    "capabilities": [
      "text.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "form": {
          "schema": {
            "type": "boolean"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        }
      }
    }
  },
  "phrases": [
    "decode url"
  ],
  "examples": [
    {
      "program": "run decode.url with text \"hello+world\" and form true as decoded",
      "expected_output": "hello world"
    }
  ]
}
