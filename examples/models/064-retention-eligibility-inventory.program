# Purpose: Calculate record age against a supplied retention schedule and legal-hold flag, then draft a human disposition checklist.
# Inputs: JSON records have RET-* IDs, age and schedule values in days, plus an explicit hold flag.
# Outputs: out/064-retention-eligibility-inventory.json: computed eligibility evidence and no-delete follow-up plan.
accept live as boolean with default false
accept source_path as text with default "fixtures/064/source-high.json"
accept report_path as text with default "out/064-retention-eligibility-inventory.json"
accept classify_fixture_path as text with default "fixtures/064/classify-high.json"
accept draft_fixture_path as text with default "fixtures/064/draft.json"
accept generator_model as text with default "gpt-6-luna"
accept env_file as text with default ".env"
# Refuse an output path that aliases an existing evidence or schema file.
run "test" with arguments ["!", source_path, "-ef", report_path]
run cat with path source_path
then jq with filter ".records[] | [.id, .class, .age_days, .retention_days, .hold, (if .hold then \"hold\" elif .age_days >= .retention_days then \"review-eligible\" else \"within-period\" end)] | @tsv" and flags ["-r"] as evidence
if live is true
  then jev.classify with question "Which records are arithmetically past their supplied retention period and still require a hold/owner check?" and labels ["review-eligible", "needs-human"] and minimum 80 and env_file env_file as class_raw # execute-allow: lint.unused_binding intentional model-result capture for acceptance analysis and downstream parsing
otherwise
  then jev.classify with question "Which records are arithmetically past their supplied retention period and still require a hold/owner check?" and labels ["review-eligible", "needs-human"] and minimum 80 and fixture classify_fixture_path and env_file env_file as class_raw
then parse json as classification
take text at "/label" from classification as label
take integer at "/confidence_percent" from classification as confidence
take boolean at "/accepted" from classification as accepted
if accepted is true
  if label is "review-eligible"
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "label", label, "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "{label:$label,confidence_percent:$confidence,evidence:$evidence}"]
    if live is true
      then llm.ask with model generator_model and instruction "Use the explicit age, retention, and hold fields to draft a retention review checklist. Cite RET-* IDs and state that eligibility is not deletion authority; request legal-hold, jurisdiction, owner, and schedule verification." and env_file env_file as draft_raw # execute-allow: lint.unused_binding intentional generated-text capture for review validation and downstream parsing
    otherwise
      then llm.ask with model generator_model and instruction "Use the explicit age, retention, and hold fields to draft a retention review checklist. Cite RET-* IDs and state that eligibility is not deletion authority; request legal-hold, jurisdiction, owner, and schedule verification." and fixture draft_fixture_path and env_file env_file as draft_raw
    then parse json as draft_result
    take text at "/text" from draft_result as draft
    run jq with flags ["-n", "-r", "--arg", "draft", draft, "--arg", "evidence", evidence] and filter "($draft | rtrimstr(\"\\n\")) as $candidate | if ($candidate | startswith(\"EVIDENCE:\")) and ([$evidence | scan(\"[A-Z][A-Z0-9]+-[A-Z0-9-]+\") | . as $id | select($candidate | contains($id))] | length > 0) then $candidate else error(\"draft must start with EVIDENCE and cite an ID present in the bounded evidence\") end" as validated_draft
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "retention_eligibility_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "draft", validated_draft, "--arg", "action", "Records owner and counsel decide disposition through approved process.", "{artifact:$artifact,status:\"draft-for-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,retention_disposition_checklist:$draft,action:$action}"]
    then save to report_path
  otherwise
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "retention_eligibility_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "review_action", "No record is deleted, changed, or moved.", "{artifact:$artifact,status:\"needs-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,retention_disposition_checklist:null,reason:\"Classifier selected the human-review label above the confidence threshold; no LLM draft was requested.\",action:$review_action}"]
    then save to report_path
  then cat with path report_path
otherwise
  then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "retention_eligibility_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "review_action", "No record is deleted, changed, or moved.", "{artifact:$artifact,status:\"needs-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,retention_disposition_checklist:null,reason:\"Classifier confidence is below the configured 80 percent threshold; no LLM draft was requested.\",action:$review_action}"]
  then save to report_path
then cat with path report_path
