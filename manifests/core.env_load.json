{
  "name": "env.load",
  "description": "Parses KEY=VALUE environment-file text into a string-valued object without evaluating shell expansions or commands.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "description": "Environment-file text is supplied through the applet input stream; shell syntax and duplicate variable names are rejected."
    },
    "secret": {
      "type": "json",
      "description": "Mark every loaded value secret with true, or list the variable names to mark; selected names must exist in the file.",
      "schema": {
        "type": "json",
        "one_of": [
          {
            "type": "boolean"
          },
          {
            "type": "list",
            "items": {
              "type": "string"
            }
          }
        ]
    }
    }
  },
  "arguments": [
    {
      "literal": "env.load"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "json",
      "encoding": "json"
    },
    "capabilities": [
      "text.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "secret": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "env load"
  ],
  "examples": [
    {
      "program": "run env.load as variables",
      "expected_output": {}
    }
  ]
}
