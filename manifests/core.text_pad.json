{
  "name": "text.pad",
  "description": "Pads text on the selected side until it reaches a target character or terminal display width, repeating the fill string as needed.",
  "phrases": [
    "pad text to width"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "description": "Text to pad; omitted text is read from UTF-8 stdin."
    },
    "width": {
      "type": "unsigned_integer",
      "required": true,
      "description": "Minimum target width, measured in Unicode scalar values unless display_width is true."
    },
    "side": {
      "type": "string",
      "enum": [
        "left",
        "right"
      ],
      "description": "Side that receives padding: `left` or `right`; defaults to `right`."
    },
    "fill": {
      "type": "string",
      "description": "Nonempty string repeated to make padding; defaults to a space."
    },
    "display_width": {
      "type": "boolean",
      "description": "When true, measure terminal display columns instead of Unicode scalar values; defaults to false."
    }
  },
  "parameter_alternatives": [
    {
      "message": "width must be a nonnegative integer within the text output limit",
      "any_of": [
        [
          {
            "test": "number_range",
            "parameter": "width",
            "minimum": 0,
            "maximum": 16777216
          }
        ]
      ]
    },
    {
      "message": "text.pad fill must be nonempty when supplied",
      "any_of": [
        [
          {
            "test": "absent",
            "parameter": "fill"
          }
        ],
        [
          {
            "test": "nonempty",
            "parameter": "fill"
          }
        ]
      ]
    }
  ],
  "arguments": [
    {
      "literal": "text.pad"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "text"
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        },
        "width": {
          "delivery": "single",
          "schema": {
            "type": "usize"
          }
        },
        "side": {
          "delivery": "single",
          "schema": {
            "type": "text",
            "enum": [
              "left",
              "right"
            ]
          }
        },
        "fill": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        },
        "display_width": {
          "delivery": "single",
          "schema": {
            "type": "boolean"
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        }
      }
    },
    "capabilities": [
      "text.transform"
    ]
  },
  "examples": [
    {
      "program": "run text.pad with text \"7\" and width 3 and side \"left\" and fill \"0\" as value",
      "expected_output": "007"
    }
  ]
}
