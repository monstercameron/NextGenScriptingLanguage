{
  "name": "comm",
  "description": "Compares two sorted files line by line and writes lines unique to either file and lines shared by both.",
  "binary": "comm",
  "parameters": {
    "flags": {
      "type": "list",
      "items": "string"
    },
    "files": {
      "type": "list",
      "items": "string",
      "required": true,
      "min_items": 2
    }
  },
  "arguments": [
    {
      "when_present": "flags",
      "append": [
        {
          "spread": "flags"
        }
      ]
    },
    {
      "literal": "--"
    },
    {
      "spread": "files"
    }
  ]
}
