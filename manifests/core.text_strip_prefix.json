{
  "name": "text.strip_prefix",
  "description": "Removes one exact prefix when present and otherwise returns the input text unchanged.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "description": "Text to transform; omitted text is read from UTF-8 stdin."
    },
    "prefix": {
      "type": "string",
      "required": true,
      "description": "Exact beginning to remove when present."
    }
  },
  "arguments": [
    {
      "literal": "text.strip_prefix"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "json"
    },
    "capabilities": [
      "text.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "prefix": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "text strip_prefix",
    "remove text prefix"
  ],
  "examples": [
    {
      "program": "run text.strip_prefix with text \"v2.4.0\" and prefix \"v\" as value",
      "expected_output": "2.4.0"
    }
  ]
}
