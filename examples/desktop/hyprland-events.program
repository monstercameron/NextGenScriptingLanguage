# Forward Hyprland's socket2 events, one line per event, as a listener.
# The manifest supplies the UNIX-CONNECT: address family itself, so the caller passes
# only a plain absolute socket path. Address syntax such as EXEC: or SYSTEM:, commas,
# colons and relative paths are refused before socat starts.
# The path is built from the session environment:
#   XDG_RUNTIME_DIR              the user's runtime directory
#   HYPRLAND_INSTANCE_SIGNATURE  the running compositor's instance name
# A listener must follow its input declarations directly, so the caller composes it:
#   execute examples/desktop/hyprland-events.program --input socket_path="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
# Each record is the handler's pipeline input and is forwarded unchanged.
accept socket_path as text

listen to hypr.socket2 with socket_path socket_path
whenever a line arrives as event
  then "cat"
