{
  "name": "csv.stringify",
  "description": "Serializes a rectangular table of string cells as CSV records using CRLF line endings and CSV quoting rules.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "table": {
      "type": "json",
      "required": true,
      "description": "Record containing a string headers array and a rows array of string arrays; each data row must have the same number of cells as the headers."
    }
  },
  "arguments": [
    {
      "literal": "csv.stringify"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "json"
    },
    "capabilities": [
      "csv.convert"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "table": {
          "schema": {
            "type": "record",
            "fields": {
              "headers": {
                "type": "list",
                "items": {
                  "type": "text"
                }
              },
              "rows": {
                "type": "list",
                "items": {
                  "type": "list",
                  "items": {
                    "type": "text"
                  }
                }
              }
            },
            "required": [
              "headers",
              "rows"
            ]
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "csv stringify"
  ],
  "examples": [
    {
      "program": "run csv.stringify with table {\"headers\":[\"name\",\"city\"],\"rows\":[[\"Ada\",\"London\"]]} as csv",
      "expected_output": "name,city\r\nAda,London\r\n"
    }
  ]
}
