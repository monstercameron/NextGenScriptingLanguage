{
  "name": "text.format",
  "description": "Provides the text format operation for controlled scripts.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "template": {
      "type": "string",
      "required": true
    },
    "values": {
      "type": "record",
      "required": true,
      "fields": {},
      "additional_properties": {
        "type": "scalar"
      }
    },
    "escape": {
      "type": "string",
      "required": true,
      "enum": [
        "plain",
        "json",
        "shell",
        "url",
        "csv",
        "html",
        "regex"
      ]
    }
  },
  "arguments": [
    {
      "literal": "text.format"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "json"
    },
    "capabilities": [
      "text.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "template": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "values": {
          "schema": {
            "type": "record",
            "fields": {},
            "additionalProperties": {
              "type": "json",
              "scalar_only": true
            }
          },
          "delivery": "single"
        },
        "escape": {
          "schema": {
            "type": "text",
            "enum": [
              "plain",
              "json",
              "shell",
              "url",
              "csv",
              "html",
              "regex"
            ]
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "format template",
    "escape text",
    "build safe text"
  ]
}
