# Purpose: Inspect locally proposed sensitive spans and prepare a redacted-copy review note without altering the source record.
# Inputs: JSON span export supplies RED-* IDs, category, offsets, and synthetic context; actual source editing is outside this workflow.
# Outputs: out/063-redaction-span-review.json: candidate span list and second-review instructions.
accept live as boolean with default false
accept source_path as text with default "fixtures/063/source-high.json"
accept report_path as text with default "out/063-redaction-span-review.json"
accept classify_fixture_path as text with default "fixtures/063/classify-high.json"
accept draft_fixture_path as text with default "fixtures/063/draft.json"
accept generator_model as text with default "gpt-6-luna"
accept env_file as text with default ".env"
# Refuse an output path that aliases an existing evidence or schema file.
run "test" with arguments ["!", source_path, "-ef", report_path]
run cat with path source_path
then jq with filter ".spans[] | [.id, .category, .start, .end, .context] | @tsv" and flags ["-r"] as evidence
if live is true
  then jev.classify with question "Which proposed spans should be reviewed before producing a redacted share copy?" and labels ["redaction-candidate", "needs-human"] and minimum 80 and env_file env_file as class_raw
otherwise
  then jev.classify with question "Which proposed spans should be reviewed before producing a redacted share copy?" and labels ["redaction-candidate", "needs-human"] and minimum 80 and fixture classify_fixture_path and env_file env_file as class_raw
then parse json as classification
take text at "/label" from classification as label
take integer at "/confidence_percent" from classification as confidence
take boolean at "/accepted" from classification as accepted
if accepted is true
  if label is "redaction-candidate"
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "label", label, "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "{label:$label,confidence_percent:$confidence,evidence:$evidence}"]
    if live is true
      then llm.ask with model generator_model and instruction "For each RED-* span, explain why the supplied category may require redaction and what surrounding context to retain. Cite offsets and IDs. Never reproduce a secret value or claim the redacted copy is ready to share." and env_file env_file as draft_raw
    otherwise
      then llm.ask with model generator_model and instruction "For each RED-* span, explain why the supplied category may require redaction and what surrounding context to retain. Cite offsets and IDs. Never reproduce a secret value or claim the redacted copy is ready to share." and fixture draft_fixture_path and env_file env_file as draft_raw
    then parse json as draft_result
    take text at "/text" from draft_result as draft
    run jq with flags ["-n", "-r", "--arg", "draft", draft, "--arg", "evidence", evidence] and filter "($draft | rtrimstr(\"\\n\")) as $candidate | if ($candidate | startswith(\"EVIDENCE:\")) and ([$evidence | scan(\"[A-Z][A-Z0-9]+-[A-Z0-9-]+\") | . as $id | select($candidate | contains($id))] | length > 0) then $candidate else error(\"draft must start with EVIDENCE and cite an ID present in the bounded evidence\") end" as validated_draft
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "sensitive_span_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "draft", validated_draft, "--arg", "action", "A second reviewer checks the candidate output before any sharing.", "{artifact:$artifact,status:\"draft-for-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,redaction_span_review:$draft,action:$action}"]
    then save to report_path
  otherwise
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "sensitive_span_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "review_action", "This workflow drafts review guidance; it does not modify source or distribute a copy.", "{artifact:$artifact,status:\"needs-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,redaction_span_review:null,reason:\"Classifier selected the human-review label above the confidence threshold; no LLM draft was requested.\",action:$review_action}"]
    then save to report_path
  then cat with path report_path
otherwise
  then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "sensitive_span_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "review_action", "This workflow drafts review guidance; it does not modify source or distribute a copy.", "{artifact:$artifact,status:\"needs-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,redaction_span_review:null,reason:\"Classifier confidence is below the configured 80 percent threshold; no LLM draft was requested.\",action:$review_action}"]
  then save to report_path
then cat with path report_path
