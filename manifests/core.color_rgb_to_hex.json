{
  "name": "color.rgb_to_hex",
  "description": "Formats three 8-bit color channels as a six-digit hexadecimal color string prefixed by #.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "red": {
      "type": "integer",
      "required": true,
      "description": "Red channel as an integer from 0 through 255."
    },
    "green": {
      "type": "integer",
      "required": true,
      "description": "Green channel as an integer from 0 through 255."
    },
    "blue": {
      "type": "integer",
      "required": true,
      "description": "Blue channel as an integer from 0 through 255."
    },
    "uppercase": {
      "type": "boolean",
      "description": "Set true to use A–F uppercase hexadecimal digits; omitted or false uses lowercase digits."
    }
  },
  "arguments": [
    {
      "literal": "color.rgb_to_hex"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "json"
    },
    "capabilities": [
      "color.convert"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "red": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "green": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "blue": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "uppercase": {
          "schema": {
            "type": "boolean"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "color rgb_to_hex"
  ],
  "examples": [
    {
      "program": "run color.rgb_to_hex with red 12 and green 34 and blue 56 as color",
      "expected_output": "#0c2238"
    }
  ]
}
