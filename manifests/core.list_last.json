{
  "name": "list.last",
  "description": "Return the final value in a nonempty list; an empty list is an error.",
  "phrases": [
    "list last",
    "items last"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "items": {
      "type": "json",
      "required": true,
      "description": "List from which to return the last value; must not be empty."
    }
  },
  "arguments": [
    {
      "literal": "list.last"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "json"
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "items": {
          "delivery": "single",
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "json"
          }
        }
      }
    },
    "capabilities": [
      "data.transform"
    ]
  },
  "examples": [
    {
      "program": "run list.last with items [\"first\", \"last\"] as result",
      "expected_output": "last"
    }
  ]
}
