          },
          "threshold": {
            "schema": { "type": "text" },
            "delivery": "single"
          }
        },
        "events": {
          "updated": {
            "schema": {
              "type": "record",
              "fields": {
                "overdue": { "type": "integer" },
                "threshold": { "type": "integer" }
              },
              "required": ["overdue", "threshold"]
            },
            "delivery": "events"
          }
        }
      }
    }
  },
  "dependencies": {}
