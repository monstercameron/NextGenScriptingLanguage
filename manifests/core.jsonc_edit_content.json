{
  "name": "jsonc.edit_content",
  "description": "Edits one root property in JSONC text while preserving comments, formatting, and trailing-comma style.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "content": {
      "type": "string",
      "description": "JSONC source text to edit; when omitted, the applet reads UTF-8 JSONC from stdin."
    },
    "action": {
      "type": "string",
      "required": true,
      "enum": [
        "set",
        "remove"
      ],
      "description": "Choose set to create or replace the root property, or remove to delete it."
    },
    "key": {
      "type": "string",
      "required": true,
      "description": "Name of the root property to edit."
    },
    "value": {
      "type": "json",
      "description": "Required when action is set (including JSON null); unused for remove."
    }
  },
  "arguments": [
    {
      "literal": "jsonc.edit_content"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "json"
    },
    "capabilities": [
      "jsonc.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "content": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "action": {
          "schema": {
            "type": "text",
            "enum": [
              "set",
              "remove"
            ]
          },
          "delivery": "single"
        },
        "key": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "value": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      }
    }
  },
  "parameter_alternatives": [
    {
      "message": "jsonc.edit_content requires value when action is set",
      "any_of": [
        [{"test": "present", "parameter": "value"}],
        [{"test": "string_not_equals", "parameter": "action", "value": "set"}]
      ]
    }
  ],
  "phrases": [
    "jsonc edit_content"
  ],
  "examples": [
    {
      "program": "run jsonc.edit_content with content \"{}\" and action \"set\" and key \"theme\" and value \"dark\" as result",
      "expected_output": "{\"theme\": \"dark\"}"
    }
  ]
}
