+        let literal = r#""line\nquote: \" slash: \\ solidus: \/ nul: \u0000 astral: \uD83D\uDE00""#;
+        let tokens = tokenize(literal).unwrap();
+        let Token::String(Cow::Owned(value)) = &tokens[0] else {
+            panic!("escaped string should use the JSON decoder")
+        };
