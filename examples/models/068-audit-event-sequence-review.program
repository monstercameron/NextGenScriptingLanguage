# Purpose: Compute adjacent event sequence gaps from an offline audit export before drafting an integrity investigation checklist.
# Inputs: TSV rows contain integer sequence and AUD-* event IDs plus actor/action fields.
# Outputs: out/068-audit-event-sequence-review.json: deterministic gap evidence with investigation questions.
accept live as boolean with default false
accept source_path as text with default "fixtures/068/source-high.txt"
accept report_path as text with default "out/068-audit-event-sequence-review.json"
accept classify_fixture_path as text with default "fixtures/068/classify-high.json"
accept draft_fixture_path as text with default "fixtures/068/draft.json"
accept generator_model as text with default "gpt-6-luna"
accept env_file as text with default ".env"
# Refuse an output path that aliases an existing evidence or schema file.
run "test" with arguments ["!", source_path, "-ef", report_path]
run cat with path source_path
then awk with delimiter "\t" and program "NR == 1 { previous=$1; printf \"%s\\tseq=%d\\tgap=0\\t%s\\n\", $2, $1, $3; next } { gap=$1-previous-1; printf \"%s\\tseq=%d\\tgap=%d\\t%s\\n\", $2, $1, gap, $3; previous=$1 }" as evidence
if live is true
  then jev.classify with question "Do the sequence gaps or order in this local audit slice need an integrity follow-up?" and labels ["sequence-anomaly", "needs-human"] and minimum 80 and env_file env_file as class_raw # execute-allow: lint.unused_binding intentional model-result capture for acceptance analysis and downstream parsing
otherwise
  then jev.classify with question "Do the sequence gaps or order in this local audit slice need an integrity follow-up?" and labels ["sequence-anomaly", "needs-human"] and minimum 80 and fixture classify_fixture_path and env_file env_file as class_raw
then parse json as classification
take text at "/label" from classification as label
take integer at "/confidence_percent" from classification as confidence
take boolean at "/accepted" from classification as accepted
if accepted is true
  if label is "sequence-anomaly"
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "label", label, "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "{label:$label,confidence_percent:$confidence,evidence:$evidence}"]
    if live is true
      then llm.ask with model generator_model and instruction "Explain only the computed sequence gaps and supplied actions. Cite AUD-* event IDs and sequence numbers; list plausible collection checks without alleging tampering or attributing intent." and env_file env_file as draft_raw # execute-allow: lint.unused_binding intentional generated-text capture for review validation and downstream parsing
    otherwise
      then llm.ask with model generator_model and instruction "Explain only the computed sequence gaps and supplied actions. Cite AUD-* event IDs and sequence numbers; list plausible collection checks without alleging tampering or attributing intent." and fixture draft_fixture_path and env_file env_file as draft_raw
    then parse json as draft_result
    take text at "/text" from draft_result as draft
    run jq with flags ["-n", "-r", "--arg", "draft", draft, "--arg", "evidence", evidence] and filter "($draft | rtrimstr(\"\\n\")) as $candidate | if ($candidate | startswith(\"EVIDENCE:\")) and ([$evidence | scan(\"[A-Z][A-Z0-9]+-[A-Z0-9-]+\") | . as $id | select($candidate | contains($id))] | length > 0) then $candidate else error(\"draft must start with EVIDENCE and cite an ID present in the bounded evidence\") end" as validated_draft
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "audit_event_sequence_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "draft", validated_draft, "--arg", "action", "Audit owner checks ingestion offsets, filters, and source retention.", "{artifact:$artifact,status:\"draft-for-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,event_integrity_questions:$draft,action:$action}"]
    then save to report_path
  otherwise
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "audit_event_sequence_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "review_action", "This workflow detects gaps in one slice; it does not diagnose cause.", "{artifact:$artifact,status:\"needs-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,event_integrity_questions:null,reason:\"Classifier selected the human-review label above the confidence threshold; no LLM draft was requested.\",action:$review_action}"]
    then save to report_path
  then cat with path report_path
otherwise
  then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "audit_event_sequence_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "review_action", "This workflow detects gaps in one slice; it does not diagnose cause.", "{artifact:$artifact,status:\"needs-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,event_integrity_questions:null,reason:\"Classifier confidence is below the configured 80 percent threshold; no LLM draft was requested.\",action:$review_action}"]
  then save to report_path
then cat with path report_path
