{
  "name": "fs.test",
  "description": "Checks a path predicate such as existence, file type, permissions, emptiness, special file kind, ownership or modification-time order and returns false when the path is absent.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "path": {
      "type": "path",
      "required": true,
      "description": "Path to inspect; relative paths resolve from the program working directory."
    },
    "kind": {
      "type": "string",
      "required": true,
      "enum": [
        "exists",
        "file",
        "directory",
        "symlink",
        "readable",
        "writable",
        "executable",
        "empty",
        "socket",
        "fifo",
        "owned_by_me",
        "nonempty",
        "newer_than",
        "older_than"
      ],
      "description": "Predicate to check: exists, file, directory, symlink, readable, writable, executable, empty, socket, fifo, owned_by_me, nonempty, newer_than or older_than."
    },
    "other": {
      "type": "path",
      "description": "Second path that newer_than and older_than compare against; required for those kinds."
    }
  },
  "arguments": [
    {
      "literal": "fs.test"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "boolean",
      "encoding": "json"
    },
    "capabilities": [
      "filesystem.read"
    ],
    "effects": [
      "filesystem.read"
    ],
    "ports": {
      "inputs": {
        "path": {
          "schema": {
            "type": "path"
          },
          "delivery": "single"
        },
        "kind": {
          "schema": {
            "type": "text",
            "enum": [
              "exists",
              "file",
              "directory",
              "symlink",
              "readable",
              "writable",
              "executable",
              "empty",
              "socket",
              "fifo",
              "owned_by_me",
              "nonempty",
              "newer_than",
              "older_than"
            ]
          },
          "delivery": "single"
        },
        "other": {
          "schema": {
            "type": "path"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "boolean"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "fs test"
  ],
  "examples": [
    {
      "program": "run fs.test with path \"catalog-example-missing-494\" and kind \"exists\" as found",
      "expected_output": false
    },
    {
      "program": "run fs.test with path \"catalog-example-missing-494\" and kind \"nonempty\" as filled",
      "expected_output": false
    }
  ]
}
