{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://execute.invalid/schemas/ai-productivity-real-bash-100-run-plan-1.json",
  "title": "Frozen 300-cell dispatch schedule",
  "type": "object",
  "required": ["schema", "status", "randomization_seed", "task_roster_sha256", "blind_arm_ids", "cells"],
  "properties": {
    "schema": {"const": "execute.ai-productivity.real-bash-100-run-plan/1"},
    "status": {"const": "frozen_before_dispatch"},
    "randomization_seed": {"type": "integer", "minimum": 0},
    "task_roster_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "blind_arm_ids": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^arm_[a-z0-9]{8,32}$"}},
    "cells": {
      "type": "array", "minItems": 300, "maxItems": 300,
      "items": {
        "type": "object",
        "required": ["dispatch_index", "task_id", "blind_arm_id", "replicate"],
        "properties": {
          "dispatch_index": {"type": "integer", "minimum": 1, "maximum": 300},
          "task_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}$"},
          "blind_arm_id": {"type": "string", "pattern": "^arm_[a-z0-9]{8,32}$"},
          "replicate": {"const": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
