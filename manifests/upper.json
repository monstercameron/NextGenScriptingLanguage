{
  "name": "upper",
  "description": "Converts lowercase characters in standard input to their uppercase equivalents.",
  "phrases": [
    "uppercase"
  ],
  "binary": "tr",
  "accepts_stdin": true,
  "cacheable": true,
  "arguments": [
    {
      "literal": "[:lower:]"
    },
    {
      "literal": "[:upper:]"
    }
  ],
  "contract": {
    "version": 1,
    "backend": "command",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "raw"
    },
    "capabilities": [
      "process.exec"
    ],
    "effects": []
  }
}
