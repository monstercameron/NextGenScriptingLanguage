def raw_report():
    semantic = {
        "output_hex": pair.EXPECTED_OUTPUT_HEX,
        "launched_processes": 0,
        "cache_hits": 0,
        "retained_execution_records": 256,
        "expected_retained_execution_records": 256,
        "retained_all_success_status_0": True,
        "retained_stdout_bytes_per_call": 2,
        "dropped_execution_records": 744,
        "expected_dropped_execution_records": 744,
        "dropped_stages": 744,
    }
    return {
        "schema": "typed_json_carry_public_runtime_bench/v1",
        "method": pair.EXPECTED_METHOD,
        "warmup_runs": 0,
        "measured_samples": 3,
        "workload": {
            "calls": 1000,
            "applet": "number.add",
            "literal_operands": [1, 2],
            "source_bytes": pair.EXPECTED_SOURCE_BYTES,
            "source_sha256": pair.EXPECTED_SOURCE_SHA256,
            "catalog_sha256": "a" * 64,
        },
        "results": {
            pair.CASE: {
                "p50_ns": 20,
                "p95_ns": 30,
                "raw_sample_ns": [10, 20, 30],
                "semantic_oracles": [dict(semantic) for _ in range(3)],
            }
        },
    }


def artifact(*, fresh=False, target_name="opt_typed_json_carry", test=True):
    return {
        "reason": "compiler-artifact",
        "fresh": fresh,
        "package_id": "path+file:///tmp/candidate#execute@0.1.0",
        "manifest_path": "/tmp/candidate/Cargo.toml",
        "target": {
            "name": target_name,
            "src_path": "/tmp/candidate/tests/opt_typed_json_carry.rs",
            "kind": ["test"] if test else ["bin"],
            "test": test,
        },
        "profile": {"test": test, "opt_level": "3", "debug_assertions": False},
        "executable": "/tmp/target/release/deps/opt_typed_json_carry-abc",
        "filenames": ["/tmp/target/release/deps/opt_typed_json_carry-abc"],
    }


class TypedJsonCarryPairTests(unittest.TestCase):
    def test_build_driver_drops_unallowlisted_inherited_overrides(self):
        with tempfile.TemporaryDirectory() as directory:
            host = {
                "PATH": "/untrusted/tool/bin:/usr/bin",
                "HOME": directory,
                "LANG": "C.UTF-8",
                "RUSTFLAGS": "-C opt-level=0",
                "CARGO_HOME": "/attacker/cargo",
                "EXECUTE_EXTRA": "should-not-forward",
            }
            environment = build_driver.setup_environment(host)
        self.assertEqual(
            set(environment),
            set(build_driver.INHERITED_BUILD_ENV_KEYS) & set(host) | set(build_driver.FIXED_BUILD_ENVIRONMENT),
        )
        self.assertTrue(environment["PATH"].startswith(str(build_driver.PINNED_CARGO_BIN) + os.pathsep))
        self.assertEqual(environment["PATH"].split(os.pathsep, 1)[1], host["PATH"])
        self.assertNotIn("RUSTFLAGS", environment)
        self.assertNotIn("EXECUTE_EXTRA", environment)
        self.assertEqual(environment["CARGO_HOME"], str(build_driver.PINNED_CARGO_HOME))
        self.assertEqual(environment["RUSTUP_HOME"], str(build_driver.PINNED_RUSTUP_HOME))
        with self.assertRaisesRegex(RuntimeError, "requires inherited PATH and HOME"):
            build_driver.setup_environment({"PATH": "/usr/bin"})

    def test_cargo_configuration_fingerprint_covers_home_and_ancestors_to_filesystem_root(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            home = root / "home"
            cargo_home = root / "cargo"
            baseline = home / "project/work/baseline"
            candidate = home / "project/work/candidate"
            cargo_home.mkdir()
            baseline.mkdir(parents=True)
            candidate.mkdir(parents=True)
            (cargo_home / "config.toml").write_text("[net]\noffline = true\n")
            (cargo_home / "config").symlink_to("config.toml")
            (home / ".cargo").mkdir()
            (home / ".cargo/config.toml").write_text("[build]\njobs = 4\n")
            environment = {"HOME": str(home), "CARGO_HOME": str(cargo_home)}
            roots = {"baseline": baseline, "candidate": candidate}

            before = build_driver.cargo_configuration_fingerprint(roots, environment)
            self.assertTrue(before["source_roots"]["baseline"]["home_is_ancestor"])
            self.assertEqual(before["cargo_home"]["config_files"][0]["symlink_target"], "config.toml")
            ancestor_paths = {
                entry["path"]
                for entry in before["source_roots"]["baseline"]["config_files"]
            }
            filesystem_root_configs = {
                str(Path("/") / ".cargo" / filename)
                for filename in build_driver.CARGO_CONFIG_FILENAMES
            }
            self.assertTrue(filesystem_root_configs.issubset(ancestor_paths))
            pair.validate_cargo_configuration_fingerprint(before, "test")

            (home / ".cargo/config.toml").write_text("[build]\njobs = 5\n")
            after = build_driver.cargo_configuration_fingerprint(roots, environment)
            self.assertNotEqual(before, after)
            with self.assertRaisesRegex(RuntimeError, "changed during"):
                build_driver.verify_cargo_configuration_fingerprint(before, roots, environment, "during")

    def test_runner_build_environment_validation_rejects_overrides(self):
        environment = {
            "PATH": str(pair.PINNED_CARGO_BIN) + os.pathsep + "/usr/bin",
            "HOME": "/Users/example",
            "LANG": "C.UTF-8",
            **pair.FIXED_BUILD_ENVIRONMENT,
        }
        self.assertEqual(pair.validate_selected_build_environment(environment, "test"), environment)
        environment["RUSTFLAGS"] = "-C opt-level=0"
        with self.assertRaisesRegex(pair.PairError, "unallowlisted"):
            pair.validate_selected_build_environment(environment, "test")

    def test_fixed_schedule_has_three_warmups_then_balanced_48_measurements(self):
        all_orders = [pair.interleaved_order(index) for index in range(pair.WARMUP_PAIRS + pair.MEASURED_PAIRS)]
        self.assertEqual(all_orders[:3], [
            ("baseline", "candidate"),
            ("candidate", "baseline"),
            ("baseline", "candidate"),
        ])
        measured = all_orders[pair.WARMUP_PAIRS:]
        self.assertEqual(len(measured), 48)
        self.assertEqual(measured[0], ("candidate", "baseline"))
        self.assertEqual(measured.count(("baseline", "candidate")), 24)
        self.assertEqual(measured.count(("candidate", "baseline")), 24)
        self.assertEqual(2 * len(all_orders), 102)

    def test_raw_report_accepts_exact_schema_and_semantics(self):
        result = pair.validate_raw_report(json.dumps(raw_report()).encode())
        self.assertEqual(result["median_duration_ns"], 20)
        self.assertEqual(result["raw_sample_ns"], [10, 20, 30])
        self.assertEqual(result["workload"]["catalog_sha256"], "a" * 64)
        self.assertEqual(len(result["semantic_oracles"]), 3)

    def test_raw_report_rejects_bad_per_sample_status_output_and_counts(self):
        fields = (
            ("output_hex", "34"),
            ("launched_processes", 1),
            ("cache_hits", 1),
            ("retained_execution_records", 255),
            ("retained_all_success_status_0", False),
            ("retained_stdout_bytes_per_call", 1),
            ("dropped_execution_records", 743),
            ("dropped_stages", 743),
        )
        for field, value in fields:
            with self.subTest(field=field):
                report = raw_report()
                report["results"][pair.CASE]["semantic_oracles"][1][field] = value
                with self.assertRaises(pair.PairError):
                    pair.validate_raw_report(json.dumps(report).encode())

    def test_raw_report_rejects_call_shape_and_catalog_digest(self):
        for field, value in (
            ("calls", True),
            ("source_bytes", 1),
            ("source_sha256", "0" * 64),
            ("catalog_sha256", "z" * 64),
        ):
            with self.subTest(field=field):
                report = raw_report()
                report["workload"][field] = value
                with self.assertRaises(pair.PairError):
                    pair.validate_raw_report(json.dumps(report).encode())

    def test_raw_report_rejects_malformed_durations_and_percentiles(self):
        mutations = (
            lambda r: r["results"][pair.CASE].update(raw_sample_ns=[10, 20]),
            lambda r: r["results"][pair.CASE].update(raw_sample_ns=[10, True, 30]),
            lambda r: r["results"][pair.CASE].update(p50_ns=21),
            lambda r: r["results"][pair.CASE].update(p95_ns=29),
            lambda r: r["results"][pair.CASE].update(p95_ns=True),
        )
        for mutate in mutations:
            with self.subTest(mutate=mutate):
                report = raw_report()
                mutate(report)
                with self.assertRaises(pair.PairError):
                    pair.validate_raw_report(json.dumps(report).encode())

    def test_raw_report_rejects_wrong_case_schema_or_extra_field(self):
        report = raw_report()
        report["results"]["another_case"] = report["results"].pop(pair.CASE)
        with self.assertRaises(pair.PairError):
            pair.validate_raw_report(json.dumps(report).encode())
        report = raw_report()
        report["unexpected"] = 1
        with self.assertRaises(pair.PairError):
            pair.validate_raw_report(json.dumps(report).encode())

    def test_strict_json_rejects_duplicate_keys_and_nonfinite_constants(self):
        for payload in (b'{"a":1,"a":2}', b'{"x": NaN}', b'{"x": Infinity}'):
            with self.subTest(payload=payload):
                with self.assertRaises(pair.PairError):
                    pair.strict_json_bytes(payload, "test input")

    def test_workload_compatibility_requires_same_catalog_hash(self):
        first = raw_report()["workload"]
        second = dict(first)
        self.assertTrue(pair.workload_compatible([first, second]))
        second["catalog_sha256"] = "b" * 64
        self.assertFalse(pair.workload_compatible([first, second]))
        self.assertFalse(pair.workload_compatible([]))

    def test_source_pair_rejects_unexpected_product_delta_and_same_binary(self):
        common = {
            "source_fingerprint": {"files": {"a": "1", "src/runtime.rs": "old"}},
            "root": "/baseline",
            "opt_test_binary": {"binary": "/bin/a", "binary_sha256": "a" * 64},
            "harness_source_sha256": pair.EXPECTED_HARNESS_SHA256,
            "harness_patch_sha256": pair.HARNESS_PATCH_SHA256,
            "product_patch_sha256": pair.PRODUCT_PATCH_SHA256,
        }
        candidate = {
            **common,
            "source_fingerprint": {"files": {"a": "1", "src/runtime.rs": "new"}},
            "root": "/candidate",
            "opt_test_binary": {"binary": "/bin/b", "binary_sha256": "b" * 64},
        }
        # The small map is deliberately invalid because it omits the exact six-file
        # product delta; validation must not accept partial provenance.
        with self.assertRaises(pair.PairError):
            pair.source_map_pair_validation(common, candidate)
        candidate["source_fingerprint"] = {"files": {
            "src/contracts.rs": "2",
            "src/manifest.rs": "2",
            "src/runtime.rs": "2",
            "src/runtime/program_backend.rs": "2",
            "src/runtime/windows_process.rs": "2",
            "tests/typed_contracts.rs": "2",
        }}
        common["source_fingerprint"] = {"files": {
            "src/contracts.rs": "1",
            "src/manifest.rs": "1",
            "src/runtime.rs": "1",
            "src/runtime/program_backend.rs": "1",
            "src/runtime/windows_process.rs": "1",
            "tests/typed_contracts.rs": "1",
        }}
        self.assertEqual(len(pair.source_map_pair_validation(common, candidate)), 6)
        candidate["opt_test_binary"] = dict(common["opt_test_binary"])
        with self.assertRaises(pair.PairError):
            pair.source_map_pair_validation(common, candidate)

