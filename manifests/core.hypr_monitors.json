{
  "name": "hypr.monitors",
  "description": "Returns the current Hyprland monitor details as a JSON list.",
  "binary": "hyprctl",
  "accepts_stdin": false,
  "cacheable": false,
  "parameters": {},
  "arguments": [
    {
      "literal": "-j"
    },
    {
      "literal": "monitors"
    }
  ],
  "contract": {
    "version": 1,
    "backend": "command",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "list",
      "encoding": "json",
      "items": {
        "type": "json"
      }
    },
    "outcomes": [
      {
        "status": 0,
        "name": "success",
        "kind": "success"
      },
      {
        "status": 127,
        "name": "not_found",
        "kind": "absence"
      }
    ],
    "capabilities": [
      "compositor.inspect"
    ],
    "effects": []
  }
}
