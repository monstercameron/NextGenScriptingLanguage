{
  "name": "json.set",
  "description": "Sets a value at a JSON Pointer, creating an object member or replacing an existing value, then returns the edited document.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "document": {
      "type": "json",
      "description": "JSON value to edit; stdin is used when omitted."
    },
    "pointer": {
      "type": "string",
      "description": "JSON Pointer identifying the value to replace or the final member to create; an empty pointer replaces the whole document."
    },
    "value": {
      "type": "json",
      "required": true,
      "description": "JSON value to store at pointer."
    }
  },
  "arguments": [
    {
      "literal": "json.set"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "json",
      "encoding": "json"
    },
    "capabilities": [
      "json.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "document": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        },
        "pointer": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "value": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "json"
          },
          "delivery": "single",
          "encoding": "json"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "json set"
  ],
  "examples": [
    {
      "program": "run json.set with document {\"name\":\"Ada\"} and pointer \"/active\" and value true as result",
      "expected_output": {
        "active": true,
        "name": "Ada"
      }
    }
  ]
}
