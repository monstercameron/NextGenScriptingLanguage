{
  "name": "list.group",
  "description": "Group records by the value at a JSON Pointer and return each key with its count.",
  "phrases": [
    "group records",
    "count by key"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "items": {
      "type": "list",
      "items": "json",
      "description": "List of JSON records to group."
    },
    "key": {
      "type": "string",
      "required": true,
      "description": "JSON Pointer identifying the grouping value in each record, such as /team."
    },
    "n": {
      "type": "integer",
      "required": false,
      "description": "Accepted for compatibility; grouping does not limit the number of records."
    },
    "collect": {
      "type": "boolean",
      "description": "When true, include each group’s original records in an items array."
    }
  },
  "arguments": [
    {
      "literal": "list.group"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "list",
      "encoding": "json",
      "items": {
        "type": "json"
      }
    },
    "capabilities": [
      "data.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "items": {
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          },
          "delivery": "single"
        },
        "key": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "n": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "collect": {
          "schema": {
            "type": "boolean"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          },
          "delivery": "single"
        }
      }
    }
  },
  "examples": [
    {
      "program": "run list.group with items [{\"team\":\"red\"}, {\"team\":\"blue\"}, {\"team\":\"red\"}] and key \"/team\" as result",
      "expected_output": [
        {
          "count": 2,
          "key": "red"
        },
        {
          "count": 1,
          "key": "blue"
        }
      ]
    }
  ]
}
