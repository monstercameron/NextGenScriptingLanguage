# Purpose: Build an onboarding map for an unfamiliar repository; create a structured source-cited review artifact without modifying source records.
# Inputs: local source.json evidence, a local strict output schema, an offline model fixture, and a private empty environment file.
# Outputs: out/repository-onboarding.json; extracted content remains a human-reviewed candidate.
accept source_path as text with default "fixtures/019/source.json"
accept schema_path as text with default "fixtures/019/schema.json"
accept extract_fixture_path as text with default "fixtures/019/extract-structured-candidate.json"
accept report_path as text with default "out/repository-onboarding.json"
accept generator_model as text with default "gpt-6-luna"
accept env_file as text with default ".env"
accept live as boolean with default false
# Refuse an output path that aliases an existing evidence or schema file.
run "test" with arguments ["!", source_path, "-ef", report_path]
run "test" with arguments ["!", schema_path, "-ef", report_path]
read schema_path as schema
run cat with path source_path
then jq with flags ["-c", "-S"] and filter "[.files|group_by(.area)[]|{area:.[0].area,files:map({id,path,role})}] | {repo:\"REPO-3\",areas:.}" as evidence
if live is true
  then llm.extract with model generator_model and instruction "Extract a concise onboarding map with repository areas, paths, and roles. Do not infer architecture beyond the provided file inventory." and schema schema and env_file env_file as raw
otherwise
  then llm.extract with model generator_model and instruction "Extract a concise onboarding map with repository areas, paths, and roles. Do not infer architecture beyond the provided file inventory." and schema schema and fixture extract_fixture_path and env_file env_file as raw
then parse json as extracted
take text at "/value/route" from extracted as route
take text at "/value/evidence_id" from extracted as evidence_id
take text at "/value/summary" from extracted as summary
run jq with flags ["-n", "-e", "--arg", "evidence", evidence, "--arg", "evidence_id", evidence_id] and filter "($evidence | contains($evidence_id))" as citation_check
if route is "draft"
  run jq with flags ["-n", "-c", "-S", "--arg", "artifact", "repository_onboarding_map", "--arg", "status", "draft-for-human-review", "--arg", "evidence", evidence, "--arg", "evidence_id", evidence_id, "--arg", "map_note", summary, "--arg", "action", "A reviewer verifies cited records before relying on this extraction."] and filter "{artifact:$artifact,status:$status,evidence_excerpt:$evidence,evidence_id:$evidence_id,map_note:$map_note,action:$action}" as report
otherwise
  run jq with flags ["-n", "-c", "-S", "--arg", "artifact", "repository_onboarding_map", "--arg", "status", "needs-human-review", "--arg", "evidence", evidence, "--arg", "evidence_id", evidence_id, "--arg", "map_note", summary, "--arg", "action", "A reviewer verifies cited records before relying on this extraction."] and filter "{artifact:$artifact,status:$status,evidence_excerpt:$evidence,evidence_id:$evidence_id,map_note:$map_note,action:$action}" as report
then save to report_path
then cat with path report_path
