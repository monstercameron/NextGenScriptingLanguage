# Purpose: Sort media records by locally computed similarity hash and metadata, then prepare a duplicate-review shortlist without deleting anything.
# Inputs: TSV inventory includes MEDIA-* IDs, perceptual hash, dimensions, duration, and file name.
# Outputs: out/075-similar-media-human-review.json: candidate groups and confirmation steps for a human reviewer.
accept live as boolean with default false
accept source_path as text with default "fixtures/075/source-high.txt"
accept report_path as text with default "out/075-similar-media-human-review.json"
accept classify_fixture_path as text with default "fixtures/075/classify-high.json"
accept draft_fixture_path as text with default "fixtures/075/draft.json"
accept generator_model as text with default "gpt-6-luna"
accept env_file as text with default ".env"
# Refuse an output path that aliases an existing evidence or schema file.
run "test" with arguments ["!", source_path, "-ef", report_path]
run cat with path source_path
then sort with flags ["-t", "\t", "-k2,2", "-k1,1"] as evidence
if live is true
  then jev.classify with question "Which sorted media rows are plausible near-duplicate review candidates based on the supplied hash and metadata?" and labels ["similar-media-group", "needs-human"] and minimum 80 and env_file env_file as class_raw
otherwise
  then jev.classify with question "Which sorted media rows are plausible near-duplicate review candidates based on the supplied hash and metadata?" and labels ["similar-media-group", "needs-human"] and minimum 80 and fixture classify_fixture_path and env_file env_file as class_raw
then parse json as classification
take text at "/label" from classification as label
take integer at "/confidence_percent" from classification as confidence
take boolean at "/accepted" from classification as accepted
if accepted is true
  if label is "similar-media-group"
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "label", label, "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "{label:$label,confidence_percent:$confidence,evidence:$evidence}"]
    if live is true
      then llm.ask with model generator_model and instruction "Group only rows with matching supplied perceptual hashes and compatible dimensions/duration. Cite MEDIA-* IDs; call these candidates, request visual/audio confirmation, and never delete or merge media." and env_file env_file as draft_raw
    otherwise
      then llm.ask with model generator_model and instruction "Group only rows with matching supplied perceptual hashes and compatible dimensions/duration. Cite MEDIA-* IDs; call these candidates, request visual/audio confirmation, and never delete or merge media." and fixture draft_fixture_path and env_file env_file as draft_raw
    then parse json as draft_result
    take text at "/text" from draft_result as draft
    run jq with flags ["-n", "-r", "--arg", "draft", draft, "--arg", "evidence", evidence] and filter "($draft | rtrimstr(\"\\n\")) as $candidate | if ($candidate | startswith(\"EVIDENCE:\")) and ([$evidence | scan(\"[A-Z][A-Z0-9]+-[A-Z0-9-]+\") | . as $id | select($candidate | contains($id))] | length > 0) then $candidate else error(\"draft must start with EVIDENCE and cite an ID present in the bounded evidence\") end" as validated_draft
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "similar_media_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "draft", validated_draft, "--arg", "action", "Human reviewer opens source media and checks context, quality, and retention before any action.", "{artifact:$artifact,status:\"draft-for-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,media_duplicate_candidates:$draft,action:$action}"]
    then save to report_path
  otherwise
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "similar_media_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "review_action", "No file is removed, renamed, or replaced.", "{artifact:$artifact,status:\"needs-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,media_duplicate_candidates:null,reason:\"Classifier selected the human-review label above the confidence threshold; no LLM draft was requested.\",action:$review_action}"]
    then save to report_path
  then cat with path report_path
otherwise
  then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "similar_media_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "review_action", "No file is removed, renamed, or replaced.", "{artifact:$artifact,status:\"needs-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,media_duplicate_candidates:null,reason:\"Classifier confidence is below the configured 80 percent threshold; no LLM draft was requested.\",action:$review_action}"]
  then save to report_path
then cat with path report_path
