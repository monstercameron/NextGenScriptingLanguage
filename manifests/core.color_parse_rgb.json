{
  "name": "color.parse_rgb",
  "description": "Parses three comma-separated decimal RGB channels and returns a validity flag with a normalized hex color, using the required fallback when the input is invalid.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "default_hex": {
      "type": "string",
      "required": true,
      "pattern": "hex_color_optional_hash",
      "description": "Six-digit hexadecimal color to return when the RGB text is absent or invalid; an optional leading # is accepted."
    },
    "text": {
      "type": "string",
      "description": "Optional comma-separated red, green, and blue decimal channels, each from 0 through 255; when omitted, the applet reads its input stream."
    }
  },
  "arguments": [
    {
      "literal": "color.parse_rgb"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "record",
      "encoding": "json",
      "fields": {
        "valid": {
          "type": "boolean"
        },
        "hex": {
          "type": "text"
        }
      },
      "required": [
        "valid",
        "hex"
      ]
    },
    "capabilities": [
      "color.convert"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "default_hex": {
          "schema": {
            "type": "text",
            "pattern": "hex_color_optional_hash"
          },
          "delivery": "single"
        },
        "text": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "record",
            "fields": {
              "valid": {
                "type": "boolean"
              },
              "hex": {
                "type": "text"
              }
            },
            "required": [
              "valid",
              "hex"
            ]
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "color parse_rgb"
  ],
  "examples": [
    {
      "program": "run color.parse_rgb with default_hex \"#ffffff\" and text \"12, 34, 56\" as color",
      "expected_output": {
        "valid": true,
        "hex": "0c2238"
      }
    }
  ]
}
