{
  "name": "json.keys",
  "description": "Returns the object member names at a JSON Pointer in deterministic sorted order.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "document": {
      "type": "json",
      "required": true,
      "description": "JSON document containing the target object; stdin is used when omitted."
    },
    "pointer": {
      "type": "string",
      "required": false,
      "description": "JSON Pointer locating the object; an empty pointer selects the root object."
    }
  },
  "arguments": [
    {
      "literal": "json.keys"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "json"
    },
    "capabilities": [
      "json.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "document": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        },
        "pointer": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "json"
          }
        }
      }
    }
  },
  "phrases": [
    "json keys"
  ],
  "examples": [
    {
      "program": "run json.keys with document {\"name\":\"Ada\",\"score\":8} as result",
      "expected_output": [
        "name",
        "score"
      ]
    }
  ]
}
