{
  "name": "fs.ensure_line",
  "description": "Adds one line to a UTF-8 text file or removes matching lines, changing the file only when its requested state is not already satisfied.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "path": {
      "type": "path",
      "required": true,
      "description": "Text file path to update; relative paths resolve from the program working directory."
    },
    "line": {
      "type": "string",
      "required": true,
      "description": "Single line of text to add or remove; carriage returns and line feeds are not allowed."
    },
    "state": {
      "type": "string",
      "enum": [
        "present",
        "absent"
      ],
      "description": "Desired line state: present to add the line if missing, or absent to remove it; omitted means present."
    }
  },
  "arguments": [
    {
      "literal": "fs.ensure_line"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "record",
      "encoding": "json",
      "fields": {
        "changed": {
          "type": "boolean"
        },
        "path": {
          "type": "text"
        }
      },
      "required": [
        "changed",
        "path"
      ]
    },
    "capabilities": [
      "filesystem.read",
      "filesystem.write",
      "filesystem.lock"
    ],
    "effects": [
      "filesystem.write",
      "filesystem.lock"
    ],
    "ports": {
      "inputs": {
        "path": {
          "schema": {
            "type": "path"
          },
          "delivery": "single"
        },
        "line": {
          "schema": {
            "type": "text",
            "single_line": true
          },
          "delivery": "single"
        },
        "state": {
          "schema": {
            "type": "text",
            "enum": [
              "present",
              "absent"
            ]
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "record",
            "fields": {
              "changed": {
                "type": "boolean"
              },
              "path": {
                "type": "text"
              }
            },
            "required": [
              "changed",
              "path"
            ]
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "fs ensure_line"
  ],
  "examples": [
    {
      "program": "run fs.ensure_line with path \"catalog-example.txt\" and line \"enabled=true\" as result",
      "expected_output": {
        "changed": true,
        "path": "catalog-example.txt"
      }
    }
  ]
}
