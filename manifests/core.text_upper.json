{
  "name": "text.upper",
  "description": "Converts text with locale-independent Unicode uppercase mappings.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "description": "Text to uppercase; omitted text is read from UTF-8 stdin."
    }
  },
  "arguments": [
    {
      "literal": "text.upper"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "json"
    },
    "capabilities": [
      "text.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "text upper",
    "uppercase text"
  ],
  "examples": [
    {
      "program": "run text.upper with text \"hello\" as value",
      "expected_output": "HELLO"
    }
  ]
}
