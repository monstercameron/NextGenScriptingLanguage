{
  "name": "jev.ask",
  "description": "Asks the configured JEV model provider the named questions and returns its structured answers with usage metadata. The env_file and fixture options read files, and live requests connect to the model endpoint.",
  "binary": "@execute-model",
  "accepts_stdin": true,
  "cacheable": false,
  "uncertain_on_failure": true,
  "parameters": {
    "questions": {
      "type": "record",
      "required": true,
      "fields": {},
      "additional_properties": {
        "type": "json"
      },
      "min_properties": 1,
      "max_properties": 32
    },
    "model": {
      "type": "string",
      "min_length": 1,
      "nonempty": true
    },
    "max_bytes": {
      "type": "integer"
    },
    "timeout_ms": {
      "type": "integer"
    },
    "env_file": {
      "type": "string"
    },
    "fixture": {
      "type": "string"
    }
  },
  "arguments": [
    {
      "literal": "ask"
    },
    {
      "literal": "--provider"
    },
    {
      "literal": "jev"
    },
    {
      "when_present": "model",
      "append": [
        {
          "literal": "--model"
        },
        {
          "parameter": "model"
        }
      ]
    },
    {
      "literal": "--questions"
    },
    {
      "json_parameter": "questions"
    },
    {
      "when_present": "max_bytes",
      "append": [
        {
          "literal": "--max-bytes"
        },
        {
          "parameter": "max_bytes"
        }
      ]
    },
    {
      "when_present": "timeout_ms",
      "append": [
        {
          "literal": "--timeout-ms"
        },
        {
          "parameter": "timeout_ms"
        }
      ]
    },
    {
      "when_present": "env_file",
      "append": [
        {
          "literal": "--env-file"
        },
        {
          "parameter": "env_file"
        }
      ]
    },
    {
      "when_present": "fixture",
      "append": [
        {
          "literal": "--fixture"
        },
        {
          "parameter": "fixture"
        }
      ]
    }
  ],
  "contract": {
    "version": 1,
    "backend": "command",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "raw"
    },
    "capabilities": [
      "process.exec",
      "filesystem.read",
      "network.connect"
    ],
    "effects": [
      "filesystem.read",
      "network.connect"
    ]
  }
}
