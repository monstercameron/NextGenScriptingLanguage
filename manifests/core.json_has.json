{
  "name": "json.has",
  "description": "Reports whether a JSON Pointer identifies a value in the document, including a value whose content is null.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "document": {
      "type": "json",
      "required": true,
      "description": "JSON value to inspect; stdin is used when omitted."
    },
    "path": {
      "type": "string",
      "required": false,
      "description": "JSON Pointer to check; an empty pointer refers to the entire document."
    }
  },
  "arguments": [
    {
      "literal": "json.has"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "boolean"
    },
    "capabilities": [
      "json.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "document": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        },
        "path": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "phrases": [
    "json has"
  ],
  "examples": [
    {
      "program": "run json.has with document {\"name\":\"Ada\"} and path \"/name\" as result",
      "expected_output": true
    }
  ]
}
