{
  "name": "time.sleep",
  "description": "Provides the time.sleep operation for controlled scripts.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "milliseconds": {
      "type": "integer",
      "required": false
    },
    "seconds": {
      "type": "json",
      "required": false
    }
  },
  "arguments": [
    {
      "literal": "time.sleep"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "boolean"
    },
    "capabilities": [
      "clock.read"
    ],
    "effects": [
      "clock.read"
    ],
    "ports": {
      "inputs": {
        "milliseconds": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "seconds": {
          "schema": {
            "type": "number"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "phrases": [
    "time sleep"
  ],
  "parameter_alternatives": [
    {
      "message": "time.sleep requires a bounded nonnegative milliseconds or seconds value",
      "any_of": [
        [
          {
            "test": "number_range",
            "parameter": "milliseconds",
            "minimum": 0,
            "maximum": 86400000
          }
        ],
        [
          {
            "test": "absent",
            "parameter": "milliseconds"
          },
          {
            "test": "number_range",
            "parameter": "seconds",
            "minimum": 0,
            "maximum": 86400
          }
        ],
        [
          {
            "test": "negative_integer",
            "parameter": "milliseconds"
          },
          {
            "test": "number_range",
            "parameter": "seconds",
            "minimum": 0,
            "maximum": 86400
          }
        ]
      ]
    }
  ]
}
