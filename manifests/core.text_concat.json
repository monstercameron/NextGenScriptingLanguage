{
  "name": "text.concat",
  "description": "Concatenates string parts in order and inserts the optional separator between adjacent parts.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "parts": {
      "type": "list",
      "items": "string",
      "required": true,
      "description": "String fragments to concatenate in order."
    },
    "separator": {
      "type": "string",
      "description": "Text inserted between parts; omitted means no separator."
    }
  },
  "arguments": [
    {
      "literal": "text.concat"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "json"
    },
    "capabilities": [
      "text.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "parts": {
          "schema": {
            "type": "list",
            "items": {
              "type": "text"
            }
          },
          "delivery": "single"
        },
        "separator": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "text concat"
  ],
  "examples": [
    {
      "program": "run text.concat with parts [\"hello\", \"world\"] and separator \" \" as value",
      "expected_output": "hello world"
    }
  ]
}
