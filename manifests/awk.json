{
  "name": "awk",
  "description": "Filters standard input with an AWK program, optionally splitting fields on the supplied delimiter.",
  "binary": "awk",
  "accepts_stdin": true,
  "parameters": {
    "delimiter": {
      "type": "string"
    },
    "program": {
      "type": "string",
      "required": true
    }
  },
  "arguments": [
    {
      "when_present": "delimiter",
      "append": [
        {
          "literal": "-F"
        },
        {
          "parameter": "delimiter"
        }
      ]
    },
    {
      "literal": "--"
    },
    {
      "parameter": "program"
    }
  ]
}
