# Purpose: Extract supplied timestamped transcript cues and draft a clip index for human review rather than cutting or sharing audio.
# Inputs: VTT-like export uses MEET-* cue IDs, timestamps, speaker labels, and transcript snippets.
# Outputs: out/072-meeting-clip-index.json: timestamped search index with context and privacy reminder.
accept live as boolean with default false
accept source_path as text with default "fixtures/072/source-high.txt"
accept report_path as text with default "out/072-meeting-clip-index.json"
accept classify_fixture_path as text with default "fixtures/072/classify-high.json"
accept draft_fixture_path as text with default "fixtures/072/draft.json"
accept generator_model as text with default "gpt-6-luna"
accept env_file as text with default ".env"
# Refuse an output path that aliases an existing evidence or schema file.
run "test" with arguments ["!", source_path, "-ef", report_path]
run cat with path source_path
then awk with program "$0 ~ /MEET-[0-9]+/ { print }"
then sort with flags ["-k1,1"] as evidence
if live is true
  then jev.classify with question "Which supplied transcript cues make useful timestamped review clips for the meeting index?" and labels ["clip-candidate", "needs-human"] and minimum 80 and env_file env_file as class_raw # execute-allow: lint.unused_binding intentional model-result capture for acceptance analysis and downstream parsing
otherwise
  then jev.classify with question "Which supplied transcript cues make useful timestamped review clips for the meeting index?" and labels ["clip-candidate", "needs-human"] and minimum 80 and fixture classify_fixture_path and env_file env_file as class_raw
then parse json as classification
take text at "/label" from classification as label
take integer at "/confidence_percent" from classification as confidence
take boolean at "/accepted" from classification as accepted
if accepted is true
  if label is "clip-candidate"
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "label", label, "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "{label:$label,confidence_percent:$confidence,evidence:$evidence}"]
    if live is true
      then llm.ask with model generator_model and instruction "Propose a small timestamped clip index using only supplied MEET-* cues. Cite IDs and exact times, preserve speaker context, and flag privacy/consent review before any excerpt is shared." and env_file env_file as draft_raw # execute-allow: lint.unused_binding intentional generated-text capture for review validation and downstream parsing
    otherwise
      then llm.ask with model generator_model and instruction "Propose a small timestamped clip index using only supplied MEET-* cues. Cite IDs and exact times, preserve speaker context, and flag privacy/consent review before any excerpt is shared." and fixture draft_fixture_path and env_file env_file as draft_raw
    then parse json as draft_result
    take text at "/text" from draft_result as draft
    run jq with flags ["-n", "-r", "--arg", "draft", draft, "--arg", "evidence", evidence] and filter "($draft | rtrimstr(\"\\n\")) as $candidate | if ($candidate | startswith(\"EVIDENCE:\")) and ([$evidence | scan(\"[A-Z][A-Z0-9]+-[A-Z0-9-]+\") | . as $id | select($candidate | contains($id))] | length > 0) then $candidate else error(\"draft must start with EVIDENCE and cite an ID present in the bounded evidence\") end" as validated_draft
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "timestamped_meeting_clip_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "draft", validated_draft, "--arg", "action", "Meeting owner approves clip boundaries and sharing permissions.", "{artifact:$artifact,status:\"draft-for-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,meeting_clip_index:$draft,action:$action}"]
    then save to report_path
  otherwise
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "timestamped_meeting_clip_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "review_action", "No recording is cut, exported, or shared.", "{artifact:$artifact,status:\"needs-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,meeting_clip_index:null,reason:\"Classifier selected the human-review label above the confidence threshold; no LLM draft was requested.\",action:$review_action}"]
    then save to report_path
  then cat with path report_path
otherwise
  then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "timestamped_meeting_clip_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "review_action", "No recording is cut, exported, or shared.", "{artifact:$artifact,status:\"needs-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,meeting_clip_index:null,reason:\"Classifier confidence is below the configured 80 percent threshold; no LLM draft was requested.\",action:$review_action}"]
  then save to report_path
then cat with path report_path
