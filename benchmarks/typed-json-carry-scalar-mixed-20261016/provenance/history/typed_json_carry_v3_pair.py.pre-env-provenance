def validate_raw_report(payload: bytes) -> dict[str, Any]:
    report = strict_json_bytes(payload, "raw benchmark report")
    expected_fields = {"schema", "method", "warmup_runs", "measured_samples", "workload", "results"}
    _expect(isinstance(report, dict) and set(report) == expected_fields, "raw report has an unexpected schema")
    _expect(report.get("schema") == "typed_json_carry_public_runtime_bench/v1", "raw report schema mismatch")
    _expect(report.get("method") == EXPECTED_METHOD, "raw report method text mismatch")
    _expect(type(report.get("warmup_runs")) is int and report["warmup_runs"] == INNER_WARMUPS, "raw report warmup count mismatch")
    _expect(type(report.get("measured_samples")) is int and report["measured_samples"] == INNER_SAMPLES, "raw report sample count mismatch")
    workload = report.get("workload")
    required_workload = {"calls", "applet", "literal_operands", "source_bytes", "source_sha256", "catalog_sha256"}
    _expect(isinstance(workload, dict) and set(workload) == required_workload, "raw workload shape mismatch")
    _expect(
        workload.get("calls") == 1000 and type(workload.get("calls")) is int
        and workload.get("applet") == "number.add"
        and isinstance(workload.get("literal_operands"), list)
        and len(workload["literal_operands"]) == 2
        and all(type(value) is int for value in workload["literal_operands"])
        and workload["literal_operands"] == [1, 2]
        and type(workload.get("source_bytes")) is int and workload["source_bytes"] == EXPECTED_SOURCE_BYTES
        and workload.get("source_sha256") == EXPECTED_SOURCE_SHA256
        and isinstance(workload.get("catalog_sha256"), str)
        and SHA256_RE.fullmatch(workload["catalog_sha256"]) is not None,
        "raw workload identity mismatch",
    )
    results = report.get("results")
    _expect(isinstance(results, dict) and set(results) == {CASE}, "raw report case set mismatch")
    case = results[CASE]
    _expect(isinstance(case, dict) and set(case) == {"p50_ns", "p95_ns", "raw_sample_ns", "semantic_oracles"}, "case report shape mismatch")
    raw = case.get("raw_sample_ns")
    _expect(isinstance(raw, list) and len(raw) == INNER_SAMPLES, "raw report must have exactly three durations")
    _expect(all(type(value) is int and 0 < value < (1 << 64) for value in raw), "raw report duration must be a positive u64")
    ordered = sorted(raw)
    _expect(type(case.get("p50_ns")) is int and case["p50_ns"] == ordered[1], "reported p50 does not match three raw samples")
    _expect(type(case.get("p95_ns")) is int and case["p95_ns"] == ordered[2], "reported p95 does not match three raw samples")
    oracles = case.get("semantic_oracles")
    _expect(isinstance(oracles, list) and len(oracles) == INNER_SAMPLES, "raw report must have one oracle per duration")
    exact_oracle = {
        "output_hex": EXPECTED_OUTPUT_HEX,
        "launched_processes": 0,
        "cache_hits": 0,
        "retained_execution_records": 256,
        "expected_retained_execution_records": 256,
        "retained_all_success_status_0": True,
        "retained_stdout_bytes_per_call": 2,
        "dropped_execution_records": 744,
        "expected_dropped_execution_records": 744,
        "dropped_stages": 744,
    }
    for index, oracle in enumerate(oracles):
        _expect(isinstance(oracle, dict) and set(oracle) == set(exact_oracle), f"semantic oracle {index} shape mismatch")
        _expect(
            all(type(oracle[key]) is type(value) and oracle[key] == value for key, value in exact_oracle.items()),
            f"semantic oracle {index} does not match exact output/call/status/cache/record oracle",
        )
    return {
        "workload": workload,
        "raw_sample_ns": raw,
        "median_duration_ns": ordered[1],
        "semantic_oracles": oracles,
    }


def _normalize_output(value: bytes | str | None) -> bytes:
    if value is None:
        return b""
    return value.encode("utf-8", errors="replace") if isinstance(value, str) else value


def run_attempt(
    identity: Mapping[str, Any],
    attempt_dir: Path,
    metadata: Mapping[str, Any],
) -> dict[str, Any]:
    attempt_dir.mkdir(parents=True, exist_ok=False)
    raw_path = attempt_dir / "raw.json"
    _expect(raw_path.is_absolute(), "raw report path must be absolute")
    _expect(not raw_path.exists() and not raw_path.is_symlink(), "refusing existing raw report path")
    binary = Path(identity["opt_test_binary"]["binary"])
    helper = Path(identity["helper"]["binary"])
    expected_binary_hash = identity["opt_test_binary"]["binary_sha256"]
    expected_helper_hash = identity["helper"]["binary_sha256"]
    binary_before = sha_file(binary) if binary.is_file() else None
    helper_before = sha_file(helper) if helper.is_file() else None
    _expect(binary_before == expected_binary_hash and os.access(binary, os.X_OK), "saved test binary hash/execute check failed before call")
    _expect(helper_before == expected_helper_hash and os.access(helper, os.X_OK), "saved sibling helper hash/execute check failed before call")
    command = [str(binary), "--exact", TEST_NAME, "--ignored", "--nocapture", "--test-threads=1"]
    environment = os.environ.copy()
    environment.update({"OPT_BENCH_REPORT": str(raw_path), "LC_ALL": "C", "TZ": "UTC"})
    started = {
        **dict(metadata),
        "started_at": utc_now(),
        "command": command,
        "cwd": identity["root"],
        "timeout_seconds": INVOCATION_TIMEOUT_SECONDS,
        "binary_sha256_before": binary_before,
        "helper_sha256_before": helper_before,
        "raw_report_path": str(raw_path),
        "environment": {"OPT_BENCH_REPORT": str(raw_path), "LC_ALL": "C", "TZ": "UTC"},
        "retry": 0,
    }
    write_json(attempt_dir / "started.json", started, exclusive=True)
    returncode: int | None = None
    timed_out = False
    execution_error: str | None = None
    stdout = b""
    stderr = b""
    start = time.monotonic_ns()
    try:
        completed = subprocess.run(
            command,
            cwd=identity["root"],
            env=environment,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=INVOCATION_TIMEOUT_SECONDS,
            check=False,
        )
        returncode = completed.returncode
        stdout, stderr = completed.stdout, completed.stderr
    except subprocess.TimeoutExpired as exception:
        timed_out = True
        stdout = _normalize_output(exception.stdout)
        stderr = _normalize_output(exception.stderr)
    except OSError as exception:
        execution_error = f"{type(exception).__name__}: {exception}"
        stderr = execution_error.encode("utf-8", errors="replace")
    wall_ns = time.monotonic_ns() - start
    binary_after = sha_file(binary) if binary.is_file() else None
    helper_after = sha_file(helper) if helper.is_file() else None
    if binary_after != expected_binary_hash:
        execution_error = "saved benchmark binary changed during invocation"
    if helper_after != expected_helper_hash:
        execution_error = "saved sibling helper changed during invocation"
    write_bytes_new(attempt_dir / "stdout.bin", stdout)
    write_bytes_new(attempt_dir / "stderr.bin", stderr)
    raw_present = raw_path.is_file() and not raw_path.is_symlink()
    raw_bytes = raw_path.read_bytes() if raw_present else None
    raw_hash = sha_bytes(raw_bytes) if raw_bytes is not None else None
    parsed: dict[str, Any] | None = None
    validation_error: str | None = None
    if raw_bytes is None:
        validation_error = "test binary did not create a regular raw report"
    else:
        try:
            parsed = validate_raw_report(raw_bytes)
        except PairError as error:
            validation_error = str(error)
    success = returncode == 0 and not timed_out and execution_error is None and validation_error is None
    result = {
        **dict(metadata),
        "finished_at": utc_now(),
        "returncode": returncode,
        "timed_out": timed_out,
        "execution_error": execution_error,
        "wall_elapsed_ns": wall_ns,
        "binary_sha256_before": binary_before,
        "binary_sha256_after": binary_after,
        "helper_sha256_before": helper_before,
        "helper_sha256_after": helper_after,
        "raw_report_present": raw_present,
        "raw_report_sha256": raw_hash,
        "raw_report_path": str(raw_path.resolve()),
        "raw_validation_error": validation_error,
        "successful": success,
        "workload": parsed["workload"] if parsed else None,
        "raw_sample_ns": parsed["raw_sample_ns"] if parsed else None,
        "median_duration_ns": parsed["median_duration_ns"] if parsed else None,
        "semantic_oracles": parsed["semantic_oracles"] if parsed else None,
        "stdout_sha256": sha_bytes(stdout),
        "stderr_sha256": sha_bytes(stderr),
        "stdout_path": str((attempt_dir / "stdout.bin").resolve()),
        "stderr_path": str((attempt_dir / "stderr.bin").resolve()),
        "attempt_dir": str(attempt_dir.resolve()),
        "retry": 0,
    }
    write_json(attempt_dir / "finished.json", result, exclusive=True)
    return result


def workload_compatible(workloads: Sequence[Mapping[str, Any]]) -> bool:
    if not workloads:
        return False
    first = dict(workloads[0])
    return all(dict(value) == first for value in workloads[1:])


def pair_result(global_pair_index: int, phase: str, phase_index: int, order: Sequence[str], attempts: Mapping[str, Mapping[str, Any]]) -> dict[str, Any]:
    baseline = attempts["baseline"]
    candidate = attempts["candidate"]
    same_workload = (
        baseline.get("successful") is True
        and candidate.get("successful") is True
        and baseline.get("workload") == candidate.get("workload")
    )
    valid = same_workload
    result: dict[str, Any] = {
        "pair_index": phase_index,
        "global_pair_index": global_pair_index,
        "phase": phase,
        "order": list(order),
        "valid_for_timing": valid,
        "same_catalog_and_workload": same_workload,
    }
    if valid:
        base_ns = baseline["median_duration_ns"]
        candidate_ns = candidate["median_duration_ns"]
        result.update({
            "baseline_median_ns": base_ns,
            "candidate_median_ns": candidate_ns,
            "candidate_minus_baseline_ns": candidate_ns - base_ns,
        })
    else:
        result["failure_reasons"] = {
            "baseline_successful": baseline.get("successful") is True,
            "candidate_successful": candidate.get("successful") is True,
            "workloads_equal": baseline.get("workload") == candidate.get("workload"),
        }
    return result


def summarize(pairs: Sequence[Mapping[str, Any]]) -> dict[str, Any]:
    deltas = [item["candidate_minus_baseline_ns"] for item in pairs if item.get("valid_for_timing") is True]
    return {
        "valid_pair_count": len(deltas),
        "paired_candidate_minus_baseline_ns": deltas,
        "median_paired_candidate_minus_baseline_ns": statistics.median(deltas) if deltas else None,
        "candidate_improvements": sum(delta < 0 for delta in deltas),
        "candidate_losses": sum(delta > 0 for delta in deltas),
        "ties": sum(delta == 0 for delta in deltas),
        "interpretation": "descriptive same-host public-runtime microbenchmark; no confidence interval or general speedup claim",
    }


def run(args: argparse.Namespace) -> int:
    prereg_path = Path(args.preregistration).expanduser().resolve(strict=True)
    prereg = verify_preregistration(prereg_path)
    prereg_sha = sha_file(prereg_path)
    report_dir = Path(args.report_dir).expanduser().absolute()
    _expect(not report_dir.exists() and not report_dir.is_symlink(), f"refusing to overwrite output directory: {report_dir}")
    report_dir.mkdir(parents=True, exist_ok=False)
    report_path = report_dir / "paired-report.json"
    report: dict[str, Any] = {
        "schema": "typed-json-carry-paired-report/1",
        "created_at": utc_now(),
        "status": "running",
        "preregistration_path": str(prereg_path),
        "preregistration_sha256": prereg_sha,
        "runner": prereg["runner"],
        "protocol": prereg["protocol"],
        "workload_contract": prereg["workload"],
        "inputs": prereg["inputs"],
        "host": {"system": platform.system(), "release": platform.release(), "machine": platform.machine(), "python": sys.version},
        "attempts": [],
        "warmup_pairs": [],
        "measured_pairs": [],
    }
    write_json(report_path, report, exclusive=True)
    overall_failed = False
    workload_seen: dict[str, Any] | None = None
    global_count = WARMUP_PAIRS + MEASURED_PAIRS
    for global_pair in range(global_count):
        phase = "warmup" if global_pair < WARMUP_PAIRS else "measurement"
        phase_index = global_pair + 1 if phase == "warmup" else global_pair - WARMUP_PAIRS + 1
        order = interleaved_order(global_pair)
        pair_attempts: dict[str, dict[str, Any]] = {}
        for position, side in enumerate(order, start=1):
            identity = prereg["inputs"][side]
            attempt_id = f"{phase}-{phase_index:02d}-{position}-{side}"
            metadata = {
                "attempt_id": attempt_id,
                "phase": phase,
                "phase_pair_index": phase_index,
                "global_pair_index": global_pair,
                "position_in_pair": position,
                "side": side,
                "source_fingerprint_sha256": identity["source_fingerprint"]["sha256"],
                "build_receipt_sha256": identity["receipt_sha256"],
                "binary_sha256": identity["opt_test_binary"]["binary_sha256"],
                "helper_sha256": identity["helper"]["binary_sha256"],
            }
            try:
                result = run_attempt(identity, report_dir / "attempts" / attempt_id, metadata)
            except (PairError, OSError, KeyError, TypeError, ValueError) as error:
                result = {
                    **metadata,
                    "finished_at": utc_now(),
                    "successful": False,
                    "execution_error": f"{type(error).__name__}: {error}",
                    "returncode": None,
                    "timed_out": False,
                    "retry": 0,
                    "attempt_dir": str((report_dir / "attempts" / attempt_id).resolve()),
                }
                overall_failed = True
            report["attempts"].append(result)
            pair_attempts[side] = result
            if result.get("successful") is not True:
                overall_failed = True
            if result.get("successful") is True:
                current_workload = result["workload"]
                if workload_seen is None:
                    workload_seen = current_workload
                elif current_workload != workload_seen:
                    result["successful"] = False
                    result["cross_arm_catalog_workload_mismatch"] = True
                    overall_failed = True
            write_json(report_path, report)
        pair = pair_result(global_pair, phase, phase_index, order, pair_attempts)
        if not pair["valid_for_timing"]:
            overall_failed = True
        target_list = report["warmup_pairs"] if phase == "warmup" else report["measured_pairs"]
        target_list.append(pair)
        write_json(report_path, report)
    post: dict[str, Any] = {}
    try:
        meta_after, arms_after = load_build_provenance()
        post["provenance_stable"] = meta_after == prereg["provenance"] and arms_after == prereg["inputs"]
        post["source_bindings_sha256"] = meta_after["source_bindings_sha256"]
        post["arms"] = {
            side: {
                "source_fingerprint_sha256": arms_after[side]["source_fingerprint"]["sha256"],
                "build_receipt_sha256": arms_after[side]["receipt_sha256"],
                "binary_sha256": arms_after[side]["opt_test_binary"]["binary_sha256"],
                "helper_sha256": arms_after[side]["helper"]["binary_sha256"],
            } for side in ("baseline", "candidate")
        }
        overall_failed |= not post["provenance_stable"]
    except (PairError, OSError, KeyError, TypeError, ValueError) as error:
        post["provenance_stable"] = False
        post["error"] = str(error)
        overall_failed = True
    prereg_stable = sha_file(prereg_path) == prereg_sha
    runner_path = Path(prereg["runner"]["path"])
    runner_stable = runner_path.is_file() and sha_file(runner_path) == prereg["runner"]["sha256"]
    post["preregistration_stable"] = prereg_stable
    post["runner_stable"] = runner_stable
    report["post_run_identity"] = post
    report["paired_summary"] = summarize(report["measured_pairs"])
    report["completed_at"] = utc_now()
    report["attempt_count"] = len(report["attempts"])
    report["successful_attempt_count"] = sum(item.get("successful") is True for item in report["attempts"])
    report["failed_attempt_count"] = report["attempt_count"] - report["successful_attempt_count"]
    complete_schedule = (
        report["attempt_count"] == 2 * global_count
        and len(report["warmup_pairs"]) == WARMUP_PAIRS
        and len(report["measured_pairs"]) == MEASURED_PAIRS
    )
    report["status"] = "complete" if complete_schedule and not overall_failed and runner_stable and prereg_stable else "failed"
    write_json(report_path, report)
    print(json.dumps({"report": str(report_path), "status": report["status"]}, sort_keys=True))
    return 0 if report["status"] == "complete" else 1


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    prepare_command = commands.add_parser("prepare", help="validate build receipts and freeze a fresh paired preregistration")
    prepare_command.add_argument("--preregistration", required=True)
    prepare_command.set_defaults(function=prepare)
    run_command = commands.add_parser("run", help="run exactly 3 warmup and 48 measured AB/BA pairs")
    run_command.add_argument("--preregistration", required=True)
    run_command.add_argument("--report-dir", required=True)
    run_command.set_defaults(function=run)
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return int(args.function(args) or 0)
    except (PairError, OSError, KeyError, TypeError, ValueError) as error:
        print(f"typed-JSON carry paired benchmark: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
