{
  "name": "json.length",
  "description": "Returns the item count of an array or object, or the Unicode character count of a string selected by JSON Pointer.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "document": {
      "type": "json",
      "required": true,
      "description": "JSON value containing the target array, object, or string; stdin is used when omitted."
    },
    "pointer": {
      "type": "string",
      "required": false,
      "description": "JSON Pointer locating the value to count; an empty pointer selects the root value."
    }
  },
  "arguments": [
    {
      "literal": "json.length"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "integer"
    },
    "capabilities": [
      "json.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "document": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        },
        "pointer": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "integer"
          }
        }
      }
    }
  },
  "phrases": [
    "json length"
  ],
  "examples": [
    {
      "program": "run json.length with document [\"Ada\",\"Lin\"] as result",
      "expected_output": 2
    }
  ]
}
