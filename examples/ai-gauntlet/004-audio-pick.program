# Purpose: Choose an audio device from a fuzzy description.
# Inputs: source_path, fixture paths, live=false.
# Outputs: out/004.json; candidate only; model text is never command code.
# Bash would need: device-specific aliases, regex, and a manual review branch.
accept source_path as text with default "fixtures/004/source.json"
accept fixture as text with default "fixtures/004/confident.json"
accept live as boolean with default false
try
  read source_path
  if live is true
    then jev.classify with question "Choose the supplied audio device ID matching the request; unknown if unclear." and labels ["headset","speakers","unknown"] and minimum 80 and timeout_ms 3000 and max_bytes 65536 as raw
  otherwise
    then jev.classify with question "Choose the supplied audio device ID matching the request; unknown if unclear." and labels ["headset","speakers","unknown"] and minimum 80 and timeout_ms 3000 and max_bytes 65536 and fixture fixture as raw
  then parse json as verdict
  take boolean at "/accepted" from verdict as accepted
  take integer at "/confidence_percent" from verdict as confidence
  take text at "/label" from verdict as label
  if accepted is true
    if label is "headset"
      run json.set with document {"action":"Review against the original input before acting.","result":null,"status":"candidate-for-review"} and pointer "/result" and value "headset"
    otherwise
      run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
  otherwise
    run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
catch failure
  run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
then save to "out/004.json"
