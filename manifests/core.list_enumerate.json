{
  "name": "list.enumerate",
  "description": "Pair each input value with its zero-based position in the original list.",
  "phrases": [
    "list enumerate",
    "items enumerate"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "items": {
      "type": "json",
      "required": true,
      "description": "JSON list to enumerate; each result contains an index and its corresponding item."
    }
  },
  "arguments": [
    {
      "literal": "list.enumerate"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "list",
      "items": {
        "type": "json"
      }
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "items": {
          "delivery": "single",
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "items": {
              "type": "json"
            },
            "type": "list"
          }
        }
      }
    },
    "capabilities": [
      "data.transform"
    ]
  },
  "examples": [
    {
      "program": "run list.enumerate with items [\"red\", \"blue\"] as result",
      "expected_output": [
        {
          "index": 0,
          "item": "red"
        },
        {
          "index": 1,
          "item": "blue"
        }
      ]
    }
  ]
}
