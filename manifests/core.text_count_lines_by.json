{
  "name": "text.count_lines_by",
  "description": "Groups UTF-8 input lines by the selected zero-based, delimiter-separated field and returns an array of {key, count} records in first-seen key order.",
  "phrases": [
    "count lines by field",
    "group lines by key"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "delimiter": {
      "type": "string",
      "required": true,
      "description": "Nonempty literal field separator used to split each input line."
    },
    "field": {
      "type": "integer",
      "description": "Zero-based field index used as the grouping key; defaults to 0."
    }
  },
  "parameter_alternatives": [
    {
      "message": "field must be an integer from 0 through 16777216",
      "any_of": [
        [
          {
            "test": "absent",
            "parameter": "field"
          }
        ],
        [
          {
            "test": "number_range",
            "parameter": "field",
            "minimum": 0,
            "maximum": 16777216
          }
        ]
      ]
    },
    {
      "message": "text.count_lines_by delimiter must be nonempty",
      "any_of": [
        [
          {
            "test": "nonempty",
            "parameter": "delimiter"
          }
        ]
      ]
    }
  ],
  "arguments": [
    {
      "literal": "text.count_lines_by"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "list",
      "encoding": "json",
      "items": {
        "type": "json"
      }
    },
    "capabilities": [
      "data.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "delimiter": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "field": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          },
          "delivery": "single"
        }
      }
    }
  },
  "examples": [
    {
      "program": "use value \"a,red\\nb,blue\\nc,red\"\npipe to text.count_lines_by with delimiter \",\" and field 1 as value",
      "expected_output": [
        {
          "key": "red",
          "count": 2
        },
        {
          "key": "blue",
          "count": 1
        }
      ]
    }
  ]
}
