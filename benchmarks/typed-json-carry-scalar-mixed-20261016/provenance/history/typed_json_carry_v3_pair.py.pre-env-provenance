def source_map_pair_validation(baseline: Mapping[str, Any], candidate: Mapping[str, Any]) -> set[str]:
    base_fp = baseline.get("source_fingerprint")
    cand_fp = candidate.get("source_fingerprint")
    _expect(isinstance(base_fp, dict) and isinstance(cand_fp, dict), "paired source fingerprints missing")
    base_files = base_fp.get("files")
    cand_files = cand_fp.get("files")
    _expect(isinstance(base_files, dict) and isinstance(cand_files, dict), "paired source file maps missing")
    _expect(base_files.keys() == cand_files.keys(), "paired source roots have different 2,197-file paths")
    changed = {path for path in base_files if base_files[path] != cand_files[path]}
    expected = {
        "src/contracts.rs",
        "src/manifest.rs",
        "src/runtime.rs",
        "src/runtime/program_backend.rs",
        "src/runtime/windows_process.rs",
        "tests/typed_contracts.rs",
    }
    _expect(changed == expected, f"paired source differences do not equal the frozen product patch: {sorted(changed)}")
    _expect(baseline.get("root") != candidate.get("root"), "paired source roots are not distinct")
    _expect(baseline.get("opt_test_binary", {}).get("binary") != candidate.get("opt_test_binary", {}).get("binary"), "paired benchmark binary paths are not distinct")
    _expect(baseline.get("opt_test_binary", {}).get("binary_sha256") != candidate.get("opt_test_binary", {}).get("binary_sha256"), "paired benchmark binaries are byte-identical")
    for key in ("harness_source_sha256", "harness_patch_sha256", "product_patch_sha256"):
        _expect(baseline.get(key) == candidate.get(key), f"paired arms differ in {key}")
    return changed


def _live_arm(side: str, frozen: Mapping[str, Any]) -> dict[str, Any]:
    root = Path(frozen["root"]).resolve(strict=True)
    _expect(root == (BASELINE_ROOT if side == "baseline" else CANDIDATE_ROOT).resolve(strict=True), f"{side} root is not the registered checkout")
    _expect(git(root, "rev-parse", "HEAD").decode().strip() == BASE_COMMIT, f"{side} HEAD differs from the frozen base")
    live_fp = source_fingerprint(root)
    expected_fp = frozen["tree"]
    _expect(live_fp == expected_fp, f"{side} live full-source fingerprint differs from the frozen 2,197-file map")
    _expect(diff_sha256(root) == frozen["tracked_diff_sha256"], f"{side} tracked diff changed")
    _expect(diff_sha256(root, staged=True) == frozen["staged_diff_sha256"], f"{side} staged diff changed")
    _expect(live_fp["files"].get(HARNESS_RELATIVE) == EXPECTED_HARNESS_SHA256, f"{side} formatted harness hash mismatch")
    receipt_path = BUILD_RUN / side / "build-receipt.json"
    receipt = load_json(receipt_path, f"{side} build receipt")
    _expect(receipt.get("status") == "success" and receipt.get("source_stable") is True, f"{side} build did not attest to a stable successful source")
    _expect(receipt.get("tests_executed") is False, f"{side} build receipt says tests ran during preparation")
    _expect(receipt.get("side") == side and receipt.get("worktree") == str(root), f"{side} build worktree metadata mismatch")
    _expect(receipt.get("head") == BASE_COMMIT, f"{side} build receipt HEAD mismatch")
    _expect(receipt.get("clean") == CLEAN_ARGS and receipt.get("build") == BUILD_ARGS, f"{side} clean/build command differs from the frozen plan")
    _expect(receipt.get("helper_build") == HELPER_BUILD_ARGS, f"{side} helper build command differs from the frozen plan")
    _expect(receipt.get("target_directory") == str(TARGET.resolve()), f"{side} build target directory mismatch")
    _expect(receipt.get("expected_artifacts") == {name: str(source) for name, source in BUILD_TARGETS.items()}, f"{side} expected artifact targets mismatch")
    _expect(receipt.get("source_fingerprint_sha256") == live_fp["sha256"], f"{side} build source fingerprint mismatch")
    _expect(receipt.get("source_fingerprint_after") == {"sha256": live_fp["sha256"], "file_count": live_fp["file_count"]}, f"{side} postbuild fingerprint mismatch")
    _expect(receipt.get("tracked_diff_sha256") == frozen["tracked_diff_sha256"], f"{side} receipt tracked diff mismatch")
    _expect(receipt.get("staged_diff_sha256") == frozen["staged_diff_sha256"], f"{side} receipt staged diff mismatch")
    _expect(receipt.get("build_driver_sha256") == BUILD_DRIVER_SHA256, f"{side} build driver digest mismatch")
    _expect(receipt.get("product_patch_sha256") == PRODUCT_PATCH_SHA256, f"{side} product patch digest mismatch")
    _expect(receipt.get("harness_patch_sha256") == HARNESS_PATCH_SHA256, f"{side} harness patch digest mismatch")
    _expect(receipt.get("harness_source_sha256") == EXPECTED_HARNESS_SHA256, f"{side} harness source digest mismatch")
    _expect(receipt.get("clean_return_code") == 0 and receipt.get("build_return_code") == 0 and receipt.get("helper_build_return_code") == 0, f"{side} build receipts contain a failed command")
    log_bindings = {
        "clean_log": (BUILD_RUN / side / "clean.log", "clean_log_sha256"),
        "clean_stderr_log": (BUILD_RUN / side / "clean.stderr.log", "clean_stderr_sha256"),
        "build_stdout_jsonl": (BUILD_RUN / side / "build.jsonl", "build_stdout_sha256"),
        "build_stderr_log": (BUILD_RUN / side / "build.stderr.log", "build_stderr_sha256"),
        "helper_build_stdout_jsonl": (BUILD_RUN / side / "helper-build.jsonl", "helper_build_stdout_sha256"),
        "helper_build_stderr_log": (BUILD_RUN / side / "helper-build.stderr.log", "helper_build_stderr_sha256"),
    }
    for path_field, (expected_path, hash_field) in log_bindings.items():
        logged_path = Path(receipt.get(path_field, "")).resolve(strict=True)
        _expect(logged_path == expected_path.resolve(strict=True), f"{side} {path_field} path mismatch")
        _expect(sha_file(logged_path) == receipt.get(hash_field), f"{side} {path_field} digest mismatch")
    identities = {
        name: _artifact_identity(side, name, receipt, root)
        for name in ARTIFACT_NAMES
    }
    helper = _helper_identity(side, receipt, root)
    _expect(Path(helper["binary"]).parent == Path(identities["opt_typed_json_carry"]["binary"]).parent, f"{side} helper is not beside the benchmark test binary")
    listings = {name: _test_list_identity(side, name, receipt) for name in ARTIFACT_NAMES}
    return {
        "side": side,
        "root": str(root),
        "head": BASE_COMMIT,
        "source_fingerprint": live_fp,
        "tracked_diff_sha256": frozen["tracked_diff_sha256"],
        "staged_diff_sha256": frozen["staged_diff_sha256"],
        "product_patch_sha256": PRODUCT_PATCH_SHA256,
        "harness_patch_sha256": HARNESS_PATCH_SHA256,
        "harness_source_sha256": EXPECTED_HARNESS_SHA256,
        "receipt": str(receipt_path.resolve(strict=True)),
        "receipt_sha256": sha_file(receipt_path),
        "artifacts": identities,
        "opt_test_binary": identities["opt_typed_json_carry"],
        "helper": helper,
        "test_lists": listings,
    }


def load_build_provenance() -> tuple[dict[str, Any], dict[str, Any]]:
