{
  "name": "number.min",
  "description": "Provides number.min for controlled scripts.",
  "phrases": [
    "number min",
    "values min"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "values": {
      "type": "list",
      "items": "number",
      "required": true,
      "min_items": 1
    }
  },
  "arguments": [
    {
      "literal": "number.min"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "number"
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "values": {
          "delivery": "single",
          "schema": {
            "type": "list",
            "items": {
              "type": "number"
            },
            "min_items": 1
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "number"
          }
        }
      }
    },
    "capabilities": [
      "number.compute"
    ]
  }
}
