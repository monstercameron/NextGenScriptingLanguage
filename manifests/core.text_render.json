{
  "name": "text.render",
  "description": "Render a text template by substituting named values.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "template": {
      "type": "string"
    },
    "template_path": {
      "type": "path"
    },
    "values": {
      "type": "record",
      "required": true,
      "fields": {},
      "additional_properties": {
        "type": "scalar"
      }
    }
  },
  "arguments": [
    {
      "literal": "text.render"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "json"
    },
    "capabilities": [
      "text.transform",
      "filesystem.read"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "template": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "template_path": {
          "schema": {
            "type": "path"
          },
          "delivery": "single"
        },
        "values": {
          "schema": {
            "type": "record",
            "fields": {},
            "additionalProperties": {
              "type": "json",
              "scalar_only": true
            }
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "text render",
    "render template",
    "fill template"
  ],
  "parameter_alternatives": [
    {
      "message": "text.render requires exactly one of template or template_path",
      "any_of": [
        [
          {
            "test": "present",
            "parameter": "template"
          },
          {
            "test": "absent",
            "parameter": "template_path"
          }
        ],
        [
          {
            "test": "absent",
            "parameter": "template"
          },
          {
            "test": "nonempty",
            "parameter": "template_path"
          }
        ]
      ]
    }
  ]
}
