{
  "name": "encode.base64",
  "description": "Encodes text or input-stream bytes as RFC 4648 base64, with optional URL-safe alphabet and padding control.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "required": false,
      "description": "Optional text to encode; when omitted, the applet encodes bytes from its input stream."
    },
    "url_safe": {
      "type": "boolean",
      "description": "Set true to replace + and / with the URL-safe - and _ characters; omitted means the standard alphabet."
    },
    "padding": {
      "type": "boolean",
      "description": "Set false to remove trailing = padding; omitted means include padding."
    }
  },
  "arguments": [
    {
      "literal": "encode.base64"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "text"
    },
    "capabilities": [
      "text.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "url_safe": {
          "schema": {
            "type": "boolean"
          },
          "delivery": "single"
        },
        "padding": {
          "schema": {
            "type": "boolean"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        }
      }
    }
  },
  "phrases": [
    "encode base64"
  ],
  "examples": [
    {
      "program": "run encode.base64 with text \"f\" and padding false as encoded",
      "expected_output": "Zg"
    }
  ]
}
