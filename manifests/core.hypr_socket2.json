      "type": "string",
      "required": true
    }
  },
  "arguments": [
    {
      "literal": "-U"
    },
    {
      "literal": "-"
    },
    {
      "parameter": "address"
    }
  ],
  "contract": {
    "version": 1,
    "backend": "command",
    "lifecycle": {
