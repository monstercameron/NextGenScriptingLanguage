# Purpose: Turn a failing-test bundle into a reproduction plan; prepare bounded evidence and save a review-only model-assisted report.
# Inputs: local source.json evidence, explicit model fixtures, and a private empty environment file.
# Outputs: out/test-reproduction.json; the workflow never changes the source evidence.
accept source_path as text with default "fixtures/011/source.json"
accept report_path as text with default "out/test-reproduction.json"
accept classify_fixture_path as text with default "fixtures/011/classify-evidence-ready.json"
accept draft_fixture_path as text with default "fixtures/011/draft.json"
accept generator_model as text with default "gpt-6-luna"
accept env_file as text with default ".env"
accept live as boolean with default false
# Refuse an output path that aliases an existing evidence or schema file.
run "test" with arguments ["!", source_path, "-ef", report_path]
run cat with path source_path
then jq with flags ["-c", "-S"] and filter "{bundle,failures:[.failures[]|{id,test,seed,error}]}" as evidence
if live is true
  then jev.classify with question "Do the recorded failures share enough exact test and error evidence to propose one reproduction sequence?" and labels ["evidence-ready", "insufficient-evidence"] and minimum 80 and env_file env_file as raw # execute-allow: lint.unused_binding intentional model-result capture for acceptance analysis and downstream parsing
otherwise
  then jev.classify with question "Do the recorded failures share enough exact test and error evidence to propose one reproduction sequence?" and labels ["evidence-ready", "insufficient-evidence"] and minimum 80 and fixture classify_fixture_path and env_file env_file as raw
then parse json as decision
take text at "/label" from decision as label
take boolean at "/accepted" from decision as accepted
take integer at "/confidence_percent" from decision as confidence
if accepted is true
  if label is "evidence-ready"
    run cat with path source_path
    then jq with flags ["-c", "-S"] and filter "{bundle,failures:[.failures[]|{id,test,seed,error}]}"
    if live is true
      then llm.ask with model generator_model and instruction "Prepare a reproduction plan for TEST-B-5 from the recorded test names, seeds and errors. Do not claim the failure has been reproduced." and env_file env_file as draft_raw # execute-allow: lint.unused_binding intentional generated-text capture for review validation and downstream parsing
    otherwise
      then llm.ask with model generator_model and instruction "Prepare a reproduction plan for TEST-B-5 from the recorded test names, seeds and errors. Do not claim the failure has been reproduced." and fixture draft_fixture_path and env_file env_file as draft_raw
    then parse json as generated
    take text at "/text" from generated as draft
    run jq with flags ["-n", "-r", "-j", "--arg", "draft", draft, "--arg", "evidence", evidence] and filter "if ($draft | startswith(\"EVIDENCE:\")) and ([$evidence | scan(\"[A-Z][A-Z0-9]+-[A-Z0-9-]+\") | . as $id | select($draft | contains($id))] | length > 0) then $draft else error(\"draft must start with EVIDENCE and cite an ID in bounded local evidence\") end" as validated_draft
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "test_reproduction_plan", "--arg", "status", "draft-for-human-review", "--arg", "classification", label, "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "--arg", "reproduction_plan", validated_draft, "--arg", "action", "A human owner reviews this proposed analysis before acting.", "{artifact:$artifact,status:$status,confidence_percent:$confidence,evidence_excerpt:$evidence,reproduction_plan:$reproduction_plan,action:$action,classification:$classification}"]
    then save to report_path
  otherwise
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "test_reproduction_plan", "--arg", "status", "needs-human-review", "--arg", "classification", label, "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "--arg", "reason", "The accepted result did not match this workflow’s positive label, decision, or score level; generated analysis was withheld.", "--arg", "action", "An owner checks the original records and decides the next step.", "{artifact:$artifact,status:$status,confidence_percent:$confidence,evidence_excerpt:$evidence,reproduction_plan:null,reason:$reason,action:$action,classification:$classification}"]
    then save to report_path
otherwise
  then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "test_reproduction_plan", "--arg", "status", "needs-human-review", "--arg", "classification", label, "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "--arg", "reason", "The model signal is below the configured 80 percent floor; no generated analysis was requested.", "--arg", "action", "An owner checks the original records and decides the next step.", "{artifact:$artifact,status:$status,confidence_percent:$confidence,evidence_excerpt:$evidence,reproduction_plan:null,reason:$reason,action:$action,classification:$classification}"]
  then save to report_path
then cat with path report_path
