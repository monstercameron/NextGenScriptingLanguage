{
  "name": "yaml.stringify",
  "description": "Serializes JSON-compatible values as two-space-indented YAML and quotes strings that would otherwise parse as another value.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "value": {
      "type": "json",
      "required": true,
      "description": "JSON-compatible value to serialize; object keys are written in sorted order."
    }
  },
  "arguments": [
    {
      "literal": "yaml.stringify"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "json"
    },
    "capabilities": [
      "text.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "value": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "yaml stringify"
  ],
  "examples": [
    {
      "program": "run yaml.stringify with value {\"name\": \"Ada\"} as value",
      "expected_output": "name: Ada\n"
    }
  ]
}
