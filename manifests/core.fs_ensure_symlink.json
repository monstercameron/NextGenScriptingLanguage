{
  "name": "fs.ensure_symlink",
  "description": "Creates a symbolic link or atomically retargets an existing link, refusing to replace a regular file or directory.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "path": {
      "type": "path",
      "required": true,
      "description": "Symbolic-link path to create or update; relative paths resolve from the program working directory."
    },
    "target": {
      "type": "path",
      "required": true,
      "description": "Nonempty target path to store in the link; relative targets are interpreted by the filesystem from the link location."
    }
  },
  "arguments": [
    {
      "literal": "fs.ensure_symlink"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "record",
      "encoding": "json",
      "fields": {
        "changed": {
          "type": "boolean"
        },
        "path": {
          "type": "text"
        },
        "target": {
          "type": "text"
        },
        "previous": {
          "type": "text"
        }
      },
      "required": [
        "changed",
        "path",
        "target",
        "previous"
      ]
    },
    "capabilities": [
      "filesystem.read",
      "filesystem.write"
    ],
    "effects": [
      "filesystem.write"
    ],
    "ports": {
      "inputs": {
        "path": {
          "schema": {
            "type": "path"
          },
          "delivery": "single"
        },
        "target": {
          "schema": {
            "type": "path"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "record",
            "fields": {
              "changed": {
                "type": "boolean"
              },
              "path": {
                "type": "text"
              },
              "target": {
                "type": "text"
              },
              "previous": {
                "type": "text"
              }
            },
            "required": [
              "changed",
              "path",
              "target",
              "previous"
            ]
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "fs ensure_symlink"
  ],
  "examples": [
    {
      "program": "run fs.ensure_symlink with path \"catalog-example-link\" and target \"catalog-example-target\" as result",
      "expected_output": {
        "changed": true,
        "path": "catalog-example-link",
        "target": "catalog-example-target",
        "previous": ""
      }
    }
  ]
}
