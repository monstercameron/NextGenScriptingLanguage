{
  "name": "text.substring",
  "description": "Returns a bounded slice starting at a character or byte index; negative starts count backward from the end, and byte indexes must land on UTF-8 boundaries.",
  "phrases": [
    "take text substring"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "description": "Text to slice; omitted text is read from UTF-8 stdin."
    },
    "start": {
      "type": "integer",
      "required": true,
      "description": "Zero-based starting index; a negative value counts backward from the end."
    },
    "length": {
      "type": "integer",
      "required": true,
      "description": "Nonnegative number of characters or bytes to return."
    },
    "unit": {
      "type": "string",
      "enum": [
        "chars",
        "bytes"
      ],
      "description": "Indexing unit: `chars` for Unicode scalar values or `bytes` for UTF-8 bytes; defaults to `chars`."
    }
  },
  "arguments": [
    {
      "literal": "text.substring"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "text"
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        },
        "start": {
          "delivery": "single",
          "schema": {
            "type": "integer"
          }
        },
        "length": {
          "delivery": "single",
          "schema": {
            "type": "integer"
          }
        },
        "unit": {
          "delivery": "single",
          "schema": {
            "type": "text",
            "enum": [
              "chars",
              "bytes"
            ]
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        }
      }
    },
    "capabilities": [
      "text.transform"
    ]
  },
  "parameter_alternatives": [
    {
      "message": "start must be an integer from -16777216 through 16777216",
      "any_of": [
        [
          {
            "test": "number_range",
            "parameter": "start",
            "minimum": -16777216,
            "maximum": 16777216
          }
        ]
      ]
    },
    {
      "message": "length must be an integer from 0 through 16777216",
      "any_of": [
        [
          {
            "test": "number_range",
            "parameter": "length",
            "minimum": 0,
            "maximum": 16777216
          }
        ]
      ]
    }
  ],
  "examples": [
    {
      "program": "run text.substring with text \"abcdef\" and start 2 and length 3 as value",
      "expected_output": "cde"
    }
  ]
}
