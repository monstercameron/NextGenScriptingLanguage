# Purpose: Join an offline receipt to warranty/product records and draft a support-ready lookup note without contacting a seller.
# Inputs: Sorted local TSV files share PROD-* identifiers and include purchase date, coverage end, and receipt reference.
# Outputs: out/074-warranty-receipt-product-cross-reference.json: local evidence links and missing-record questions.
accept live as boolean with default false
accept source_path as text with default "fixtures/074/source-high.txt"
accept report_path as text with default "out/074-warranty-receipt-product-cross-reference.json"
accept classify_fixture_path as text with default "fixtures/074/classify-high.json"
accept draft_fixture_path as text with default "fixtures/074/draft.json"
accept generator_model as text with default "gpt-6-luna"
accept env_file as text with default ".env"
accept reference_path as text with default "fixtures/074/reference-high.tsv"
# Refuse an output path that aliases an existing evidence or schema file.
run "test" with arguments ["!", source_path, "-ef", report_path]
run "test" with arguments ["!", reference_path, "-ef", report_path]
run join with flags ["-t", "\t"] and files [source_path, reference_path] as evidence
if live is true
  then jev.classify with question "Does the local product and receipt evidence form a complete enough cross-reference for a support lookup?" and labels ["cross-reference-complete", "needs-human"] and minimum 80 and env_file env_file as class_raw
otherwise
  then jev.classify with question "Does the local product and receipt evidence form a complete enough cross-reference for a support lookup?" and labels ["cross-reference-complete", "needs-human"] and minimum 80 and fixture classify_fixture_path and env_file env_file as class_raw
then parse json as classification
take text at "/label" from classification as label
take integer at "/confidence_percent" from classification as confidence
take boolean at "/accepted" from classification as accepted
if accepted is true
  if label is "cross-reference-complete"
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "label", label, "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "{label:$label,confidence_percent:$confidence,evidence:$evidence}"]
    if live is true
      then llm.ask with model generator_model and instruction "Summarize the joined PROD-* row and identify any missing purchase, coverage, or receipt fact. Cite local IDs; avoid warranty eligibility conclusions and do not contact a merchant." and env_file env_file as draft_raw
    otherwise
      then llm.ask with model generator_model and instruction "Summarize the joined PROD-* row and identify any missing purchase, coverage, or receipt fact. Cite local IDs; avoid warranty eligibility conclusions and do not contact a merchant." and fixture draft_fixture_path and env_file env_file as draft_raw
    then parse json as draft_result
    take text at "/text" from draft_result as draft
    run jq with flags ["-n", "-r", "--arg", "draft", draft, "--arg", "evidence", evidence] and filter "($draft | rtrimstr(\"\\n\")) as $candidate | if ($candidate | startswith(\"EVIDENCE:\")) and ([$evidence | scan(\"[A-Z][A-Z0-9]+-[A-Z0-9-]+\") | . as $id | select($candidate | contains($id))] | length > 0) then $candidate else error(\"draft must start with EVIDENCE and cite an ID present in the bounded evidence\") end" as validated_draft
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "warranty_receipt_cross_reference", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "draft", validated_draft, "--arg", "action", "Owner verifies original receipt and current warranty terms.", "{artifact:$artifact,status:\"draft-for-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,product_support_lookup:$draft,action:$action}"]
    then save to report_path
  otherwise
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "warranty_receipt_cross_reference", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "review_action", "No external lookup, claim, or support message is sent.", "{artifact:$artifact,status:\"needs-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,product_support_lookup:null,reason:\"Classifier selected the human-review label above the confidence threshold; no LLM draft was requested.\",action:$review_action}"]
    then save to report_path
  then cat with path report_path
otherwise
  then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "warranty_receipt_cross_reference", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "review_action", "No external lookup, claim, or support message is sent.", "{artifact:$artifact,status:\"needs-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,product_support_lookup:null,reason:\"Classifier confidence is below the configured 80 percent threshold; no LLM draft was requested.\",action:$review_action}"]
  then save to report_path
then cat with path report_path
