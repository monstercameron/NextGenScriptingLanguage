{
  "name": "wc",
  "description": "Counts lines, words, bytes, or characters in standard input according to the selected wc flags. Flag operands can name input files, so file arguments read files.",
  "binary": "wc",
  "accepts_stdin": true,
  "cacheable": false,
  "parameters": {
    "flags": {
      "type": "list",
      "items": "string"
    }
  },
  "arguments": [
    {
      "when_present": "flags",
      "append": [
        {
          "spread": "flags"
        }
      ]
    }
  ],
  "contract": {
    "version": 1,
    "backend": "command",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "raw"
    },
    "capabilities": [
      "process.exec",
      "filesystem.read"
    ],
    "effects": [
      "filesystem.read"
    ]
  }
}
