{
  "name": "csv.parse",
  "description": "Parses CSV records without inferring cell types and returns a header list plus rows of string cells; duplicate header names remain distinct.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "description": "CSV text to parse; when omitted, the applet reads CSV from its input stream."
    },
    "has_headers": {
      "type": "boolean",
      "description": "Whether the first record supplies column names; omitted means true, while false treats every record as data."
    }
  },
  "arguments": [
    {
      "literal": "csv.parse"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "record",
      "encoding": "json",
      "fields": {
        "headers": {
          "type": "list",
          "items": {
            "type": "text"
          }
        },
        "rows": {
          "type": "list",
          "items": {
            "type": "list",
            "items": {
              "type": "text"
            }
          }
        }
      },
      "required": [
        "headers",
        "rows"
      ]
    },
    "capabilities": [
      "csv.convert"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "has_headers": {
          "schema": {
            "type": "boolean"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "record",
            "fields": {
              "headers": {
                "type": "list",
                "items": {
                  "type": "text"
                }
              },
              "rows": {
                "type": "list",
                "items": {
                  "type": "list",
                  "items": {
                    "type": "text"
                  }
                }
              }
            },
            "required": [
              "headers",
              "rows"
            ]
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "csv parse"
  ],
  "examples": [
    {
      "program": "run csv.parse with text \"name,city\\nAda,London\\n\" as table",
      "expected_output": {
        "headers": [
          "name",
          "city"
        ],
        "rows": [
          [
            "Ada",
            "London"
          ]
        ]
      }
    }
  ]
}
