{
  "name": "text.pad",
  "description": "Provides text.pad for controlled scripts.",
  "phrases": [
    "pad text to width"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string"
    },
    "width": {
      "type": "unsigned_integer",
      "required": true
    },
    "side": {
      "type": "string",
      "enum": [
        "left",
        "right"
      ]
    },
    "fill": {
      "type": "string"
    },
    "display_width": {
      "type": "boolean"
    }
  },
  "parameter_alternatives": [
    {
      "message": "width must be a nonnegative integer within the text output limit",
      "any_of": [
        [
          {
            "test": "number_range",
            "parameter": "width",
            "minimum": 0,
            "maximum": 16777216
          }
        ]
      ]
    },
    {
      "message": "text.pad fill must be nonempty when supplied",
      "any_of": [
        [
          {
            "test": "absent",
            "parameter": "fill"
          }
        ],
        [
          {
            "test": "nonempty",
            "parameter": "fill"
          }
        ]
      ]
    }
  ],
  "arguments": [
    {
      "literal": "text.pad"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "text"
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        },
        "width": {
          "delivery": "single",
          "schema": {
            "type": "usize"
          }
        },
        "side": {
          "delivery": "single",
          "schema": {
            "type": "text",
            "enum": [
              "left",
              "right"
            ]
          }
        },
        "fill": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        },
        "display_width": {
          "delivery": "single",
          "schema": {
            "type": "boolean"
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        }
      }
    },
    "capabilities": [
      "text.transform"
    ]
  }
}
