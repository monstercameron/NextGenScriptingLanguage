{
  "name": "text.count_lines_by",
  "description": "Provides the text count lines by operation for controlled scripts.",
  "phrases": [
    "count lines by field",
    "group lines by key"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "delimiter": {
      "type": "string",
      "required": true
    },
    "field": {
      "type": "integer"
    }
  },
  "parameter_alternatives": [
    {
      "message": "field must be an integer from 0 through 16777216",
      "any_of": [
        [
          {
            "test": "absent",
            "parameter": "field"
          }
        ],
        [
          {
            "test": "number_range",
            "parameter": "field",
            "minimum": 0,
            "maximum": 16777216
          }
        ]
      ]
    },
    {
      "message": "text.count_lines_by delimiter must be nonempty",
      "any_of": [
        [
          {
            "test": "nonempty",
            "parameter": "delimiter"
          }
        ]
      ]
    }
  ],
  "arguments": [
    {
      "literal": "text.count_lines_by"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "list",
      "encoding": "json",
      "items": {
        "type": "json"
      }
    },
    "capabilities": [
      "data.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "delimiter": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "field": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          },
          "delivery": "single"
        }
      }
    }
  }
}
