{
  "name": "jq",
  "description": "Transforms standard input JSON with the supplied jq filter and optional jq flags.",
  "binary": "jq",
  "accepts_stdin": true,
  "cacheable": false,
  "parameters": {
    "flags": {
      "type": "list",
      "items": "string"
    },
    "filter": {
      "type": "string",
      "required": true
    }
  },
  "arguments": [
    {
      "when_present": "flags",
      "append": [
        {
          "spread": "flags"
        }
      ]
    },
    {
      "literal": "--"
    },
    {
      "parameter": "filter"
    }
  ]
}
