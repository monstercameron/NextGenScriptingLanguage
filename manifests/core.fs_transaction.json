{
  "name": "fs.transaction",
  "description": "Applies up to 32 expected-hash writes or removals to existing regular files and keeps a recovery journal; files become visible one at a time.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "journal": {
      "type": "path",
      "required": true
    },
    "operations": {
      "type": "json",
      "required": true,
      "schema": {
        "type": "list",
        "min_items": 1,
        "max_items": 32,
        "items": {
          "type": "json",
          "one_of": [
            {
              "type": "record",
              "fields": {
                "action": { "type": "string", "enum": ["write"] },
                "path": { "type": "path" },
                "expected_content_hash": { "type": "string" },
                "content": { "type": "string" }
              },
              "required": ["action", "path", "expected_content_hash", "content"]
            },
            {
              "type": "record",
              "fields": {
                "action": { "type": "string", "enum": ["remove"] },
                "path": { "type": "path" },
                "expected_content_hash": { "type": "string" }
              },
              "required": ["action", "path", "expected_content_hash"]
            }
          ]
        }
      }
    },
    "lock_timeout_ms": {
      "type": "integer"
    }
  },
  "arguments": [
    {
      "literal": "fs.transaction"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "command",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "json",
      "encoding": "json"
    },
    "outcomes": [
      {
        "status": 0,
        "name": "success",
        "kind": "success"
      },
      {
        "status": 1,
        "name": "absence",
        "kind": "absence"
      },
      {
        "status": 2,
        "name": "failure",
        "kind": "failure"
      },
      {
        "status": 75,
        "name": "retryable",
        "kind": "retryable"
      },
      {
        "status": 76,
        "name": "uncertain_effect",
        "kind": "failure"
      }
    ],
    "capabilities": [
      "filesystem.read",
      "filesystem.write",
      "filesystem.lock"
    ],
    "effects": [
      "filesystem.write",
      "filesystem.lock"
    ],
    "result_envelope": true
  },
  "parameter_alternatives": [
    {
      "message": "lock_timeout_ms must be an integer from 0 through 300000",
      "any_of": [
        [
          {
            "test": "absent",
            "parameter": "lock_timeout_ms"
          }
        ],
        [
          {
            "test": "number_range",
            "parameter": "lock_timeout_ms",
            "minimum": 0,
            "maximum": 300000
          }
        ]
      ]
    }
  ]
}
