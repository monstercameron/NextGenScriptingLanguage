{
  "name": "omarchy.editor-install",
  "description": "Provides the omarchy editor-install operation for controlled scripts.",
  "binary": "/usr/bin/env",
  "accepts_stdin": false,
  "cacheable": false,
  "parameters": {
    "command": {
      "type": "string",
      "required": true
    },
    "extension": {
      "type": "string",
      "required": true
    }
  },
  "arguments": [
    {
      "parameter": "command"
    },
    {
      "literal": "--install-extension"
    },
    {
      "parameter": "extension"
    }
  ],
  "stdio": {
    "stdout": "discard",
    "stderr": "discard"
  },
  "contract": {
    "version": 1,
    "backend": "command",
    "lifecycle": {
      "kind": "oneshot"
    },
    "outcomes": [
      {
        "status": 0,
        "name": "success",
        "kind": "success"
      },
      {
        "status": 1,
        "name": "failure",
        "kind": "failure"
      },
      {
        "status": 127,
        "name": "not_found",
        "kind": "absence"
      }
    ],
    "capabilities": [
      "process.spawn"
    ],
    "effects": [
      "process.spawn"
    ]
  }
}
