    "effects": ["network.loopback"],
    "ports": {
      "inputs": {
        "click": {"schema": {"type": "record", "fields": {}, "required": []}, "delivery": "events"}
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "record",
            "fields": {"synced": {"type": "boolean"}, "message": {"type": "text"}},
            "required": ["synced", "message"]
          },
          "delivery": "records"
        }
      }
    }
  }
