{
  "name": "list.slice",
  "description": "Return a contiguous section of a list using an offset and nonnegative length.",
  "phrases": [
    "list slice",
    "items slice"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "items": {
      "type": "json",
      "required": true,
      "description": "List to slice."
    },
    "offset": {
      "type": "integer",
      "required": true,
      "description": "Starting index; a negative value counts backward from the end of the list."
    },
    "length": {
      "type": "integer",
      "required": true,
      "description": "Number of values to return; must be nonnegative and remain within the list bounds."
    }
  },
  "arguments": [
    {
      "literal": "list.slice"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "list",
      "items": {
        "type": "json"
      }
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "items": {
          "delivery": "single",
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          }
        },
        "offset": {
          "delivery": "single",
          "schema": {
            "type": "integer"
          }
        },
        "length": {
          "delivery": "single",
          "schema": {
            "type": "integer"
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "items": {
              "type": "json"
            },
            "type": "list"
          }
        }
      }
    },
    "capabilities": [
      "data.transform"
    ]
  },
  "parameter_alternatives": [
    {
      "message": "offset must be an integer from -100000 through 100000",
      "any_of": [
        [
          {
            "test": "number_range",
            "parameter": "offset",
            "minimum": -100000,
            "maximum": 100000
          }
        ]
      ]
    },
    {
      "message": "length must be an integer from 0 through 100000",
      "any_of": [
        [
          {
            "test": "number_range",
            "parameter": "length",
            "minimum": 0,
            "maximum": 100000
          }
        ]
      ]
    }
  ],
  "examples": [
    {
      "program": "run list.slice with items [\"a\", \"b\", \"c\", \"d\"] and offset 1 and length 2 as result",
      "expected_output": [
        "b",
        "c"
      ]
    }
  ]
}
