{
  "name": "time.diff",
  "description": "Provides the time.diff operation for controlled scripts.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "left": {
      "type": "integer",
      "required": true
    },
    "right": {
      "type": "integer",
      "required": true
    },
    "unit": {
      "type": "string",
      "required": true,
      "enum": [
        "seconds",
        "minutes",
        "hours",
        "days"
      ]
    }
  },
  "arguments": [
    {
      "literal": "time.diff"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "number"
    },
    "capabilities": [
      "clock.read"
    ],
    "effects": [
      "clock.read"
    ],
    "ports": {
      "inputs": {
        "left": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "right": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "unit": {
          "schema": {
            "type": "text",
            "enum": [
              "seconds",
              "minutes",
              "hours",
              "days"
            ]
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "number"
          }
        }
      }
    }
  },
  "phrases": [
    "time diff"
  ]
}
