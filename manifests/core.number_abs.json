{
  "name": "number.abs",
  "description": "Return the nonnegative magnitude of an integer or finite number.",
  "phrases": [
    "number abs",
    "value abs"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "value": {
      "type": "json",
      "required": true,
      "description": "Finite JSON number whose absolute magnitude is returned."
    }
  },
  "arguments": [
    {
      "literal": "number.abs"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "number"
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "number"
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "number"
          }
        }
      }
    },
    "capabilities": [
      "number.compute"
    ]
  },
  "examples": [
    {
      "program": "run number.abs with value -7.5 as result",
      "expected_output": 7.5
    }
  ]
}
