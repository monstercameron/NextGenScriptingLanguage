{
  "name": "color.parse_rgb.result",
  "description": "Parses three comma-separated decimal RGB channels into a normalized hex color and returns a structured failure when the input is invalid.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "default_hex": {
      "type": "string",
      "required": true,
      "pattern": "hex_color_optional_hash",
      "description": "Six-digit hexadecimal fallback used to validate the request; an optional leading # is accepted."
    },
    "text": {
      "type": "string",
      "description": "Optional comma-separated red, green, and blue decimal channels, each from 0 through 255; when omitted, the applet reads its input stream."
    }
  },
  "arguments": [
    {
      "literal": "color.parse_rgb.result"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "record",
      "encoding": "json",
      "fields": {
        "valid": {
          "type": "boolean"
        },
        "hex": {
          "type": "text"
        }
      },
      "required": [
        "valid",
        "hex"
      ]
    },
    "capabilities": [
      "color.convert"
    ],
    "effects": [],
    "result_envelope": true,
    "outcomes": [
      {
        "status": 0,
        "name": "success",
        "kind": "success"
      },
      {
        "status": 2,
        "name": "failure",
        "kind": "failure"
      }
    ],
    "ports": {
      "inputs": {
        "default_hex": {
          "schema": {
            "type": "text",
            "pattern": "hex_color_optional_hash"
          },
          "delivery": "single"
        },
        "text": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "record",
            "fields": {
              "valid": {
                "type": "boolean"
              },
              "hex": {
                "type": "text"
              }
            },
            "required": [
              "valid",
              "hex"
            ],
            "nullable": true
          },
          "delivery": "single",
          "pointer": "/value"
        }
      }
    }
  },
  "phrases": [
    "color parse_rgb result"
  ],
  "examples": [
    {
      "program": "run color.parse_rgb.result with default_hex \"#ffffff\" and text \"12, 34, 56\" as color",
      "expected_output": {
        "valid": true,
        "hex": "0c2238"
      }
    }
  ]
}
