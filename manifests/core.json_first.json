{
  "name": "json.first",
  "description": "Returns the first item of an array selected from the document by JSON Pointer.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "document": {
      "type": "json",
      "required": true,
      "description": "JSON document containing the target array; stdin is used when omitted."
    },
    "pointer": {
      "type": "string",
      "description": "JSON Pointer locating the array; an empty pointer selects the root array."
    }
  },
  "arguments": [
    {
      "literal": "json.first"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "json"
    },
    "capabilities": [
      "json.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "document": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        },
        "pointer": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "json"
          }
        }
      }
    }
  },
  "phrases": [
    "json first"
  ],
  "examples": [
    {
      "program": "run json.first with document [\"Ada\",\"Lin\"] as result",
      "expected_output": "Ada"
    }
  ]
}
