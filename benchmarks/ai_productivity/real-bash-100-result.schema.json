{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://execute.invalid/schemas/ai-productivity-real-bash-100-result-1.json",
  "title": "One blinded cell in the 100-script Bash-behavior recreation study",
  "type": "object",
  "required": [
    "schema", "trial_type", "run_id", "session_id", "task_id", "blind_arm_id",
    "replicate", "dispatch_index", "freeze_sha256", "protocol_sha256",
    "corpus_review_sha256", "corpus_manifest_sha256", "corpus_digest_receipt_sha256", "task_roster_sha256",
    "task_package_sha256", "oracle_package_sha256", "timing_case_package_sha256",
    "runner_source_sha256", "runner_image_sha256", "language_reference_bundle_sha256",
    "arm_map_sha256", "tool_configuration_sha256", "randomized_run_plan_sha256",
    "attempts", "runtime", "review"
  ],
  "properties": {
    "schema": {"const": "execute.ai-productivity.real-bash-100-run/1"},
    "trial_type": {"const": "evaluation"},
    "run_id": {"type": "string", "format": "uuid"},
    "session_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}$"},
    "blind_arm_id": {"type": "string", "pattern": "^arm_[a-z0-9]{8,32}$"},
    "replicate": {"const": 1},
    "dispatch_index": {"type": "integer", "minimum": 1, "maximum": 300},
    "freeze_sha256": {"$ref": "#/$defs/sha"},
    "protocol_sha256": {"$ref": "#/$defs/sha"},
    "corpus_manifest_sha256": {"$ref": "#/$defs/sha"},
    "corpus_review_sha256": {"$ref": "#/$defs/sha"},
    "corpus_digest_receipt_sha256": {"$ref": "#/$defs/sha"},
    "task_roster_sha256": {"$ref": "#/$defs/sha"},
    "task_package_sha256": {"$ref": "#/$defs/sha"},
    "oracle_package_sha256": {"$ref": "#/$defs/sha"},
    "timing_case_package_sha256": {"$ref": "#/$defs/sha"},
    "runner_source_sha256": {"$ref": "#/$defs/sha"},
    "runner_image_sha256": {"$ref": "#/$defs/sha"},
    "language_reference_bundle_sha256": {"$ref": "#/$defs/sha"},
    "arm_map_sha256": {"$ref": "#/$defs/sha"},
    "tool_configuration_sha256": {"$ref": "#/$defs/sha"},
    "randomized_run_plan_sha256": {"$ref": "#/$defs/sha"},
    "attempts": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/attempt"}},
    "runtime": {"$ref": "#/$defs/runtime"},
    "review": {"$ref": "#/$defs/review"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "attempt": {
      "type": "object",
      "required": ["stage", "artifact_sha256", "artifact_ref", "archive_ref", "archive_manifest_ref", "archive_manifest_sha256", "observation_sha256", "started_utc", "conductor_elapsed_ms", "elapsed_basis", "usage", "tool_calls", "cost", "oracle_status", "criteria_results", "diagnostic_feedback_sent"],
      "properties": {
        "stage": {"enum": ["generate", "repair"]},
        "artifact_sha256": {"$ref": "#/$defs/sha"},
        "artifact_ref": {"type": "string", "minLength": 1, "description": "Relative file path inside the attempt archive to the exact runner-copied candidate artifact."},
        "archive_ref": {"type": "string", "minLength": 1, "description": "Relative directory path under the evaluator's --attempt-archive-root. The importer rejects traversal and symlinks, verifies every archive file against the archive manifest, and recomputes the attempt outcome."},
        "archive_manifest_ref": {"const": "archive-manifest.json"},
        "archive_manifest_sha256": {"$ref": "#/$defs/sha", "description": "SHA-256 of canonical archive-manifest JSON without its final newline."},
        "observation_sha256": {"$ref": "#/$defs/sha", "description": "SHA-256 of the exact archived observation.json bytes including the final newline."},
        "started_utc": {"type": "string", "format": "date-time"},
        "conductor_elapsed_ms": {"type": ["integer", "null"], "minimum": 0},
        "elapsed_basis": {"enum": ["dispatch_to_response_wall_clock", "unavailable"]},
        "usage": {
          "type": "object", "required": ["basis", "input_tokens", "output_tokens", "reasoning_tokens", "cached_input_tokens"],
          "properties": {
            "basis": {"const": "unavailable"}, "input_tokens": {"type": "null"},
            "output_tokens": {"type": "null"}, "reasoning_tokens": {"type": "null"},
            "cached_input_tokens": {"type": "null"}
          }, "additionalProperties": false
        },
        "tool_calls": {
          "type": "object", "required": ["basis", "count"],
          "properties": {"basis": {"const": "unavailable"}, "count": {"type": "null"}},
          "additionalProperties": false
        },
        "cost": {
          "type": "object", "required": ["basis", "amount", "currency"],
          "properties": {"basis": {"const": "unavailable"}, "amount": {"type": "null"}, "currency": {"type": "null"}},
          "additionalProperties": false
        },
        "oracle_status": {
          "enum": ["pass", "fail", "infrastructure_error"],
          "description": "Production status and criteria are recomputed from the verified attempt archive and frozen oracle package; submitted values must match. Provider refusal/timeout rows require a separate provider-event evidence adapter and are not accepted by this archive importer. Candidate time/output/resource and snapshot-cap outcomes fail through the mandatory all_cases_observed criterion."
        },
        "criteria_results": {
          "type": "object",
          "additionalProperties": {"type": ["boolean", "null"]},
          "description": "One value per frozen mandatory criterion. False is a definite behavioral failure; null means that criterion could not be evaluated."
        },
        "diagnostic_feedback_sent": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object", "required": ["status", "timing_case_set_sha256", "warmup_runs", "repetitions_ms"],
      "properties": {
        "status": {"enum": ["measured", "measurement_error", "unavailable", "not_measured_functional_failure", "not_measured_incomplete_outcome"]},
        "timing_case_set_sha256": {"$ref": "#/$defs/sha"},
        "warmup_runs": {"type": ["integer", "null"], "minimum": 0},
        "repetitions_ms": {"type": "array", "items": {"type": "integer", "minimum": 0}, "maxItems": 10}
      },
      "additionalProperties": false
    },
    "rating": {
      "type": "object", "required": ["rater_id", "rubric_sha256", "requirement_coverage", "readability", "changeability"],
      "properties": {
        "rater_id": {"type": "string", "minLength": 1}, "rubric_sha256": {"$ref": "#/$defs/sha"},
        "requirement_coverage": {"type": "integer", "minimum": 1, "maximum": 5},
        "readability": {"type": "integer", "minimum": 1, "maximum": 5},
        "changeability": {"type": "integer", "minimum": 1, "maximum": 5}
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object", "required": ["status", "ratings", "adjudication", "score_locked_utc"],
      "properties": {
        "status": {"enum": ["pending", "locked", "not_rateable"]},
        "ratings": {"type": "array", "items": {"$ref": "#/$defs/rating"}, "maxItems": 2},
        "adjudication": {"oneOf": [{"$ref": "#/$defs/rating"}, {"type": "null"}]},
        "score_locked_utc": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    }
  }
}
