{
  "name": "text.default_if_empty",
  "description": "Returns the supplied text unchanged unless it is empty, in which case it returns the provided fallback.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "description": "Text to keep when it has at least one byte; omitted text is read from UTF-8 stdin."
    },
    "default": {
      "type": "string",
      "required": true,
      "description": "Text returned when the input text is empty."
    }
  },
  "arguments": [
    {
      "literal": "text.default_if_empty"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "json"
    },
    "capabilities": [
      "text.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "default": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "text default_if_empty",
    "default empty text"
  ],
  "examples": [
    {
      "program": "run text.default_if_empty with text \"\" and default \"untitled\" as value",
      "expected_output": "untitled"
    }
  ]
}
