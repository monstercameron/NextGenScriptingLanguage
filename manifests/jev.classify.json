{
  "name": "jev.classify",
  "binary": "@execute-model",
  "accepts_stdin": true,
  "cacheable": false,
  "uncertain_on_failure": true,
  "parameters": {
    "question": {
      "type": "string",
      "required": true
    },
    "labels": {
      "type": "list",
      "items": "string",
      "min_items": 2
    },
    "criteria": {
      "type": "json"
    },
    "model": {
      "type": "string"
    },
    "minimum": {
      "type": "integer"
    },
    "max_bytes": {
      "type": "integer"
    },
    "timeout_ms": {
      "type": "integer"
    },
    "env_file": {
      "type": "string"
    },
    "fixture": {
      "type": "string"
    }
  },
  "arguments": [
    {
      "literal": "classify"
    },
    {
      "literal": "--provider"
    },
    {
      "literal": "jev"
    },
    {
      "when_present": "model",
      "append": [
        {
          "literal": "--model"
        },
        {
          "parameter": "model"
        }
      ]
    },
    {
      "literal": "--question"
    },
    {
      "parameter": "question"
    },
    {
      "when_present": "labels",
      "append": [
        {
          "literal": "--labels"
        },
        {
          "spread": "labels"
        }
      ]
    },
    {
      "when_present": "criteria",
      "append": [
        {
          "literal": "--criteria"
        },
        {
          "json_parameter": "criteria"
        }
      ]
    },
    {
      "when_present": "minimum",
      "append": [
        {
          "literal": "--minimum"
        },
        {
          "parameter": "minimum"
        }
      ]
    },
    {
      "when_present": "max_bytes",
      "append": [
        {
          "literal": "--max-bytes"
        },
        {
          "parameter": "max_bytes"
        }
      ]
    },
    {
      "when_present": "timeout_ms",
      "append": [
        {
          "literal": "--timeout-ms"
        },
        {
          "parameter": "timeout_ms"
        }
      ]
    },
    {
      "when_present": "env_file",
      "append": [
        {
          "literal": "--env-file"
        },
        {
          "parameter": "env_file"
        }
      ]
    },
    {
      "when_present": "fixture",
      "append": [
        {
          "literal": "--fixture"
        },
        {
          "parameter": "fixture"
        }
      ]
    }
  ],
  "contract": {
    "version": 1,
    "backend": "command",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "record",
      "encoding": "json",
      "fields": {
        "protocol": {
          "type": "text"
        },
        "provider": {
          "type": "text"
        },
        "model": {
          "type": "text"
        },
        "kind": {
          "type": "text"
        },
        "transport": {
          "type": "text"
        },
        "usage": {
          "type": "record",
          "fields": {
            "input_tokens": {
              "type": "integer"
            },
            "output_tokens": {
              "type": "integer"
            },
            "total_tokens": {
              "type": "integer"
            }
          },
          "required": [
            "input_tokens",
            "output_tokens",
            "total_tokens"
          ]
        },
        "label": {
          "type": "text"
        },
        "confidence_percent": {
          "type": "integer"
        },
        "accepted": {
          "type": "boolean"
        }
      },
      "required": [
        "protocol",
        "provider",
        "model",
        "kind",
        "transport",
        "usage",
        "label",
        "confidence_percent",
        "accepted"
      ]
    }
  }
}
