{
  "name": "desktop.quickshell",
  "build_feature": "desktop",
  "binary": "qs",
  "accepts_stdin": false,
  "parameters": {
    "config": {
      "type": "path",
      "required": true
    }
  },
  "arguments": [
    {
      "literal": "--path"
    },
    {
      "parameter": "config"
    }
  ],
  "contract": {
    "version": 1,
    "backend": "command",
    "lifecycle": {
      "kind": "oneshot"
    },
    "capabilities": [
      "desktop.render"
    ],
    "effects": [
      "desktop.render"
    ]
  }
}
