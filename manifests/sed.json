{
  "name": "sed",
  "description": "Edits or filters standard input using the supplied sed program and optional sed flags.",
  "binary": "sed",
  "accepts_stdin": true,
  "parameters": {
    "flags": {
      "type": "list",
      "items": "string"
    },
    "program": {
      "type": "string",
      "required": true
    }
  },
  "arguments": [
    {
      "when_present": "flags",
      "append": [
        {
          "spread": "flags"
        }
      ]
    },
    {
      "literal": "-e"
    },
    {
      "parameter": "program"
    }
  ]
}
