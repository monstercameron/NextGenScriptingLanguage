{
  "name": "text.trim",
  "description": "Removes leading, trailing, or both-side characters from text, using Unicode whitespace by default or the supplied character set.",
  "phrases": [
    "text trim",
    "trim whitespace",
    "trim surrounding whitespace"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "description": "Text to trim; omitted text is read from UTF-8 stdin."
    },
    "mode": {
      "type": "string",
      "enum": [
        "both",
        "start",
        "end"
      ],
      "description": "Which ends to trim: `both`, `start`, or `end`; defaults to `both`."
    },
    "chars": {
      "type": "string",
      "description": "Optional set of individual characters to trim instead of Unicode whitespace."
    }
  },
  "arguments": [
    {
      "literal": "text.trim"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "text"
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        },
        "mode": {
          "delivery": "single",
          "schema": {
            "type": "text",
            "enum": [
              "both",
              "start",
              "end"
            ]
          }
        },
        "chars": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        }
      }
    },
    "capabilities": [
      "text.transform"
    ]
  },
  "examples": [
    {
      "program": "run text.trim with text \"  ready  \" and mode \"both\" as value",
      "expected_output": "ready"
    }
  ]
}
