{
  "name": "json.sum",
  "description": "Adds every numeric item in the root array and returns the resulting number.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "document": {
      "type": "list",
      "items": "json",
      "required": true,
      "description": "Root JSON array of numbers to add; stdin is used when omitted."
    }
  },
  "arguments": [
    {
      "literal": "json.sum"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "number"
    },
    "capabilities": [
      "json.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "document": {
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "number"
          }
        }
      }
    }
  },
  "phrases": [
    "json sum"
  ],
  "examples": [
    {
      "program": "run json.sum with document [2, 3, 5] as result",
      "expected_output": 10
    }
  ]
}
