{
  "name": "json.delete",
  "description": "Removes the value at a JSON Pointer from an object or array and returns the edited document.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "document": {
      "type": "json",
      "required": true,
      "description": "JSON object or array to edit; stdin is used when omitted."
    },
    "path": {
      "type": "string",
      "required": true,
      "description": "JSON Pointer identifying the member or array element to remove; the document root cannot be removed."
    }
  },
  "arguments": [
    {
      "literal": "json.delete"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "json"
    },
    "capabilities": [
      "json.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "document": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        },
        "path": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "json"
          }
        }
      }
    }
  },
  "phrases": [
    "json delete"
  ],
  "examples": [
    {
      "program": "run json.delete with document {\"name\":\"Ada\",\"active\":true} and path \"/active\" as result",
      "expected_output": {
        "name": "Ada"
      }
    }
  ]
}
