{
  "name": "notify.restore",
  "description": "Restores the most recently dismissed notification in mako.",
  "binary": "makoctl",
  "accepts_stdin": false,
  "cacheable": false,
  "parameters": {},
  "arguments": [
    {
      "literal": "restore"
    }
  ],
  "contract": {
    "version": 1,
    "backend": "command",
    "lifecycle": {
      "kind": "oneshot"
    },
    "outcomes": [
      {
        "status": 0,
        "name": "success",
        "kind": "success"
      },
      {
        "status": 127,
        "name": "not_found",
        "kind": "absence"
      }
    ],
    "capabilities": [
      "desktop.notify"
    ],
    "effects": [
      "desktop.notify"
    ]
  }
}
