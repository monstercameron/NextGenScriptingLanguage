{
  "name": "json.get",
  "description": "Looks up the first non-null JSON Pointer from pointer or ordered pointers, returning an optional default for an absent or null value.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "document": {
      "type": "json"
    },
    "pointer": {
      "type": "string"
    },
    "default": {
      "type": "json"
    },
    "pointers": {
      "type": "list",
      "items": "string"
    }
  },
  "arguments": [
    {
      "literal": "json.get"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "json",
      "encoding": "json"
    },
    "capabilities": [
      "json.inspect"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "document": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        },
        "pointer": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "json"
          },
          "delivery": "single",
          "encoding": "json"
        },
        "default": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        },
        "pointers": {
          "schema": {
            "type": "list",
            "items": {
              "type": "text"
            }
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "get JSON value",
    "use JSON fallback"
  ]
}
