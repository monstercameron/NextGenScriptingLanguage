{
  "name": "text.split",
  "description": "Splits text on a nonempty literal separator, or on NUL in NUL mode; one trailing separator terminates the final item without adding an empty item.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "description": "Text to split; omitted text is read from UTF-8 stdin."
    },
    "separator": {
      "type": "string",
      "description": "Nonempty literal separator; use this unless nul is true."
    },
    "nul": {
      "type": "boolean",
      "description": "When true, split on NUL bytes instead of separator; cannot be combined with separator."
    }
  },
  "arguments": [
    {
      "literal": "text.split"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "list",
      "encoding": "json",
      "items": {
        "type": "text"
      }
    },
    "capabilities": [
      "text.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "separator": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "nul": {
          "schema": {
            "type": "boolean"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "list",
            "items": {
              "type": "text"
            }
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "text split"
  ],
  "parameter_alternatives": [
    {
      "message": "text.split requires a nonempty separator or nul true, but not both",
      "any_of": [
        [
          {
            "test": "nonempty",
            "parameter": "separator"
          },
          {
            "test": "absent",
            "parameter": "nul"
          }
        ],
        [
          {
            "test": "nonempty",
            "parameter": "separator"
          },
          {
            "test": "boolean",
            "parameter": "nul",
            "value": false
          }
        ],
        [
          {
            "test": "absent",
            "parameter": "separator"
          },
          {
            "test": "boolean",
            "parameter": "nul",
            "value": true
          }
        ]
      ]
    }
  ],
  "examples": [
    {
      "program": "run text.split with text \"a,b,c,\" and separator \",\" as value",
      "expected_output": [
        "a",
        "b",
        "c"
      ]
    }
  ]
}
