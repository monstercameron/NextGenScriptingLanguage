# Purpose: Check a document export’s heading sequence for likely skipped levels and produce a cited review memo.
# Inputs: HTML heading export with stable DOC-* IDs; inline markup is kept so reviewers can find the source element.
# Outputs: out/051-document-heading-order-review.json: evidence excerpt, classifier signal, and a human-review-only structure memo.
accept live as boolean with default false
accept source_path as text with default "fixtures/051/source-high.txt"
accept report_path as text with default "out/051-document-heading-order-review.json"
accept classify_fixture_path as text with default "fixtures/051/classify-high.json"
accept draft_fixture_path as text with default "fixtures/051/draft.json"
accept generator_model as text with default "gpt-6-luna"
accept env_file as text with default ".env"
# Refuse an output path that aliases an existing evidence or schema file.
run "test" with arguments ["!", source_path, "-ef", report_path]
run cat with path source_path
then grep with flags ["-E"] and pattern "^<h[1-6][[:space:]>]" as evidence
if live is true
  then jev.classify with question "Are these headings sufficient evidence of a document outline defect that needs accessibility review?" and labels ["outline-gap", "needs-human"] and minimum 80 and env_file env_file as class_raw
otherwise
  then jev.classify with question "Are these headings sufficient evidence of a document outline defect that needs accessibility review?" and labels ["outline-gap", "needs-human"] and minimum 80 and fixture classify_fixture_path and env_file env_file as class_raw
then parse json as classification
take text at "/label" from classification as label
take integer at "/confidence_percent" from classification as confidence
take boolean at "/accepted" from classification as accepted
if accepted is true
  if label is "outline-gap"
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "label", label, "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "{label:$label,confidence_percent:$confidence,evidence:$evidence}"]
    if live is true
      then llm.ask with model generator_model and instruction "Compare the heading sequence. Draft one review note about ordering only when directly supported; cite the DOC-* element ID, distinguish a skipped level from a proven assistive-technology failure, and recommend a human check." and env_file env_file as draft_raw
    otherwise
      then llm.ask with model generator_model and instruction "Compare the heading sequence. Draft one review note about ordering only when directly supported; cite the DOC-* element ID, distinguish a skipped level from a proven assistive-technology failure, and recommend a human check." and fixture draft_fixture_path and env_file env_file as draft_raw
    then parse json as draft_result
    take text at "/text" from draft_result as draft
    run jq with flags ["-n", "-r", "--arg", "draft", draft, "--arg", "evidence", evidence] and filter "($draft | rtrimstr(\"\\n\")) as $candidate | if ($candidate | startswith(\"EVIDENCE:\")) and ([$evidence | scan(\"[A-Z][A-Z0-9]+-[A-Z0-9-]+\") | . as $id | select($candidate | contains($id))] | length > 0) then $candidate else error(\"draft must start with EVIDENCE and cite an ID present in the bounded evidence\") end" as validated_draft
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "document-heading-structure-review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "draft", validated_draft, "--arg", "action", "Review the outline manually before changing document styles.", "{artifact:$artifact,status:\"draft-for-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,heading_structure_review:$draft,action:$action}"]
    then save to report_path
  otherwise
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "document-heading-structure-review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "review_action", "Keep all original headings; human reviewer should inspect the rendered document.", "{artifact:$artifact,status:\"needs-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,heading_structure_review:null,reason:\"Classifier selected the human-review label above the confidence threshold; no LLM draft was requested.\",action:$review_action}"]
    then save to report_path
  then cat with path report_path
otherwise
  then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "document-heading-structure-review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "review_action", "Keep all original headings; human reviewer should inspect the rendered document.", "{artifact:$artifact,status:\"needs-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,heading_structure_review:null,reason:\"Classifier confidence is below the configured 80 percent threshold; no LLM draft was requested.\",action:$review_action}"]
  then save to report_path
then cat with path report_path
