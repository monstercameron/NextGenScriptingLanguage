{
  "name": "printf",
  "description": "Writes the supplied message followed by a newline to standard output.",
  "phrases": [
    "print"
  ],
  "binary": "printf",
  "parameters": {
    "message": {
      "type": "string",
      "required": true
    }
  },
  "arguments": [
    {
      "literal": "%s\\n"
    },
    {
      "parameter": "message"
    }
  ],
  "contract": {
    "version": 1,
    "backend": "command",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "raw"
    },
    "capabilities": [
      "process.exec"
    ],
    "effects": []
  }
}
