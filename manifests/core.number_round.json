{
  "name": "number.round",
  "description": "Provides number.round for controlled scripts.",
  "phrases": [
    "number round",
    "value round"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "value": {
      "type": "json",
      "required": true
    },
    "digits": {
      "type": "integer"
    }
  },
  "parameter_alternatives": [
    {
      "message": "digits must be between -38 and 38 for integer values or -308 and 308 for floating-point values",
      "any_of": [
        [
          {
            "test": "absent",
            "parameter": "digits"
          }
        ],
        [
          {
            "test": "number_range_by_representation",
            "parameter": "digits",
            "based_on": "value",
            "representation": "integer",
            "minimum": -38,
            "maximum": 38
          }
        ],
        [
          {
            "test": "number_range_by_representation",
            "parameter": "digits",
            "based_on": "value",
            "representation": "float",
            "minimum": -308,
            "maximum": 308
          }
        ]
      ]
    }
  ],
  "arguments": [
    {
      "literal": "number.round"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "number"
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "number"
          }
        },
        "digits": {
          "delivery": "single",
          "schema": {
            "type": "integer"
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "number"
          }
        }
      }
    },
    "capabilities": [
      "number.compute"
    ]
  }
}
