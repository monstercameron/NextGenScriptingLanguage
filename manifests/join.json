{
  "name": "join",
  "description": "Joins corresponding lines from two or more files side by side, using the selected join flags.",
  "binary": "join",
  "parameters": {
    "flags": {
      "type": "list",
      "items": "string"
    },
    "files": {
      "type": "list",
      "items": "string",
      "required": true,
      "min_items": 2
    }
  },
  "arguments": [
    {
      "when_present": "flags",
      "append": [
        {
          "spread": "flags"
        }
      ]
    },
    {
      "literal": "--"
    },
    {
      "spread": "files"
    }
  ]
}
