{
  "name": "grep",
  "description": "Prints input lines that match the supplied pattern, with optional grep flags.",
  "binary": "grep",
  "accepts_stdin": true,
  "parameters": {
    "pattern": {
      "type": "string",
      "required": true
    },
    "flags": {
      "type": "list",
      "items": "string"
    }
  },
  "arguments": [
    {
      "when_present": "flags",
      "append": [
        {
          "spread": "flags"
        }
      ]
    },
    {
      "literal": "--"
    },
    {
      "parameter": "pattern"
    }
  ]
}
