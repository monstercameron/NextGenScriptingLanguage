{
  "name": "json.filter",
  "description": "Provides the json filter operation for controlled scripts.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "document": {
      "type": "json"
    },
    "pointer": {
      "type": "string"
    },
    "where": {
      "type": "json",
      "required": true,
      "schema": {
        "type": "list",
        "max_items": 32,
        "items": {
          "type": "json",
          "one_of": [
            {
              "type": "record",
              "fields": {
                "pointer": { "type": "string" },
                "exists": { "type": "boolean" }
              },
              "required": ["exists"]
            },
            {
              "type": "record",
              "fields": {
                "pointer": { "type": "string" },
                "equals": { "type": "json" }
              },
              "required": ["equals"]
            },
            {
              "type": "record",
              "fields": {
                "pointer": { "type": "string" },
                "not_equals": { "type": "json" }
              },
              "required": ["not_equals"]
            },
            {
              "type": "record",
              "fields": {
                "pointer": { "type": "string" },
                "type": {
                  "type": "string",
                  "enum": ["null", "boolean", "number", "string", "array", "object"]
                }
              },
              "required": ["type"]
            }
          ]
        }
      }
    }
  },
  "arguments": [
    {
      "literal": "json.filter"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "list",
      "encoding": "json",
      "items": {
        "type": "json"
      }
    },
    "capabilities": [
      "json.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "document": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        },
        "pointer": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "where": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "json"
          },
          "delivery": "single",
          "encoding": "json"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "json filter",
    "filter json records"
  ]
}
