    prereg = load_json(path, "paired preregistration")
    _expect(isinstance(prereg, dict) and prereg.get("schema") == "typed-json-carry-paired-preregistration/1", "preregistration schema mismatch")
    _expect(prereg.get("protocol") == protocol(), "protocol differs from this runner")
    _expect(prereg.get("workload") == {
        "calls": 1000,
        "applet": "number.add",
        "literal_operands": [1, 2],
        "source_bytes": EXPECTED_SOURCE_BYTES,
        "source_sha256": EXPECTED_SOURCE_SHA256,
        "output_hex": EXPECTED_OUTPUT_HEX,
        "output_sha256": EXPECTED_OUTPUT_SHA256,
        "launched_processes": 0,
        "cache_hits": 0,
        "retained_records": 256,
        "dropped_records_and_stages": 744,
    }, "workload contract changed")
    runner = prereg.get("runner")
