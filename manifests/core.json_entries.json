{
  "name": "json.entries",
  "description": "Converts an object into an array of key and value records, optionally at a nested JSON Pointer.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "document": {
      "type": "json",
      "required": true,
      "description": "JSON object to enumerate; stdin is used when omitted."
    },
    "pointer": {
      "type": "string",
      "required": false,
      "description": "JSON Pointer locating the object whose members become records; an empty pointer selects the whole document."
    }
  },
  "arguments": [
    {
      "literal": "json.entries"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "json"
    },
    "capabilities": [
      "json.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "document": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        },
        "pointer": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "json"
          }
        }
      }
    }
  },
  "phrases": [
    "json entries"
  ],
  "examples": [
    {
      "program": "run json.entries with document {\"name\":\"Ada\",\"score\":8} as result",
      "expected_output": [
        {
          "key": "name",
          "value": "Ada"
        },
        {
          "key": "score",
          "value": 8
        }
      ]
    }
  ]
}
