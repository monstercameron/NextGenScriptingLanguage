  "accepts_stdin": false,
  "parameters": {"pulse": {"type": "integer", "required": true}},
  "arguments": [{"json_arguments": true}],
  "contract": {
    "version": 1,
    "backend": "remote",
    "remote": {
      "endpoint": "http://127.0.0.1:18765",
