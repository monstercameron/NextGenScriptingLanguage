{
  "name": "list.flatten",
  "description": "Flatten nested lists recursively, or only to the optional maximum depth.",
  "phrases": [
    "list flatten",
    "items flatten"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "items": {
      "type": "json",
      "required": true,
      "description": "List to flatten; nested lists are expanded while preserving order."
    },
    "depth": {
      "type": "integer",
      "description": "Maximum number of nested list levels to expand; omit to flatten all levels, or use 0 to keep the input nesting."
    }
  },
  "arguments": [
    {
      "literal": "list.flatten"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "list",
      "items": {
        "type": "json"
      }
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "items": {
          "delivery": "single",
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          }
        },
        "depth": {
          "delivery": "single",
          "schema": {
            "type": "integer"
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "items": {
              "type": "json"
            },
            "type": "list"
          }
        }
      }
    },
    "capabilities": [
      "data.transform"
    ]
  },
  "examples": [
    {
      "program": "run list.flatten with items [1, [2, [3]]] and depth 1 as result",
      "expected_output": [
        1,
        2,
        [
          3
        ]
      ]
    }
  ]
}
