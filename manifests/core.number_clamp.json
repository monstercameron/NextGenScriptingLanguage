{
  "name": "number.clamp",
  "description": "Constrain a finite number to the inclusive interval from min through max.",
  "phrases": [
    "number clamp",
    "value clamp"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "value": {
      "type": "json",
      "required": true,
      "description": "Finite number to constrain."
    },
    "min": {
      "type": "json",
      "required": true,
      "description": "Inclusive lower bound; must not exceed max."
    },
    "max": {
      "type": "json",
      "required": true,
      "description": "Inclusive upper bound; must be at least min."
    }
  },
  "arguments": [
    {
      "literal": "number.clamp"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "number"
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "number"
          }
        },
        "min": {
          "delivery": "single",
          "schema": {
            "type": "number"
          }
        },
        "max": {
          "delivery": "single",
          "schema": {
            "type": "number"
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "number"
          }
        }
      }
    },
    "capabilities": [
      "number.compute"
    ]
  },
  "examples": [
    {
      "program": "run number.clamp with value 12 and min 0 and max 10 as result",
      "expected_output": 10
    }
  ]
}
