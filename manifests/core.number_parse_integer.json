{
  "name": "number.parse_integer",
  "description": "Parse signed decimal or base-specific text as a 64-bit integer, optionally trimming ASCII whitespace.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "description": "Optional integer text; when omitted, the applet reads stdin."
    },
    "base": {
      "type": "integer",
      "description": "Radix from 2 through 36; defaults to decimal (10)."
    },
    "trim_ascii_whitespace": {
      "type": "boolean",
      "description": "When true, remove ASCII whitespace around the text before parsing."
    }
  },
  "arguments": [
    {
      "literal": "number.parse_integer"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "integer",
      "encoding": "json"
    },
    "capabilities": [
      "number.compute"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "base": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "trim_ascii_whitespace": {
          "schema": {
            "type": "boolean"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "number parse_integer"
  ],
  "parameter_alternatives": [
    {
      "message": "base must be an integer from 2 through 36",
      "any_of": [
        [
          {
            "test": "absent",
            "parameter": "base"
          }
        ],
        [
          {
            "test": "number_range",
            "parameter": "base",
            "minimum": 2,
            "maximum": 36
          }
        ]
      ]
    }
  ],
  "examples": [
    {
      "program": "run number.parse_integer with text \"-42\" as result",
      "expected_output": -42
    }
  ]
}
