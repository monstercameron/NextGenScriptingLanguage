{
  "name": "json.group_by",
  "description": "Groups root array items by the JSON value selected by pointer and returns groups ordered by their serialized key.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "document": {
      "type": "list",
      "items": "json",
      "required": true,
      "description": "Root JSON array whose items are grouped; stdin is used when omitted."
    },
    "pointer": {
      "type": "string",
      "description": "JSON Pointer evaluated relative to each item; an empty pointer groups equal whole items."
    }
  },
  "arguments": [
    {
      "literal": "json.group_by"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "items": {
        "type": "json"
      },
      "type": "list"
    },
    "capabilities": [
      "json.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "document": {
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          },
          "delivery": "single"
        },
        "pointer": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          }
        }
      }
    }
  },
  "phrases": [
    "json group_by"
  ],
  "examples": [
    {
      "program": "run json.group_by with document [{\"team\":\"blue\",\"name\":\"Ada\"},{\"team\":\"red\",\"name\":\"Lin\"},{\"team\":\"blue\",\"name\":\"Sam\"}] and pointer \"/team\" as result",
      "expected_output": [
        [
          {
            "name": "Ada",
            "team": "blue"
          },
          {
            "name": "Sam",
            "team": "blue"
          }
        ],
        [
          {
            "name": "Lin",
            "team": "red"
          }
        ]
      ]
    }
  ]
}
