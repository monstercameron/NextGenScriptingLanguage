{
  "name": "json.unique_by",
  "description": "Keeps the first root-array item for each distinct value selected by JSON Pointer.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "document": {
      "type": "list",
      "items": "json",
      "required": true,
      "description": "Root JSON array to deduplicate; stdin is used when omitted."
    },
    "pointer": {
      "type": "string",
      "description": "JSON Pointer evaluated relative to each item to identify its uniqueness key."
    }
  },
  "arguments": [
    {
      "literal": "json.unique_by"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "items": {
        "type": "json"
      },
      "type": "list"
    },
    "capabilities": [
      "json.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "document": {
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          },
          "delivery": "single"
        },
        "pointer": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          }
        }
      }
    }
  },
  "phrases": [
    "json unique_by"
  ],
  "examples": [
    {
      "program": "run json.unique_by with document [{\"id\":1,\"name\":\"Ada\"},{\"id\":1,\"name\":\"A. Lovelace\"},{\"id\":2,\"name\":\"Lin\"}] and pointer \"/id\" as result",
      "expected_output": [
        {
          "id": 1,
          "name": "Ada"
        },
        {
          "id": 2,
          "name": "Lin"
        }
      ]
    }
  ]
}
