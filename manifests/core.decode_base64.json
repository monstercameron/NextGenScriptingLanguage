{
  "name": "decode.base64",
  "description": "Decodes RFC 4648 base64 text to UTF-8, with options for the URL-safe alphabet and inputs that omit padding.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "text": {
      "type": "string",
      "required": true,
      "description": "Base64-encoded text to decode; decoded bytes must be valid UTF-8."
    },
    "url_safe": {
      "type": "boolean",
      "description": "Set true when the input uses - and _ in place of the standard + and / alphabet; omitted means the standard alphabet."
    },
    "padding": {
      "type": "boolean",
      "description": "Set false to accept unpadded input and restore omitted padding; omitted means padding is required."
    }
  },
  "arguments": [
    {
      "literal": "decode.base64"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "text"
    },
    "capabilities": [
      "text.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "url_safe": {
          "schema": {
            "type": "boolean"
          },
          "delivery": "single"
        },
        "padding": {
          "schema": {
            "type": "boolean"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        }
      }
    }
  },
  "phrases": [
    "decode base64"
  ],
  "examples": [
    {
      "program": "run decode.base64 with text \"Zg\" and padding false as decoded",
      "expected_output": "f"
    }
  ]
}
