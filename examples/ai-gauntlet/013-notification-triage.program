# Purpose: Triage a notification into now, later or never.
# Inputs: source_path, fixture paths, live=false.
# Outputs: out/013.json; candidate only; model text is never command code.
# Bash would need: priority keyword rules and two independently checked model answers.
accept source_path as text with default "fixtures/013/source.txt"
accept fixture as text with default "fixtures/013/confident.json"
accept live as boolean with default false
try
  read source_path
  if live is true
    then jev.ask with questions {"actionable":{"minimum":80,"question":"Does this notification ask the user for a concrete action?","type":"noul"},"route":{"labels":["now","later","never"],"minimum":80,"question":"When should the user review this notification?","type":"choice"}} and timeout_ms 3000 and max_bytes 65536 as raw # execute-allow: lint.unused_binding intentional model-result capture for acceptance analysis and downstream parsing
  otherwise
    then jev.ask with questions {"actionable":{"minimum":80,"question":"Does this notification ask the user for a concrete action?","type":"noul"},"route":{"labels":["now","later","never"],"minimum":80,"question":"When should the user review this notification?","type":"choice"}} and timeout_ms 3000 and max_bytes 65536 and fixture fixture as raw
  then parse json as verdict
  take boolean at "/answers/route/accepted" from verdict as accepted
  take integer at "/answers/route/confidence_percent" from verdict as confidence # execute-allow: lint.unused_binding intentional typed take validates the model confidence field
  take text at "/answers/route/label" from verdict as label
  take boolean at "/answers/actionable/accepted" from verdict as action_accepted
  take integer at "/answers/actionable/confidence_percent" from verdict as action_confidence # execute-allow: lint.unused_binding intentional typed take validates the model confidence field
  take boolean at "/answers/actionable/decision" from verdict as actionable
  if accepted is true
    if label is "now"
      if action_accepted is true
        if actionable is true
          run json.set with document {"action":"Review against the original input before acting.","result":null,"status":"candidate-for-review"} and pointer "/result" and value "now"
        otherwise
          run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
      otherwise
        run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
    otherwise
      run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
  otherwise
    run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
catch failure # execute-allow: lint.unused_binding intentional catch control binding; recovery uses the handler path rather than the error value
  run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
then save to "out/013.json"
