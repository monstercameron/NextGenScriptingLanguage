{
  "name": "text.matches",
  "description": "Finds every overlapping occurrence of a literal needle and returns whether any matched, the match count, and UTF-8 byte offsets.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "needle": {
      "type": "string",
      "required": true,
      "description": "Literal string to find; an empty needle matches at each character boundary."
    },
    "text": {
      "type": "string",
      "description": "Text to search; omitted text is read from UTF-8 stdin."
    }
  },
  "arguments": [
    {
      "literal": "text.matches"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "record",
      "encoding": "json",
      "fields": {
        "matches": {
          "type": "boolean"
        },
        "count": {
          "type": "integer"
        },
        "byte_offsets": {
          "type": "json"
        }
      },
      "required": [
        "matches",
        "count",
        "byte_offsets"
      ]
    },
    "capabilities": [
      "text.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "needle": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "text": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "record",
            "fields": {
              "matches": {
                "type": "boolean"
              },
              "count": {
                "type": "integer"
              },
              "byte_offsets": {
                "type": "json"
              }
            },
            "required": [
              "matches",
              "count",
              "byte_offsets"
            ]
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "text matches"
  ],
  "examples": [
    {
      "program": "run text.matches with needle \"aba\" and text \"ababa\" as value",
      "expected_output": {
        "matches": true,
        "count": 2,
        "byte_offsets": [
          0,
          2
        ]
      }
    }
  ]
}
