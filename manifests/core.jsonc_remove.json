{
  "name": "jsonc.remove",
  "description": "Removes a root property from a JSONC file using a content-hash precondition and the declared filesystem policies.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "path": {
      "type": "path",
      "required": true,
      "description": "JSONC file to update."
    },
    "expected_content_hash": {
      "type": "string",
      "required": true,
      "description": "Expected current file hash used to detect concurrent or stale edits."
    },
    "symlink_policy": {
      "type": "string",
      "required": true,
      "description": "Policy controlling whether the target path may resolve through a symbolic link."
    },
    "permissions_policy": {
      "type": "string",
      "required": true,
      "description": "Policy controlling file permissions during the update."
    },
    "lock": {
      "type": "path",
      "description": "Optional lock path used to serialize competing updates."
    },
    "key": {
      "type": "string",
      "required": true,
      "description": "Root property name to remove from the JSONC document."
    },
    "lock_timeout_ms": {
      "type": "integer",
      "description": "Maximum time in milliseconds to wait for the lock when one is configured."
    }
  },
  "arguments": [
    {
      "literal": "jsonc.remove"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "command",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "json",
      "encoding": "json"
    },
    "capabilities": [
      "filesystem.read",
      "filesystem.write",
      "filesystem.lock"
    ],
    "effects": [
      "filesystem.write",
      "filesystem.lock"
    ],
    "outcomes": [
      {
        "status": 0,
        "name": "success",
        "kind": "success"
      },
      {
        "status": 1,
        "name": "absence",
        "kind": "absence"
      },
      {
        "status": 2,
        "name": "failure",
        "kind": "failure"
      },
      {
        "status": 75,
        "name": "retryable",
        "kind": "retryable"
      },
      {
        "status": 76,
        "name": "uncertain_effect",
        "kind": "failure"
      }
    ],
    "result_envelope": true
  },
  "stdio": {
    "stderr": "discard"
  },
  "parameter_alternatives": [
    {
      "message": "lock_timeout_ms must be an integer from 0 through 300000",
      "any_of": [
        [
          {
            "test": "absent",
            "parameter": "lock_timeout_ms"
          }
        ],
        [
          {
            "test": "number_range",
            "parameter": "lock_timeout_ms",
            "minimum": 0,
            "maximum": 300000
          }
        ]
      ]
    }
  ]
}
