{
  "name": "list.zip",
  "description": "Pair values at matching positions from two lists and stop when the shorter list ends.",
  "phrases": [
    "list zip",
    "left zip"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "left": {
      "type": "json",
      "required": true,
      "description": "First list of values to pair."
    },
    "right": {
      "type": "json",
      "required": true,
      "description": "Second list of values to pair."
    }
  },
  "arguments": [
    {
      "literal": "list.zip"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "list",
      "items": {
        "type": "json"
      }
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "left": {
          "delivery": "single",
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          }
        },
        "right": {
          "delivery": "single",
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "items": {
              "type": "json"
            },
            "type": "list"
          }
        }
      }
    },
    "capabilities": [
      "data.transform"
    ]
  },
  "examples": [
    {
      "program": "run list.zip with left [\"a\", \"b\", \"c\"] and right [1, 2] as result",
      "expected_output": [
        [
          "a",
          1
        ],
        [
          "b",
          2
        ]
      ]
    }
  ]
}
