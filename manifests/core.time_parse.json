{
  "name": "time.parse",
  "description": "Parses a date-time string with a Chrono format and returns its Unix timestamp in whole seconds.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "text": {
      "type": "string",
      "required": true,
      "description": "Date-time text to parse, including the offset required by the chosen format."
    },
    "format": {
      "type": "string",
      "required": true,
      "description": "Chrono strftime format that describes text, including `%z` when text has an offset."
    }
  },
  "arguments": [
    {
      "literal": "time.parse"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "integer"
    },
    "capabilities": [
      "clock.read"
    ],
    "effects": [
      "clock.read"
    ],
    "ports": {
      "inputs": {
        "text": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "format": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "integer"
          }
        }
      }
    }
  },
  "phrases": [
    "time parse"
  ],
  "examples": [
    {
      "program": "run time.parse with text \"2024-02-29T12:00:00+0000\" and format \"%Y-%m-%dT%H:%M:%S%z\" as value",
      "expected_output": 1709208000
    }
  ]
}
