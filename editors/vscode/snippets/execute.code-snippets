{
  "Native Unix pipeline": {
    "prefix": [
      "program-pipeline",
      "pipeline"
    ],
    "description": "A complete native pipeline with a saved output.",
    "body": [
      "run cat with path \"${1:input.txt}\"",
      "pipe to tr with from \"[:lower:]\" and to \"[:upper:]\"",
      "then save to \"${2:output.txt}\"",
      "$0"
    ],
    "isFileTemplate": true
  },
  "Run an applet": {
    "prefix": "run",
    "description": "Start an independent native command.",
    "body": [
      "run ${1:printf} with ${2:message} \"${3:hello}\"$0"
    ]
  },
  "Sequence an applet": {
    "prefix": "then",
    "description": "Pass finite output to the next applet.",
    "body": [
      "then ${1:cat}$0"
    ]
  },
  "Native pipe": {
    "prefix": "pipe",
    "description": "Connect a concurrently running native stage.",
    "body": [
      "pipe to ${1:wc} with flags [\"${2:-l}\"]$0"
    ]
  },
  "Read a file": {
    "prefix": "read",
    "description": "Read bytes from a file.",
    "body": [
      "read \"${1:input.txt}\"$0"
    ]
  },
  "Save current output": {
    "prefix": "save",
    "description": "Atomically save the current finite output.",
    "body": [
      "then save to \"${1:output.txt}\"$0"
    ]
  },
  "Cached transformation": {
    "prefix": "program-cache",
    "description": "Read, normalize, cache, and save a finite value.",
    "body": [
      "read \"${1:input.txt}\"",
      "then tr with from \"[:upper:]\" and to \"[:lower:]\" and cache",
      "then save to \"${2:output.txt}\"",
      "$0"
    ],
    "isFileTemplate": true
  },
  "Stdin event listener": {
    "prefix": [
      "program-listener",
      "listener"
    ],
    "description": "A fresh transform for each text record from stdin.",
    "body": [
      "listen to stdin",
      "whenever a line arrives as ${1:message}",
      "  then tr with from \"[:lower:]\" and to \"[:upper:]\"",
      "$0"
    ],
    "isFileTemplate": true
  },
  "Persistent native stream": {
    "prefix": [
      "program-stream",
      "stream"
    ],
    "description": "Keep tail and cat alive; stop after three final records.",
    "body": [
      "stream from tail with flags [\"-n\", \"0\", \"-F\"] and path \"${1:events.log}\"",
      "pipe to cat",
      "take the first ${2:3} lines",
      "show each line",
      "$0"
    ],
    "isFileTemplate": true
  },
  "Interval service": {
    "prefix": [
      "program-interval",
      "interval"
    ],
    "description": "Run the body on a monotonic interval.",
    "body": [
      "every ${1:30} seconds",
      "  run pwd",
      "$0"
    ],
    "isFileTemplate": true
  },
  "Calendar service": {
    "prefix": [
      "program-schedule",
      "schedule"
    ],
    "description": "Run on matching local five-field cron minutes.",
    "body": [
      "on schedule \"${1:0 9 * * 1-5}\"",
      "  run pwd",
      "$0"
    ],
    "isFileTemplate": true
  },
  "Terminal screen": {
    "prefix": [
      "program-screen",
      "screen"
    ],
    "description": "A complete single-component terminal app.",
    "body": [
      "open a screen titled \"${1:Operator console}\"",
      "place app on the left",
      "",
      "define a program named app",
      "  show a heading named title with text \"${2:Status}\"",
      "  show a text panel named output",
      "  show a button named refresh labelled \"Refresh\"",
      "",
      "  whenever the program opens",
      "    press refresh",
      "",
      "  whenever refresh is pressed",
      "    run printf with message \"${3:ready}\"",
      "    then show the result in output",
      "",
      "  whenever key \"Ctrl-Q\" is pressed",
      "    close the screen",
      "$0"
    ],
    "isFileTemplate": true
  },
  "Connected terminal components": {
    "prefix": "program-components",
    "description": "A document chooser connected to a file preview.",
    "body": [
      "open a screen titled \"${1:Document preview}\"",
      "divide the screen into two columns",
      "place chooser on the left",
      "place preview on the right",
      "give chooser 30 percent of the width",
      "connect selected from chooser to file in preview",
      "",
      "define a program named chooser",
      "  offer selected as text",
      "  show a list named files",
      "    include \"${2:README.md}\"",
      "  whenever an item is chosen in files",
      "    send that item as selected",
      "  whenever key \"Ctrl-Q\" is pressed",
      "    close the screen",
      "",
      "define a program named preview",
      "  accept file as text",
      "  show a text panel named contents",
      "  whenever file arrives",
      "    run cat with path file",
      "    then show the result in contents",
      "$0"
    ],
    "isFileTemplate": true
  },
  "Named finite output": {
    "prefix": "result",
    "description": "Bind a finite applet result without trimming its newline.",
    "body": [
      "run printf with message \"${1:value}\" as ${2:result}$0"
    ]
  },
  "Text widget": {
    "prefix": "widget-text",
    "description": "Declare a named text panel in a component.",
    "body": [
      "show a text panel named ${1:status} with text \"${2:Waiting}\"$0"
    ]
  },
  "Widget handler": {
    "prefix": "handler",
    "description": "Handle a button press within a component.",
    "body": [
      "whenever ${1:refresh} is pressed",
      "  run printf with message \"${2:updated}\"",
      "  then show the result in ${3:output}",
      "$0"
    ]
  },
  "Direct executable program": {
    "prefix": "program-command",
    "description": "Run an installed executable directly without an applet manifest (Execute 0.7.0+).",
    "isFileTemplate": true,
    "body": [
      "run \"${1:printf}\" with arguments [\"%s\\n\", \"${2:hello}\"]"
    ]
  },
  "Program with declared input": {
    "prefix": "program-input",
    "description": "Accept a required path and pass it directly to a native command (Execute 0.8.0+).",
    "isFileTemplate": true,
    "body": [
      "accept ${1:path} as text",
      "run \"${2:cksum}\" with arguments [${1:path}]"
    ]
  },
  "Unix pipeline stage": {
    "prefix": "program-filter",
    "description": "Sort and deduplicate stdin using a native pipeline stage.",
    "isFileTemplate": true,
    "body": [
      "read from stdin",
      "pipe to \"sort\" with arguments [\"-u\"]",
      "$0"
    ]
  },
  "Conditional native commands": {
    "prefix": "program-condition",
    "description": "A complete typed input and native command branch.",
    "body": [
      "accept enabled as boolean with default false",
      "if enabled is true",
      "  run \"printf\" with arguments [\"enabled\\n\"]",
      "otherwise",
      "  run \"printf\" with arguments [\"disabled\\n\"]",
      "$0"
    ],
    "isFileTemplate": true
  },
  "Typed JSON field": {
    "prefix": "program-json",
    "description": "Read JSON, select a typed field using a JSON pointer and pass it to a native command.",
    "isFileTemplate": true,
    "body": [
      "accept path as text",
      "read path",
      "then parse json as document",
      "take text at \"${1:/name}\" from document as selected",
      "then \"printf\" with arguments [\"%s\\n\", selected]"
    ]
  },
  "Reusable finite program": {
    "prefix": "program-reuse",
    "description": "Define a same-file finite program with explicit inputs, local variables and stdout output.",
    "isFileTemplate": true,
    "body": [
      "define a program named greet",
      "  accept name as text",
      "  run \"printf\" with arguments [\"hello %s\\n\", name]",
      "accept user as text with default \"world\"",
      "run program greet with name user"
    ]
  },
  "Unix command inputs": {
    "prefix": "program-command",
    "description": "Executable Unix command with typed argv and explicit environment input.",
    "body": [
      "#!/usr/bin/env -S execute --",
      "accept message as text from argument 1",
      "accept root as text from environment \"${1:OMARCHY_PATH}\" with default \"${2:/usr/share/omarchy}\"",
      "run \"printf\" with arguments [\"%s\\n\", message]",
      "$0"
    ],
    "isFileTemplate": true
  },
  "Repeat a command": {
    "prefix": "program-repeat",
    "description": "Repeat a finite command block with an explicit integer input; Execute current source.",
    "isFileTemplate": true,
    "body": [
      "accept count as integer with default 3",
      "repeat count times",
      "  run \"printf\" with arguments [\"${1:hello}\\n\"]"
    ]
  },
  "Process each file": {
    "prefix": "program-foreach",
    "description": "Iterate an explicit text list; literal arguments keep spaces and wildcard characters.",
    "isFileTemplate": true,
    "body": [
      "accept files as list of text",
      "for each file in files",
      "  run \"cksum\" with arguments [file]"
    ]
  },
  "Poll using native status": {
    "prefix": "program-while",
    "description": "Reevaluate an integer status; native commands update it with its type preserved.",
    "isFileTemplate": true,
    "body": [
      "run \"true\" and keep status as status",
      "while status is 0",
      "  run \"false\" and keep status as status"
    ]
  },
  "Catch failures and always clean up": {
    "prefix": "program-try",
    "description": "Catch an ordinary failure and run a final cleanup block.",
    "isFileTemplate": true,
    "body": [
      "try",
      "  run \"${1:tool}\" with arguments [\"${2:--check}\"]",
      "catch failure",
      "  then encode failure as json",
      "finally",
      "  run \"printf\" with arguments [\"${3:cleanup}\\n\"]",
      "$0"
    ]
  },
  "Break or continue a loop": {
    "prefix": "program-loop-transfer",
    "description": "Use loop-local break and continue transfers.",
    "isFileTemplate": true,
    "body": [
      "accept files as list of text with default [\"first\", \"stop\", \"last\"]",
      "for each file in files",
      "  if file is \"stop\"",
      "    break",
      "  continue",
      "$0"
    ]
  },
  "Return from a reusable program": {
    "prefix": "program-return",
    "description": "Exit a reusable program early while keeping the current result.",
    "isFileTemplate": true,
    "body": [
      "define a program named lookup",
      "  accept name as text",
      "  if name is \"skip\"",
      "    then \"printf\" with arguments [\"skipped\\n\"]",
      "    return",
      "  then \"printf\" with arguments [\"%s\\n\", name]",
      "accept query as text with default \"example\"",
      "run program lookup with name query",
      "$0"
    ]
  },
  "Run independent tasks in parallel": {
    "prefix": "program-parallel",
    "description": "Join the named results from a bounded parallel task group.",
    "isFileTemplate": true,
    "body": [
      "parallel at most ${1:2} as results",
      "  run number.add with left ${2:20} and right ${3:22} as sum",
      "  run number.multiply with left ${4:6} and right ${5:7} as product",
      "then encode results as json",
      "$0"
    ]
  },
  "Return the first successful task": {
    "prefix": "program-race",
    "description": "Race independent tasks and keep the first successful result.",
    "isFileTemplate": true,
    "body": [
      "race at most ${1:2} as winner",
      "  run number.divide with left ${2:20} and right ${3:4} as quotient",
      "  run number.add with left ${4:8} and right ${5:9} as sum",
      "then encode winner as json",
      "$0"
    ]
  },
  "Select JSON with a dynamic pointer": {
    "prefix": "program-json-pointer",
    "description": "Select a typed JSON value using a text binding as its JSON pointer.",
    "isFileTemplate": true,
    "body": [
      "accept document as json with default {\"items\": [{\"name\": \"Ada\"}]}",
      "accept pointer as text with default \"/items/0/name\"",
      "take text at pointer from document as name",
      "then encode name as json",
      "$0"
    ]
  },
  "Encode an inline JSON value": {
    "prefix": "program-json-literal",
    "description": "Build nested JSON directly from object, array, scalar and null literals.",
    "isFileTemplate": true,
    "body": [
      "then encode {\"name\": \"${1:Ada}\", \"active\": true, \"scores\": [10, 9.5], \"optional\": null} as json",
      "$0"
    ]
  },
  "Typed applet graph": {
    "prefix": "program-graph",
    "description": "Connect typed applet ports with a bounded graph edge.",
    "isFileTemplate": true,
    "body": [
      "graph ${1:greeting}",
      "  run text.concat with parts [\"hello\", \"graph\"] and separator \" \" as joined",
      "  run text.trim_final_lf as cleaned",
      "  bind joined.value to cleaned.text with capacity ${2:1} lossless",
      "end graph",
      "$0"
    ]
  },
  "Named finite background job": {
    "prefix": [
      "program-job",
      "job"
    ],
    "description": "Spawn, inspect and await one finite native job while retaining its status and result.",
    "isFileTemplate": true,
    "body": [
      "spawn as ${1:build}",
      "  run \"printf\" with arguments [\"%s\\n\", \"${2:ready}\"]",
      "inspect $1 as ${3:build_state}",
      "await $1 and keep status as ${4:build_status} and keep result as ${5:build_result}",
      "then encode {\"state\": $3, \"status\": $4, \"result\": $5} as json",
      "$0"
    ]
  }
}
