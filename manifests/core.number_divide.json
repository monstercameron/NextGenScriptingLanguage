{
  "name": "number.divide",
  "description": "Divide left by right and return a finite numeric quotient; right must not be zero.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "left": {
      "type": "json",
      "required": true,
      "description": "Finite dividend."
    },
    "right": {
      "type": "json",
      "required": true,
      "description": "Finite nonzero divisor."
    }
  },
  "arguments": [
    {
      "literal": "number.divide"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "number",
      "encoding": "json"
    },
    "capabilities": [
      "number.compute"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "left": {
          "schema": {
            "type": "number"
          },
          "delivery": "single"
        },
        "right": {
          "schema": {
            "type": "number"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "number"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "number divide"
  ],
  "examples": [
    {
      "program": "run number.divide with left 7 and right 2 as result",
      "expected_output": 3.5
    }
  ]
}
