#!/usr/bin/env -S execute --
# Port of bin/omarchy-toggle-enabled (see original.sh). Exit 0 when the flag file exists.
execute 1
accept arguments as list of text from arguments
accept name_arg as text from argument 1 with default ""
accept home_dir as text from public environment "HOME" with default ""
run text.concat with parts [home_dir, "/.local/state/omarchy/toggles/", name_arg] as flag_path
if run "test" with arguments ["-f", flag_path] succeeds
  exit with status 0
otherwise
  exit with status 1
