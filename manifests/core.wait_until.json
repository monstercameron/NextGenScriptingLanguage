{
  "name": "wait.until",
  "description": "Provides the wait.until operation for controlled scripts.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "probe": {
      "type": "string",
      "required": true,
      "enum": [
        "file_exists",
        "file_readable",
        "tcp_port_open"
      ]
    },
    "host": {
      "type": "string",
      "required": false
    },
    "path": {
      "type": "string",
      "required": false
    },
    "interval_ms": {
      "type": "integer",
      "required": false
    },
    "port": {
      "type": "integer",
      "required": false
    },
    "timeout_ms": {
      "type": "integer",
      "required": true
    }
  },
  "arguments": [
    {
      "literal": "wait.until"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "json"
    },
    "capabilities": [
      "filesystem.read",
      "network.loopback"
    ],
    "effects": [
      "network.loopback"
    ],
    "ports": {
      "inputs": {
        "probe": {
          "schema": {
            "type": "text",
            "enum": [
              "file_exists",
              "file_readable",
              "tcp_port_open"
            ]
          },
          "delivery": "single"
        },
        "host": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "path": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "interval_ms": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "port": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "timeout_ms": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "json"
          }
        }
      }
    }
  },
  "phrases": [
    "wait until"
  ],
  "parameter_alternatives": [
    {
      "message": "timeout_ms must be an integer from 0 through 86400000",
      "any_of": [
        [
          {
            "test": "number_range",
            "parameter": "timeout_ms",
            "minimum": 0,
            "maximum": 86400000
          }
        ]
      ]
    },
    {
      "message": "interval_ms must be an integer from 1 through 10000",
      "any_of": [
        [
          {
            "test": "absent",
            "parameter": "interval_ms"
          }
        ],
        [
          {
            "test": "number_range",
            "parameter": "interval_ms",
            "minimum": 1,
            "maximum": 10000
          }
        ]
      ]
    },
    {
      "message": "path is required when probe is file_exists",
      "any_of": [
        [
          {
            "test": "string_not_equals",
            "parameter": "probe",
            "value": "file_exists"
          }
        ],
        [
          {
            "test": "present",
            "parameter": "path"
          }
        ]
      ]
    },
    {
      "message": "path is required when probe is file_readable",
      "any_of": [
        [
          {
            "test": "string_not_equals",
            "parameter": "probe",
            "value": "file_readable"
          }
        ],
        [
          {
            "test": "present",
            "parameter": "path"
          }
        ]
      ]
    },
    {
      "message": "host is required when probe is tcp_port_open",
      "any_of": [
        [
          {
            "test": "string_not_equals",
            "parameter": "probe",
            "value": "tcp_port_open"
          }
        ],
        [
          {
            "test": "present",
            "parameter": "host"
          }
        ]
      ]
    },
    {
      "message": "port is required when probe is tcp_port_open",
      "any_of": [
        [
          {
            "test": "string_not_equals",
            "parameter": "probe",
            "value": "tcp_port_open"
          }
        ],
        [
          {
            "test": "present",
            "parameter": "port"
          }
        ]
      ]
    }
  ]
}
