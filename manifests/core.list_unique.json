{
  "name": "list.unique",
  "description": "Remove duplicate JSON values while preserving the first occurrence of each value.",
  "phrases": [
    "deduplicate list",
    "unique values"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "items": {
      "type": "list",
      "items": "json",
      "description": "List of JSON values to deduplicate."
    },
    "key": {
      "type": "string",
      "description": "Accepted for compatibility; uniqueness compares each complete JSON value."
    },
    "n": {
      "type": "integer",
      "description": "Accepted for compatibility; this operation does not limit the result count."
    },
    "collect": {
      "type": "boolean",
      "description": "Accepted for compatibility; unique values are returned directly."
    },
    "delimiter": {
      "type": "string",
      "description": "Accepted for compatibility; this operation does not split input fields."
    },
    "field": {
      "type": "integer",
      "description": "Accepted for compatibility; this operation does not select an input field."
    }
  },
  "arguments": [
    {
      "literal": "list.unique"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "list",
      "encoding": "json",
      "items": {
        "type": "json"
      },
      "same_as_parameter": "items"
    },
    "capabilities": [
      "data.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "items": {
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          },
          "delivery": "single"
        },
        "key": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "n": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "collect": {
          "schema": {
            "type": "boolean"
          },
          "delivery": "single"
        },
        "delimiter": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "field": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          },
          "delivery": "single"
        }
      }
    }
  },
  "examples": [
    {
      "program": "run list.unique with items [\"red\", \"blue\", \"red\"] as result",
      "expected_output": [
        "red",
        "blue"
      ]
    }
  ]
}
