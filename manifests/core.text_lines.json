{
  "name": "text.lines",
  "description": "Splits UTF-8 text into lines, treating one final LF as a terminator and removing one CR before each line break.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "description": "UTF-8 text to split into lines; omitted text is read from stdin."
    }
  },
  "arguments": [
    {
      "literal": "text.lines"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "list",
      "encoding": "json",
      "items": {
        "type": "text"
      }
    },
    "capabilities": [
      "text.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "list",
            "items": {
              "type": "text"
            }
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "text lines"
  ],
  "examples": [
    {
      "program": "run text.lines with text \"first\\nsecond\\n\" as value",
      "expected_output": [
        "first",
        "second"
      ]
    }
  ]
}
