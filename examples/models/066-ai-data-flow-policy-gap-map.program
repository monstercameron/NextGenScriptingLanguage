# Purpose: Compute missing control names for each declared AI/data flow before drafting policy owner questions.
# Inputs: JSON contains FLOW-* records, data classes, declared controls, and the required control vocabulary.
# Outputs: out/066-ai-data-flow-policy-gap-map.json: deterministic missing-control matrix plus owner questions.
accept live as boolean with default false
accept source_path as text with default "fixtures/066/source-high.json"
accept report_path as text with default "out/066-ai-data-flow-policy-gap-map.json"
accept classify_fixture_path as text with default "fixtures/066/classify-high.json"
accept draft_fixture_path as text with default "fixtures/066/draft.json"
accept generator_model as text with default "gpt-6-luna"
accept env_file as text with default ".env"
# Refuse an output path that aliases an existing evidence or schema file.
run "test" with arguments ["!", source_path, "-ef", report_path]
run cat with path source_path
then jq with filter ".required as $required | .flows[] as $flow | [$flow.id, $flow.name, ($flow.data_classes | join(\",\")), ([$required[] as $control | select(($flow.controls | index($control)) == null) | $control] | join(\",\"))] | @tsv" and flags ["-r"] as evidence
if live is true
  then jev.classify with question "Which declared AI/data flows are missing one or more controls from the supplied checklist?" and labels ["control-gap", "needs-human"] and minimum 80 and env_file env_file as class_raw
otherwise
  then jev.classify with question "Which declared AI/data flows are missing one or more controls from the supplied checklist?" and labels ["control-gap", "needs-human"] and minimum 80 and fixture classify_fixture_path and env_file env_file as class_raw
then parse json as classification
take text at "/label" from classification as label
take integer at "/confidence_percent" from classification as confidence
take boolean at "/accepted" from classification as accepted
if accepted is true
  if label is "control-gap"
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "label", label, "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "{label:$label,confidence_percent:$confidence,evidence:$evidence}"]
    if live is true
      then llm.ask with model generator_model and instruction "Draft questions for missing control names in the supplied flow matrix. Cite FLOW-* IDs and data classes, distinguish declared controls from verified implementation, and request the named owner and evidence location." and env_file env_file as draft_raw
    otherwise
      then llm.ask with model generator_model and instruction "Draft questions for missing control names in the supplied flow matrix. Cite FLOW-* IDs and data classes, distinguish declared controls from verified implementation, and request the named owner and evidence location." and fixture draft_fixture_path and env_file env_file as draft_raw
    then parse json as draft_result
    take text at "/text" from draft_result as draft
    run jq with flags ["-n", "-r", "--arg", "draft", draft, "--arg", "evidence", evidence] and filter "($draft | rtrimstr(\"\\n\")) as $candidate | if ($candidate | startswith(\"EVIDENCE:\")) and ([$evidence | scan(\"[A-Z][A-Z0-9]+-[A-Z0-9-]+\") | . as $id | select($candidate | contains($id))] | length > 0) then $candidate else error(\"draft must start with EVIDENCE and cite an ID present in the bounded evidence\") end" as validated_draft
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "ai_data_flow_control_gap_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "draft", validated_draft, "--arg", "action", "Privacy/security owners verify implementation and evidence before sign-off.", "{artifact:$artifact,status:\"draft-for-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,policy_owner_questions:$draft,action:$action}"]
    then save to report_path
  otherwise
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "ai_data_flow_control_gap_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "review_action", "The checklist reports declarations; it is not a certification.", "{artifact:$artifact,status:\"needs-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,policy_owner_questions:null,reason:\"Classifier selected the human-review label above the confidence threshold; no LLM draft was requested.\",action:$review_action}"]
    then save to report_path
  then cat with path report_path
otherwise
  then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "ai_data_flow_control_gap_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "review_action", "The checklist reports declarations; it is not a certification.", "{artifact:$artifact,status:\"needs-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,policy_owner_questions:null,reason:\"Classifier confidence is below the configured 80 percent threshold; no LLM draft was requested.\",action:$review_action}"]
  then save to report_path
then cat with path report_path
