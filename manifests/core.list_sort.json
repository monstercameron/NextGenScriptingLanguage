{
  "name": "list.sort",
  "description": "Sort values ascending (numbers numerically, strings lexically), optionally using values selected through a JSON Pointer.",
  "phrases": [
    "sort list",
    "order records"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "items": {
      "type": "list",
      "items": "json",
      "description": "List of values to sort."
    },
    "key": {
      "type": "string",
      "required": false,
      "description": "Optional JSON Pointer used to select the value compared for each item; omit to compare whole values."
    },
    "n": {
      "type": "integer",
      "required": false,
      "description": "Accepted for compatibility; sorting returns every item and does not truncate to a count."
    },
    "collect": {
      "type": "boolean",
      "description": "Accepted for compatibility; sorting returns the ordered values directly."
    }
  },
  "arguments": [
    {
      "literal": "list.sort"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "list",
      "encoding": "json",
      "items": {
        "type": "json"
      },
      "same_as_parameter": "items"
    },
    "capabilities": [
      "data.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "items": {
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          },
          "delivery": "single"
        },
        "key": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "n": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "collect": {
          "schema": {
            "type": "boolean"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          },
          "delivery": "single"
        }
      }
    }
  },
  "examples": [
    {
      "program": "run list.sort with items [3, 1, 2] as result",
      "expected_output": [
        1,
        2,
        3
      ]
    }
  ]
}
