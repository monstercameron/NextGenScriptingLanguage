{
  "name": "json.values",
  "description": "Returns the values of the object at a JSON Pointer in deterministic key order.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "document": {
      "type": "json",
      "required": true,
      "description": "JSON document containing the target object; stdin is used when omitted."
    },
    "pointer": {
      "type": "string",
      "description": "JSON Pointer locating the object whose values are returned; an empty pointer selects the root object."
    }
  },
  "arguments": [
    {
      "literal": "json.values"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "items": {
        "type": "json"
      },
      "type": "list"
    },
    "capabilities": [
      "json.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "document": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        },
        "pointer": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          }
        }
      }
    }
  },
  "phrases": [
    "json values"
  ],
  "examples": [
    {
      "program": "run json.values with document {\"name\":\"Ada\",\"score\":8} as result",
      "expected_output": [
        "Ada",
        8
      ]
    }
  ]
}
