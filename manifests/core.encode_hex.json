{
  "name": "encode.hex",
  "description": "Encodes text or input-stream bytes as lowercase hexadecimal, with two digits for each byte.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "required": false,
      "description": "Optional text to encode; when omitted, the applet encodes bytes from its input stream."
    }
  },
  "arguments": [
    {
      "literal": "encode.hex"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "text"
    },
    "capabilities": [
      "text.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        }
      }
    }
  },
  "phrases": [
    "encode hex"
  ],
  "examples": [
    {
      "program": "run encode.hex with text \"Hi!\" as encoded",
      "expected_output": "486921"
    }
  ]
}
