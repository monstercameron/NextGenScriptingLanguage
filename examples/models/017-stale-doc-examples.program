# Purpose: Find stale documentation examples against captured CLI help; prepare bounded evidence and save a review-only model-assisted report.
# Inputs: local docs.txt evidence, explicit model fixtures, and a private empty environment file.
# Outputs: out/stale-doc-examples.json; the workflow never changes the source evidence.
accept source_path as text with default "fixtures/017/docs.txt"
accept reference_path as text with default "fixtures/017/help.txt"
accept report_path as text with default "out/stale-doc-examples.json"
accept classify_fixture_path as text with default "fixtures/017/judge-evidence-ready.json"
accept draft_fixture_path as text with default "fixtures/017/draft.json"
accept generator_model as text with default "gpt-6-luna"
accept env_file as text with default ".env"
accept live as boolean with default false
# Refuse an output path that aliases an existing evidence or schema file.
run "test" with arguments ["!", source_path, "-ef", report_path]
run "test" with arguments ["!", reference_path, "-ef", report_path]
run comm with flags ["-23"] and files [source_path, reference_path] as evidence
if live is true
  then jev.judge with question "Does the documentation contain a command option missing from the captured help output?" and minimum 80 and env_file env_file as raw
otherwise
  then jev.judge with question "Does the documentation contain a command option missing from the captured help output?" and minimum 80 and fixture classify_fixture_path and env_file env_file as raw
then parse json as decision
take boolean at "/decision" from decision as verdict
take boolean at "/accepted" from decision as accepted
take integer at "/confidence_percent" from decision as confidence
if accepted is true
  if verdict is true
    run comm with flags ["-23"] and files [source_path, reference_path]
    if live is true
      then llm.ask with model generator_model and instruction "Draft a documentation review note listing only options present in the docs fixture but absent from the captured help fixture. Do not claim the flag has been removed from every version." and env_file env_file as draft_raw
    otherwise
      then llm.ask with model generator_model and instruction "Draft a documentation review note listing only options present in the docs fixture but absent from the captured help fixture. Do not claim the flag has been removed from every version." and fixture draft_fixture_path and env_file env_file as draft_raw
    then parse json as generated
    take text at "/text" from generated as draft
    run jq with flags ["-n", "-r", "-j", "--arg", "draft", draft, "--arg", "evidence", evidence] and filter "if ($draft | startswith(\"EVIDENCE:\")) and ([$evidence | scan(\"[A-Z][A-Z0-9]+-[A-Z0-9-]+\") | . as $id | select($draft | contains($id))] | length > 0) then $draft else error(\"draft must start with EVIDENCE and cite an ID in bounded local evidence\") end" as validated_draft
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "stale_cli_example_review", "--arg", "status", "draft-for-human-review", "--arg", "classification", "confirmed", "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "--arg", "staleness_note", validated_draft, "--arg", "action", "A human owner reviews this proposed analysis before acting.", "{artifact:$artifact,status:$status,confidence_percent:$confidence,evidence_excerpt:$evidence,staleness_note:$staleness_note,action:$action,classification:$classification}"]
    then save to report_path
  otherwise
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "stale_cli_example_review", "--arg", "status", "needs-human-review", "--arg", "classification", "not-confirmed", "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "--arg", "reason", "The accepted result did not match this workflow’s positive label, decision, or score level; generated analysis was withheld.", "--arg", "action", "An owner checks the original records and decides the next step.", "{artifact:$artifact,status:$status,confidence_percent:$confidence,evidence_excerpt:$evidence,staleness_note:null,reason:$reason,action:$action,classification:$classification}"]
    then save to report_path
otherwise
  then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "stale_cli_example_review", "--arg", "status", "needs-human-review", "--arg", "classification", "uncertain", "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "--arg", "reason", "The model signal is below the configured 80 percent floor; no generated analysis was requested.", "--arg", "action", "An owner checks the original records and decides the next step.", "{artifact:$artifact,status:$status,confidence_percent:$confidence,evidence_excerpt:$evidence,staleness_note:null,reason:$reason,action:$action,classification:$classification}"]
  then save to report_path
then cat with path report_path
