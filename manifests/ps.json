{
  "name": "ps",
  "description": "Lists process information using the selected platform ps flags.",
  "binary": "ps",
  "cacheable": false,
  "parameters": {
    "flags": {
      "type": "list",
      "items": "string"
    }
  },
  "arguments": [
    {
      "when_present": "flags",
      "append": [
        {
          "spread": "flags"
        }
      ]
    }
  ]
}
