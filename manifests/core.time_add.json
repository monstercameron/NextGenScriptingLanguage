{
  "name": "time.add",
  "description": "Adds a signed duration to a Unix epoch timestamp in seconds and returns the resulting epoch second.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "amount": {
      "type": "integer",
      "required": true,
      "description": "Signed quantity of the selected time unit to add."
    },
    "unit": {
      "type": "string",
      "required": true,
      "enum": [
        "seconds",
        "minutes",
        "hours",
        "days"
      ],
      "description": "Duration unit for amount: seconds, minutes, hours, or days."
    },
    "epoch": {
      "type": "integer",
      "required": true,
      "description": "Starting Unix timestamp in whole seconds."
    }
  },
  "arguments": [
    {
      "literal": "time.add"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "integer"
    },
    "capabilities": [
      "clock.read"
    ],
    "effects": [
      "clock.read"
    ],
    "ports": {
      "inputs": {
        "amount": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "unit": {
          "schema": {
            "type": "text",
            "enum": [
              "seconds",
              "minutes",
              "hours",
              "days"
            ]
          },
          "delivery": "single"
        },
        "epoch": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "integer"
          }
        }
      }
    }
  },
  "phrases": [
    "time add"
  ],
  "examples": [
    {
      "program": "run time.add with epoch 0 and amount 2 and unit \"days\" as value",
      "expected_output": 172800
    }
  ]
}
