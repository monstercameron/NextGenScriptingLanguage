{
  "name": "fs.ensure_file",
  "description": "Creates or replaces a text file only when its content or requested mode differs, using a locked compare-and-swap write.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "path": {
      "type": "path",
      "required": true,
      "description": "File path to create or update; relative paths resolve from the program working directory."
    },
    "content": {
      "type": "string",
      "required": true,
      "description": "Exact UTF-8 text that the file should contain."
    },
    "mode": {
      "type": "string",
      "pattern": "octal_mode",
      "description": "Optional octal permission text, such as 0644, to apply on Unix; omitted preserves the current mode."
    }
  },
  "arguments": [
    {
      "literal": "fs.ensure_file"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "record",
      "encoding": "json",
      "fields": {
        "changed": {
          "type": "boolean"
        },
        "path": {
          "type": "text"
        },
        "mode_applied": {
          "type": "boolean"
        }
      },
      "required": [
        "changed",
        "path",
        "mode_applied"
      ]
    },
    "capabilities": [
      "filesystem.read",
      "filesystem.write",
      "filesystem.lock"
    ],
    "effects": [
      "filesystem.write",
      "filesystem.lock"
    ],
    "ports": {
      "inputs": {
        "path": {
          "schema": {
            "type": "path"
          },
          "delivery": "single"
        },
        "content": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "mode": {
          "schema": {
            "type": "text",
            "pattern": "octal_mode"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "record",
            "fields": {
              "changed": {
                "type": "boolean"
              },
              "path": {
                "type": "text"
              },
              "mode_applied": {
                "type": "boolean"
              }
            },
            "required": [
              "changed",
              "path",
              "mode_applied"
            ]
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "fs ensure_file"
  ],
  "examples": [
    {
      "program": "run fs.ensure_file with path \"catalog-example.txt\" and content \"ready\\n\" as result",
      "expected_output": {
        "changed": true,
        "path": "catalog-example.txt",
        "mode_applied": false
      }
    }
  ]
}
