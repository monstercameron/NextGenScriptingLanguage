{
  "name": "tail.follow",
  "description": "Provides the tail follow operation for controlled scripts.",
  "phrases": [
    "follow file"
  ],
  "binary": "tail",
  "cacheable": false,
  "parameters": {
    "path": {
      "type": "string",
      "required": true
    }
  },
  "arguments": [
    {
      "literal": "-n"
    },
    {
      "literal": "0"
    },
    {
      "literal": "-F"
    },
    {
      "literal": "--"
    },
    {
      "parameter": "path"
    }
  ]
}
