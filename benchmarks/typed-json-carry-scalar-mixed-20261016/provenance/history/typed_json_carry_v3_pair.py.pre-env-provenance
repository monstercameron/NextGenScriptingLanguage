class PairError(RuntimeError):
    """A frozen-input, invocation, or benchmark-contract failure."""


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def sha_bytes(payload: bytes) -> str:
    return hashlib.sha256(payload).hexdigest()


def sha_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def _unique_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate JSON key: {key}")
        result[key] = value
    return result


def _reject_constant(value: str) -> None:
    raise ValueError(f"non-finite JSON constant: {value}")


def strict_json_bytes(payload: bytes, label: str) -> Any:
    if len(payload) > MAX_JSON_BYTES:
        raise PairError(f"{label} exceeds {MAX_JSON_BYTES} bytes")
    try:
        return json.loads(
            payload.decode("utf-8"),
            object_pairs_hook=_unique_object,
            parse_constant=_reject_constant,
        )
    except (UnicodeDecodeError, json.JSONDecodeError, ValueError) as error:
        raise PairError(f"{label} is not strict UTF-8 JSON: {error}") from error


def load_json(path: Path, label: str) -> Any:
    try:
        payload = path.expanduser().resolve(strict=True).read_bytes()
    except OSError as error:
        raise PairError(f"cannot read {label}: {error}") from error
    return strict_json_bytes(payload, label)


def write_json(path: Path, value: Any, *, exclusive: bool = False) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    encoded = (json.dumps(value, sort_keys=True, indent=2, allow_nan=False) + "\n").encode("utf-8")
    if exclusive:
        with path.open("xb") as stream:
            stream.write(encoded)
            stream.flush()
            os.fsync(stream.fileno())
        return
    temporary = path.with_name(path.name + ".tmp")
    with temporary.open("xb") as stream:
        stream.write(encoded)
        stream.flush()
        os.fsync(stream.fileno())
    temporary.replace(path)


def write_bytes_new(path: Path, payload: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("xb") as stream:
        stream.write(payload)
        stream.flush()
        os.fsync(stream.fileno())


def git(root: Path, *arguments: str) -> bytes:
    try:
        result = subprocess.run(
            ["git", "-C", str(root), *arguments],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=20,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise PairError(f"cannot inspect {root}: {error}") from error
    if result.returncode:
        raise PairError(result.stderr.decode("utf-8", errors="replace").strip())
    return result.stdout


def listed_source_paths(root: Path) -> list[str]:
    tracked = git(root, "ls-files", "-z").split(b"\0")
    untracked = git(root, "ls-files", "--others", "--exclude-standard", "-z").split(b"\0")
    return sorted({os.fsdecode(item) for item in tracked + untracked if item})


def source_fingerprint(root: Path) -> dict[str, Any]:
    files: dict[str, str] = {}
    for relative in listed_source_paths(root):
        path = root / relative
        if path.is_symlink():
            data = b"symlink\0" + os.fsencode(os.readlink(path))
        else:
            try:
                data = path.read_bytes()
            except OSError as error:
                raise PairError(f"cannot fingerprint source {relative}: {error}") from error
        files[relative] = sha_bytes(data)
    canonical = json.dumps(files, sort_keys=True, separators=(",", ":")).encode()
    return {"sha256": sha_bytes(canonical), "file_count": len(files), "files": files}


def diff_sha256(root: Path, *, staged: bool = False) -> str:
    args = ("diff", "--cached", "--binary") if staged else ("diff", "--binary")
    return sha_bytes(git(root, *args))


def _expect(condition: bool, message: str) -> None:
    if not condition:
        raise PairError(message)


def _exact_bool(value: Any, expected: bool) -> bool:
    return type(value) is bool and value is expected


def validate_artifact_row(
    artifact: Any,
    *,
    side: str,
    root: Path,
    target_name: str,
    expected_source: Path,
    test_profile: bool,
    target_dir: Path,
    executable_subdirectory: Path = Path("release/deps"),
) -> Path:
    _expect(isinstance(artifact, dict), f"{side}/{target_name} Cargo artifact is not an object")
    target = artifact.get("target")
    profile = artifact.get("profile")
    _expect(isinstance(target, dict) and isinstance(profile, dict), f"{side}/{target_name} lacks target/profile")
    _expect(artifact.get("reason") == "compiler-artifact", f"{side}/{target_name} is not compiler-artifact metadata")
    _expect(artifact.get("fresh") is False, f"{side}/{target_name} was fresh/reused")
    _expect(target.get("name") == target_name, f"{side}/{target_name} target name mismatch")
    expected_kind = ["lib"] if target_name == "flow" else (["test"] if test_profile else ["bin"])
    _expect(target.get("kind") == expected_kind, f"{side}/{target_name} Cargo target kind mismatch")
    _expect(type(target.get("test")) is bool and target["test"] is test_profile, f"{side}/{target_name} target test flag mismatch")
    _expect(type(profile.get("test")) is bool and profile["test"] is test_profile, f"{side}/{target_name} profile test flag mismatch")
    _expect(profile.get("opt_level") == "3" and profile.get("debug_assertions") is False, f"{side}/{target_name} is not optimized release")
    _expect(Path(artifact.get("manifest_path", "")).resolve() == (root / "Cargo.toml").resolve(), f"{side}/{target_name} manifest path mismatch")
    _expect(Path(target.get("src_path", "")).resolve() == (root / expected_source).resolve(), f"{side}/{target_name} source path mismatch")
    expected_package = f"path+{root.as_uri()}#execute@"
    _expect(isinstance(artifact.get("package_id"), str) and artifact["package_id"].startswith(expected_package), f"{side}/{target_name} package identity mismatch")
    executable = artifact.get("executable")
    filenames = artifact.get("filenames")
    _expect(isinstance(executable, str) and isinstance(filenames, list) and executable in filenames, f"{side}/{target_name} executable is not named by Cargo")
    binary = Path(executable).resolve()
    _expect(binary.is_file(), f"{side}/{target_name} Cargo binary is missing")
    _expect(binary.is_relative_to(target_dir.resolve() / executable_subdirectory), f"{side}/{target_name} is outside {executable_subdirectory}")
    return binary


def validate_helper_artifact(artifact: Any, *, side: str, root: Path, target_dir: Path) -> Path:
    binary = validate_artifact_row(
