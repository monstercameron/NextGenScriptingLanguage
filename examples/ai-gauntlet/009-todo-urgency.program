# Purpose: Score one TODO against an explicit deadline.
# Inputs: source_path, fixture paths, live=false.
# Outputs: out/009.json; candidate only; model text is never command code.
# Bash would need: deadline parsing, urgency heuristics and a calibrated review branch.
accept source_path as text with default "fixtures/009/source.txt"
accept fixture as text with default "fixtures/009/confident.json"
accept live as boolean with default false
try
  read source_path
  if live is true
    then jev.score with question "Rate urgency: low means cosmetic, medium means this week, high means blocking work within 24 hours." and levels ["low","medium","high"] and minimum 80 and timeout_ms 3000 and max_bytes 65536 as raw
  otherwise
    then jev.score with question "Rate urgency: low means cosmetic, medium means this week, high means blocking work within 24 hours." and levels ["low","medium","high"] and minimum 80 and timeout_ms 3000 and max_bytes 65536 and fixture fixture as raw
  then parse json as verdict
  take boolean at "/accepted" from verdict as accepted
  take integer at "/confidence_percent" from verdict as confidence
  take json at "/score" from verdict as score_value
  run number.compare with left score_value and right 1 as score_order
  if accepted is true
    if score_order is 1
      run json.set with document {"action":"Review against the original input before acting.","result":null,"status":"candidate-for-review"} and pointer "/result" and value "review this TODO before routine cleanup"
    otherwise
      run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
  otherwise
    run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
catch failure
  run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
then save to "out/009.json"
