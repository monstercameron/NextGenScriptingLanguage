    def test_timeout_is_retained_once_without_retry_and_captures_partial_streams(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            test_binary = root / "test-binary"
            helper_binary = root / "execute-applet"
            test_binary.write_bytes(b"immutable test binary")
            helper_binary.write_bytes(b"immutable helper")
            test_binary.chmod(0o555)
            helper_binary.chmod(0o555)
            test_hash = hashlib.sha256(test_binary.read_bytes()).hexdigest()
            helper_hash = hashlib.sha256(helper_binary.read_bytes()).hexdigest()
            identity = {
                "root": str(root),
                "opt_test_binary": {"binary": str(test_binary), "binary_sha256": test_hash},
                "helper": {"binary": str(helper_binary), "binary_sha256": helper_hash},
            }
            attempt_dir = root / "attempt"
            timeout = subprocess.TimeoutExpired(
                cmd=[str(test_binary)],
                timeout=pair.INVOCATION_TIMEOUT_SECONDS,
                output=b"partial stdout",
                stderr=b"partial stderr",
            )
            with mock.patch.object(pair.subprocess, "run", side_effect=timeout) as run_mock:
                result = pair.run_attempt(identity, attempt_dir, {"attempt_id": "timeout-test"})
            self.assertEqual(run_mock.call_count, 1)
            self.assertEqual(run_mock.call_args.kwargs["timeout"], 120)
            self.assertFalse(result["successful"])
            self.assertTrue(result["timed_out"])
            self.assertEqual(result["returncode"], None)
            self.assertEqual((attempt_dir / "stdout.bin").read_bytes(), b"partial stdout")
            self.assertEqual((attempt_dir / "stderr.bin").read_bytes(), b"partial stderr")
            self.assertFalse(result["raw_report_present"])
            self.assertIn("did not create", result["raw_validation_error"])

    def test_pair_requires_same_workload_and_success(self):
        okay = {
            "successful": True,
            "workload": {"catalog_sha256": "a" * 64},
            "median_duration_ns": 10,
        }
        candidate = {**okay, "median_duration_ns": 8}
        result = pair.pair_result(0, "measurement", 1, ("baseline", "candidate"),
                                  {"baseline": okay, "candidate": candidate})
        self.assertTrue(result["valid_for_timing"])
        self.assertEqual(result["candidate_minus_baseline_ns"], -2)
        candidate["workload"] = {"catalog_sha256": "b" * 64}
        result = pair.pair_result(0, "measurement", 1, ("baseline", "candidate"),
                                  {"baseline": okay, "candidate": candidate})
        self.assertFalse(result["valid_for_timing"])


