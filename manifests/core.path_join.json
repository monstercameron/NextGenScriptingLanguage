{
  "name": "path.join",
  "description": "Joins path segments with the host platform separator, skipping empty segments and following the host path library when an absolute segment appears.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "parts": {
      "type": "list",
      "items": "string",
      "required": true,
      "description": "Path segments in order; empty strings are skipped and an absolute segment replaces the preceding path."
    }
  },
  "arguments": [
    {
      "literal": "path.join"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "json"
    },
    "capabilities": [
      "path.inspect"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "parts": {
          "schema": {
            "type": "list",
            "items": {
              "type": "text"
            }
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "path join"
  ],
  "examples": [
    {
      "program": "run path.join with parts [\"\", \"config\", \"\"] as value",
      "expected_output": "config"
    }
  ]
}
