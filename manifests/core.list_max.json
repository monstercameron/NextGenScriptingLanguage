{
  "name": "list.max",
  "description": "Return the largest numeric value in a nonempty list.",
  "phrases": [
    "maximum value",
    "largest number"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "items": {
      "type": "list",
      "items": "json",
      "description": "List of numeric JSON values to compare."
    },
    "key": {
      "type": "string",
      "description": "Accepted for compatibility; this numeric maximum operation compares each list value directly."
    },
    "n": {
      "type": "integer",
      "description": "Accepted for compatibility; this operation returns one value rather than a top-N list."
    },
    "collect": {
      "type": "boolean",
      "description": "Accepted for compatibility; this operation returns only the maximum."
    },
    "delimiter": {
      "type": "string",
      "description": "Accepted for compatibility; this operation does not split input fields."
    },
    "field": {
      "type": "integer",
      "description": "Accepted for compatibility; this operation does not select an input field."
    }
  },
  "arguments": [
    {
      "literal": "list.max"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "json",
      "encoding": "json",
      "same_as_parameter": "items"
    },
    "capabilities": [
      "data.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "items": {
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          },
          "delivery": "single"
        },
        "key": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "n": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "collect": {
          "schema": {
            "type": "boolean"
          },
          "delivery": "single"
        },
        "delimiter": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "field": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        }
      }
    }
  },
  "examples": [
    {
      "program": "run list.max with items [4, 9, 2] as result",
      "expected_output": 9
    }
  ]
}
