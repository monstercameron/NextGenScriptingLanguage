{
  "name": "hash.sha256",
  "description": "Computes the lowercase SHA-256 digest of text or input-stream bytes and returns 64 hexadecimal characters.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "required": false,
      "description": "Optional text to hash; when omitted, the applet hashes bytes from its input stream."
    }
  },
  "arguments": [
    {
      "literal": "hash.sha256"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "text"
    },
    "capabilities": [
      "hash.compute"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        }
      }
    }
  },
  "phrases": [
    "hash sha256"
  ],
  "examples": [
    {
      "program": "run hash.sha256 with text \"abc\" as digest",
      "expected_output": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
    }
  ]
}
