{
  "name": "list.count",
  "description": "Count the input list elements, or count input lines when no items list is supplied.",
  "phrases": [
    "count items",
    "count values",
    "count list"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "items": {
      "type": "list",
      "items": "json",
      "description": "Optional JSON list whose top-level elements are counted; when omitted, stdin lines are counted."
    },
    "key": {
      "type": "string",
      "description": "Accepted for compatibility; this counting operation does not inspect object fields."
    },
    "n": {
      "type": "integer",
      "description": "Accepted for compatibility; this operation does not limit the number of items."
    },
    "collect": {
      "type": "boolean",
      "description": "Accepted for compatibility; this operation returns only the count."
    },
    "delimiter": {
      "type": "string",
      "description": "Accepted for compatibility; this operation does not split input fields."
    },
    "field": {
      "type": "integer",
      "description": "Accepted for compatibility; this operation does not select an input field."
    }
  },
  "arguments": [
    {
      "literal": "list.count"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "integer",
      "encoding": "json"
    },
    "capabilities": [
      "data.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "items": {
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          },
          "delivery": "single"
        },
        "key": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "n": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "collect": {
          "schema": {
            "type": "boolean"
          },
          "delivery": "single"
        },
        "delimiter": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "field": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        }
      }
    }
  },
  "examples": [
    {
      "program": "run list.count with items [\"a\", \"b\", \"a\"] as result",
      "expected_output": 3
    }
  ]
}
