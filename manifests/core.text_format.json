{
  "name": "text.format",
  "description": "Substitutes named values in a template and escapes each scalar using the required plain, JSON, shell, URL, CSV, HTML, or regex mode.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "template": {
      "type": "string",
      "required": true,
      "description": "Template containing `{{name}}` placeholders to fill from values."
    },
    "values": {
      "type": "record",
      "required": true,
      "fields": {},
      "additional_properties": {
        "type": "scalar"
      },
      "description": "Record of scalar values addressed by placeholder name."
    },
    "escape": {
      "type": "string",
      "required": true,
      "enum": [
        "plain",
        "json",
        "shell",
        "url",
        "csv",
        "html",
        "regex"
      ],
      "description": "Escaping applied to each substituted scalar: plain, json, shell, url, csv, html, or regex."
    }
  },
  "arguments": [
    {
      "literal": "text.format"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "json"
    },
    "capabilities": [
      "text.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "template": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "values": {
          "schema": {
            "type": "record",
            "fields": {},
            "additionalProperties": {
              "type": "json",
              "scalar_only": true
            }
          },
          "delivery": "single"
        },
        "escape": {
          "schema": {
            "type": "text",
            "enum": [
              "plain",
              "json",
              "shell",
              "url",
              "csv",
              "html",
              "regex"
            ]
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "format template",
    "escape text",
    "build safe text"
  ],
  "examples": [
    {
      "program": "run text.format with template \"Hello, {{name}}\" and values {\"name\": \"Ada\"} and escape \"plain\" as value",
      "expected_output": "Hello, Ada"
    }
  ]
}
