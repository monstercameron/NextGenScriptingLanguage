# Purpose: Extract a file rename proposal without changing files.
# Inputs: source_path, fixture paths, live=false.
# Outputs: out/021.json; candidate only; model text is never command code.
# Bash would need: phrase variants, filename extraction and JSON escaping before a review step.
accept source_path as text with default "fixtures/021/source.txt"
accept fixture as text with default "fixtures/021/confident.json"
accept live as boolean with default false
accept result_fixture as text with default "fixtures/021/result.json"
accept schema_path as text with default "fixtures/021/schema.json"
try
  read source_path
  if live is true
    then jev.judge with question "Does this request explicitly name an old and new basename, with no directory move?" and minimum 80 and timeout_ms 3000 and max_bytes 65536 as raw # execute-allow: lint.unused_binding intentional model-result capture for acceptance analysis and downstream parsing
  otherwise
    then jev.judge with question "Does this request explicitly name an old and new basename, with no directory move?" and minimum 80 and timeout_ms 3000 and max_bytes 65536 and fixture fixture as raw
  then parse json as verdict
  take boolean at "/accepted" from verdict as accepted
  take integer at "/confidence_percent" from verdict as confidence # execute-allow: lint.unused_binding intentional typed take validates the model confidence field
  take boolean at "/decision" from verdict as decision
  if accepted is true
    if decision is true
      read schema_path as schema_text
      read source_path
      if live is true
        then llm.extract with model "gpt-6-luna" and instruction "Extract the old and new basenames and action propose. Never perform a rename." and schema schema_text and timeout_ms 3000 and max_bytes 65536 as result_raw # execute-allow: lint.unused_binding intentional generated-text capture for review validation and downstream parsing
      otherwise
        then llm.extract with model "gpt-6-luna" and instruction "Extract the old and new basenames and action propose. Never perform a rename." and schema schema_text and timeout_ms 3000 and max_bytes 65536 and fixture result_fixture as result_raw
      then parse json as generated
      take json at "/value" from generated as content
      take text at "/value/old" from generated as field_old # execute-allow: lint.unused_binding intentional typed take validates a required extracted field
      take text at "/value/new" from generated as field_new # execute-allow: lint.unused_binding intentional typed take validates a required extracted field
      take text at "/value/action" from generated as field_action # execute-allow: lint.unused_binding intentional typed take validates a required extracted field
      run json.set with document {"action":"Review against the original input before acting.","result":null,"status":"candidate-for-review"} and pointer "/result" and value content
    otherwise
      run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
  otherwise
    run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
catch failure # execute-allow: lint.unused_binding intentional catch control binding; recovery uses the handler path rather than the error value
  run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
then save to "out/021.json"
