{
  "name": "menu.gum_confirm",
  "description": "Provides the menu gum confirm operation for controlled scripts.",
  "binary": "gum",
  "accepts_stdin": false,
  "cacheable": false,
  "parameters": {
    "prompt": {
      "type": "string",
      "required": true
    },
    "flags": {
      "type": "list",
      "items": "string"
    }
  },
  "arguments": [
    {
      "literal": "confirm"
    },
    {
      "when_present": "flags",
      "append": [
        {
          "spread": "flags"
        }
      ]
    },
    {
      "literal": "--"
    },
    {
      "parameter": "prompt"
    }
  ],
  "contract": {
    "version": 1,
    "backend": "command",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "raw",
      "trim_final_lf": true
    },
    "outcomes": [
      {
        "status": 0,
        "name": "confirmed",
        "kind": "success"
      },
      {
        "status": 1,
        "name": "declined",
        "kind": "absence"
      },
      {
        "status": 130,
        "name": "cancelled",
        "kind": "absence"
      },
      {
        "status": 127,
        "name": "not_found",
        "kind": "absence"
      }
    ],
    "result_envelope": true,
    "capabilities": [
      "ui.prompt"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "prompt": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "flags": {
          "schema": {
            "type": "list",
            "items": {
              "type": "text"
            }
          },
          "delivery": "single"
        }
      }
    }
  }
}
