{
  "name": "number.format_size",
  "description": "Provides number.format_size for controlled scripts.",
  "phrases": [
    "number format_size",
    "value format_size"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "value": {
      "type": "json",
      "required": true
    },
    "precision": {
      "type": "integer"
    },
    "system": {
      "type": "string",
      "enum": [
        "si",
        "iec"
      ]
    }
  },
  "arguments": [
    {
      "literal": "number.format_size"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "text"
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "number",
            "minimum": 0
          }
        },
        "precision": {
          "delivery": "single",
          "schema": {
            "type": "integer"
          }
        },
        "system": {
          "delivery": "single",
          "schema": {
            "type": "text",
            "enum": [
              "si",
              "iec"
            ]
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        }
      }
    },
    "capabilities": [
      "number.compute"
    ]
  },
  "parameter_alternatives": [
    {
      "message": "precision must be an integer from 0 through 6",
      "any_of": [
        [
          {
            "test": "absent",
            "parameter": "precision"
          }
        ],
        [
          {
            "test": "number_range",
            "parameter": "precision",
            "minimum": 0,
            "maximum": 6
          }
        ]
      ]
    }
  ]
}
