{
  "name": "number.to_text",
  "description": "Convert a finite JSON number to locale-independent decimal text without coercing strings.",
  "binary": "@execute-applet",
  "cacheable": true,
  "accepts_stdin": false,
  "parameters": {
    "value": {
      "type": "json",
      "required": true,
      "description": "Finite JSON number to render as text."
    }
  },
  "arguments": [
    {
      "literal": "number.to_text"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "json"
    },
    "capabilities": [
      "number.convert"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "value": {
          "schema": {
            "type": "number"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "number to_text"
  ],
  "examples": [
    {
      "program": "run number.to_text with value 12.5 as result",
      "expected_output": "12.5"
    }
  ]
}
