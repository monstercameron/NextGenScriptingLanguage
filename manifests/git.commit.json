{
  "name": "git.commit",
  "description": "Provides the git commit operation for controlled scripts.",
  "phrases": [
    "commit changes"
  ],
  "binary": "git",
  "parameters": {
    "message": {
      "type": "string",
      "required": true
    },
    "files": {
      "type": "list",
      "items": "string",
      "min_items": 1
    }
  },
  "arguments": [
    {
      "literal": "commit"
    },
    {
      "literal": "-m"
    },
    {
      "parameter": "message"
    },
    {
      "when_present": "files",
      "append": [
        {
          "literal": "--only"
        },
        {
          "literal": "--"
        },
        {
          "spread": "files"
        }
      ]
    }
  ]
}
