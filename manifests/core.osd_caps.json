{
  "name": "osd.caps",
  "description": "Provides the osd caps operation for controlled scripts.",
  "binary": "swayosd-client",
  "accepts_stdin": false,
  "cacheable": false,
  "parameters": {},
  "arguments": [
    {
      "literal": "--caps-lock"
    }
  ],
  "contract": {
    "version": 1,
    "backend": "command",
    "lifecycle": {
      "kind": "oneshot"
    },
    "outcomes": [
      {
        "status": 0,
        "name": "success",
        "kind": "success"
      },
      {
        "status": 127,
        "name": "not_found",
        "kind": "absence"
      }
    ],
    "capabilities": [
      "desktop.osd"
    ],
    "effects": [
      "desktop.osd"
    ]
  }
}
