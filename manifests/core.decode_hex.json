{
  "name": "decode.hex",
  "description": "Decodes an even-length hexadecimal byte string and returns the decoded bytes as UTF-8 text.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "text": {
      "type": "string",
      "required": true,
      "description": "Hexadecimal byte pairs to decode; the decoded bytes must form valid UTF-8."
    }
  },
  "arguments": [
    {
      "literal": "decode.hex"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "text"
    },
    "capabilities": [
      "text.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        }
      }
    }
  },
  "phrases": [
    "decode hex"
  ],
  "examples": [
    {
      "program": "run decode.hex with text \"486921\" as decoded",
      "expected_output": "Hi!"
    }
  ]
}
