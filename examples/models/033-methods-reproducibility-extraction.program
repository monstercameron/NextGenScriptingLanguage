# Purpose: Extract reproducibility details from methods sections. Derive local evidence, gate model assistance, validate cited text, and save a human-review artifact.
# Inputs: local source paths, offline fixtures, selected model, and private environment file.
# Outputs: out/033-methods-reproducibility-extraction.json; no source files are modified.
accept live as boolean with default false
accept source_path as text with default "fixtures/033/high/source.json"
accept report_path as text with default "out/033-methods-reproducibility-extraction.json"
accept classify_fixture_path as text with default "fixtures/033/classify-high.json"
accept draft_fixture_path as text with default "fixtures/033/draft-high.json"
accept generator_model as text with default "gpt-6-luna"
accept env_file as text with default ".env"
accept schema_path as text with default "fixtures/033/schema.json"
accept evidence_id as text
# Refuse an output path that aliases an existing evidence or schema file.
run "test" with arguments ["!", source_path, "-ef", report_path]
run "test" with arguments ["!", schema_path, "-ef", report_path]
read schema_path as schema
run cat with path source_path
then "jq" with arguments ["-c", "-S", "--", ". as $d|{section_id,methods_text,evidence_id:$d.evidence_id,checked_fact:$d.checked_fact,case_note:$d.case_note}"] as evidence
if live is true
  then jev.classify with question "Does the local evidence support a bounded extract reproducibility details from methods sections draft?" and labels ["draft","human-review"] and minimum 80 and env_file env_file as class_raw # execute-allow: lint.unused_binding intentional model-result capture for acceptance analysis and downstream parsing
otherwise
  then jev.classify with question "Does the local evidence support a bounded extract reproducibility details from methods sections draft?" and labels ["draft","human-review"] and minimum 80 and fixture classify_fixture_path and env_file env_file as class_raw
then parse json as decision
take text at "/label" from decision as label
take integer at "/confidence_percent" from decision as confidence
take boolean at "/accepted" from decision as accepted
if accepted is true
  if label is "draft"
    then "printf" with arguments ["%s", evidence] as bounded # execute-allow: lint.unused_binding intentional evidence capture keeps model input off stdout
    if live is true
      then llm.extract with model generator_model and instruction "Return only a JSON object with section_id, sample_size, instrument, seed, and missing_fields from the supplied methods evidence. Use null for unstated values, cite no unsupported facts, and do not infer." and schema schema and env_file env_file as raw # execute-allow: lint.unused_binding intentional model-result capture for acceptance analysis and downstream parsing
    otherwise
      then llm.extract with model generator_model and instruction "Return only a JSON object with section_id, sample_size, instrument, seed, and missing_fields from the supplied methods evidence. Use null for unstated values, cite no unsupported facts, and do not infer." and schema schema and fixture draft_fixture_path and env_file env_file as raw
    then parse json as generated
    take json at "/value" from generated as extracted_value
    then encode extracted_value as json
    then "jq" with arguments ["-c", "-S", "--arg", "evidence", evidence, "--arg", "evidence_id", evidence_id, "--argjson", "confidence", confidence, "--", ". as $x | ($evidence|fromjson) as $e | if (($x|keys|sort)==[\"instrument\",\"missing_fields\",\"sample_size\",\"section_id\",\"seed\"]) and ($x.section_id==$e.section_id) and (($x.sample_size==null) or (($x.sample_size|type)==\"number\")) and (($x.seed==null) or (($x.seed|type)==\"number\")) and (($x.instrument==null) or (($x.instrument|type)==\"string\")) then {workflow:\"methods-reproducibility-extraction\",status:\"draft-for-human-review\",confidence_percent:$confidence,evidence_id:$evidence_id,section_id:$x.section_id,sample_size:$x.sample_size,instrument:$x.instrument,seed:$x.seed,missing_fields:$x.missing_fields,evidence_excerpt:$evidence,action:\"A methods reviewer verifies extracted values against the original section.\"} else error(\"extraction failed schema and evidence checks\") end"] as report # execute-allow: lint.unused_binding intentional serialized report capture keeps review data off stdout before save
    then save to report_path
  otherwise
    run "jq" with arguments ["-n", "-c", "-S", "--arg", "workflow", "methods-reproducibility-extraction", "--arg", "status", "needs-human-review", "--arg", "classification", label, "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "--arg", "reason", "Classifier selected human-review; no generation was requested.", "--arg", "action", "A reviewer determines whether any draft is appropriate.", "--", "{workflow:$workflow,status:$status,classification:$classification,confidence_percent:$confidence,evidence_excerpt:$evidence,proposed_analysis:null,reason:$reason,action:$action}"] as report
    then save to report_path
otherwise
  run "jq" with arguments ["-n", "-c", "-S", "--arg", "workflow", "methods-reproducibility-extraction", "--arg", "status", "needs-human-review", "--arg", "classification", label, "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "--arg", "reason", "Confidence is below 80 percent; no generation was requested.", "--arg", "action", "A reviewer checks original records and decides the next step.", "--", "{workflow:$workflow,status:$status,classification:$classification,confidence_percent:$confidence,evidence_excerpt:$evidence,proposed_analysis:null,reason:$reason,action:$action}"] as report
  then save to report_path
then cat with path report_path
