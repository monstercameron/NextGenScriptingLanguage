{
  "name": "text.starts_with",
  "description": "Provides text.starts_with for controlled scripts.",
  "phrases": [
    "check text prefix"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string"
    },
    "prefix": {
      "type": "string",
      "required": true
    }
  },
  "arguments": [
    {
      "literal": "text.starts_with"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "boolean"
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        },
        "prefix": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "boolean"
          }
        }
      }
    },
    "capabilities": [
      "text.transform"
    ]
  }
}
