{
  "name": "count.lines",
  "description": "Counts newline-delimited records from standard input and prints the total.",
  "phrases": [
    "count lines"
  ],
  "binary": "wc",
  "accepts_stdin": true,
  "cacheable": true,
  "arguments": [
    {
      "literal": "-l"
    }
  ],
  "contract": {
    "version": 1,
    "backend": "command",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "raw"
    },
    "capabilities": [
      "process.exec"
    ],
    "effects": []
  }
}
