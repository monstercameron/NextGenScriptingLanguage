# Purpose: Assemble a cross-shift handoff from local evidence; prepare bounded evidence and save a review-only model-assisted report.
# Inputs: local source.json evidence, explicit model fixtures, and a private empty environment file.
# Outputs: out/shift-handoff.json; the workflow never changes the source evidence.
accept source_path as text with default "fixtures/008/source.json"
accept report_path as text with default "out/shift-handoff.json"
accept classify_fixture_path as text with default "fixtures/008/classify-evidence-ready.json"
accept draft_fixture_path as text with default "fixtures/008/draft.json"
accept generator_model as text with default "gpt-6-luna"
accept env_file as text with default ".env"
accept live as boolean with default false
# Refuse an output path that aliases an existing evidence or schema file.
run "test" with arguments ["!", source_path, "-ef", report_path]
run cat with path source_path
then jq with flags ["-c", "-S"] and filter ". as $d | {handoff:$d.handoff,open_cases:[$d.cases[]|select(.status!=\"resolved\")]|sort_by(.updated)}" as evidence
if live is true
  then jev.classify with question "Does the packet contain unresolved cases that need an explicit next-shift handoff?" and labels ["evidence-ready", "insufficient-evidence"] and minimum 80 and env_file env_file as raw
otherwise
  then jev.classify with question "Does the packet contain unresolved cases that need an explicit next-shift handoff?" and labels ["evidence-ready", "insufficient-evidence"] and minimum 80 and fixture classify_fixture_path and env_file env_file as raw
then parse json as decision
take text at "/label" from decision as label
take boolean at "/accepted" from decision as accepted
take integer at "/confidence_percent" from decision as confidence
if accepted is true
  if label is "evidence-ready"
    run cat with path source_path
    then jq with flags ["-c", "-S"] and filter ". as $d | {handoff:$d.handoff,open_cases:[$d.cases[]|select(.status!=\"resolved\")]|sort_by(.updated)}"
    if live is true
      then llm.ask with model generator_model and instruction "Draft an open-case handoff from SHIFT-7. Keep owner, update time, and last recorded note distinct; do not state that a case is resolved unless the source says so." and env_file env_file as draft_raw
    otherwise
      then llm.ask with model generator_model and instruction "Draft an open-case handoff from SHIFT-7. Keep owner, update time, and last recorded note distinct; do not state that a case is resolved unless the source says so." and fixture draft_fixture_path and env_file env_file as draft_raw
    then parse json as generated
    take text at "/text" from generated as draft
    run jq with flags ["-n", "-r", "-j", "--arg", "draft", draft, "--arg", "evidence", evidence] and filter "if ($draft | startswith(\"EVIDENCE:\")) and ([$evidence | scan(\"[A-Z][A-Z0-9]+-[A-Z0-9-]+\") | . as $id | select($draft | contains($id))] | length > 0) then $draft else error(\"draft must start with EVIDENCE and cite an ID in bounded local evidence\") end" as validated_draft
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "shift_handoff_packet", "--arg", "status", "draft-for-human-review", "--arg", "classification", label, "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "--arg", "handoff_note", validated_draft, "--arg", "action", "A human owner reviews this proposed analysis before acting.", "{artifact:$artifact,status:$status,confidence_percent:$confidence,evidence_excerpt:$evidence,handoff_note:$handoff_note,action:$action,classification:$classification}"]
    then save to report_path
  otherwise
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "shift_handoff_packet", "--arg", "status", "needs-human-review", "--arg", "classification", label, "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "--arg", "reason", "The accepted result did not match this workflow’s positive label, decision, or score level; generated analysis was withheld.", "--arg", "action", "An owner checks the original records and decides the next step.", "{artifact:$artifact,status:$status,confidence_percent:$confidence,evidence_excerpt:$evidence,handoff_note:null,reason:$reason,action:$action,classification:$classification}"]
    then save to report_path
otherwise
  then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "shift_handoff_packet", "--arg", "status", "needs-human-review", "--arg", "classification", label, "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "--arg", "reason", "The model signal is below the configured 80 percent floor; no generated analysis was requested.", "--arg", "action", "An owner checks the original records and decides the next step.", "{artifact:$artifact,status:$status,confidence_percent:$confidence,evidence_excerpt:$evidence,handoff_note:null,reason:$reason,action:$action,classification:$classification}"]
  then save to report_path
then cat with path report_path
