{
  "name": "time.now",
  "description": "Returns the current clock time as Unix seconds, milliseconds, nanoseconds, and an RFC 3339 UTC string; an explicit epoch makes the result deterministic.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "epoch_s": {
      "type": "integer",
      "required": false,
      "description": "Optional fixed Unix timestamp in seconds for a deterministic result; omitted reads the system clock."
    }
  },
  "arguments": [
    {
      "literal": "time.now"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "json"
    },
    "capabilities": [
      "clock.read"
    ],
    "effects": [
      "clock.read"
    ],
    "ports": {
      "inputs": {
        "epoch_s": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "json"
          }
        }
      }
    }
  },
  "phrases": [
    "time now"
  ],
  "examples": [
    {
      "program": "run time.now with epoch_s 0 as value",
      "expected_output": {
        "epoch_s": 0,
        "epoch_ms": 0,
        "epoch_ns": 0,
        "iso": "1970-01-01T00:00:00Z"
      }
    }
  ]
}
