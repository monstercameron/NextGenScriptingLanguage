{
  "name": "paste",
  "description": "Merges corresponding lines from two or more files, using the selected paste flags.",
  "binary": "paste",
  "parameters": {
    "flags": {
      "type": "list",
      "items": "string"
    },
    "files": {
      "type": "list",
      "items": "string",
      "required": true,
      "min_items": 2
    }
  },
  "arguments": [
    {
      "when_present": "flags",
      "append": [
        {
          "spread": "flags"
        }
      ]
    },
    {
      "literal": "--"
    },
    {
      "spread": "files"
    }
  ],
  "contract": {
    "version": 1,
    "backend": "command",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "raw"
    },
    "capabilities": [
      "process.exec",
      "filesystem.read"
    ],
    "effects": [
      "filesystem.read"
    ]
  }
}
