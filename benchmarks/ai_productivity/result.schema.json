{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://execute.invalid/schemas/ai-productivity-result-1.json",
  "title": "One blinded AI productivity evaluation trial",
  "type": "object",
  "required": ["schema", "trial_type", "run_id", "blind_arm_id", "task_id", "replicate", "runner_image_sha256", "attempts", "review"],
  "properties": {
    "schema": {"const": "execute.ai-productivity.run/1"},
    "trial_type": {"const": "evaluation"},
    "run_id": {"type": "string", "format": "uuid"},
    "blind_arm_id": {"type": "string", "pattern": "^arm_[a-z0-9]{8,32}$"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
    "replicate": {"type": "integer", "minimum": 1},
    "runner_image_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "attempts": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {"$ref": "#/$defs/attempt"}
    },
    "review": {
      "type": "object",
      "required": ["scoring_locked", "ratings"],
      "properties": {
        "scoring_locked": {"type": "boolean"},
        "ratings": {"type": "array", "items": {"$ref": "#/$defs/rating"}},
        "adjudication": {"oneOf": [{"$ref": "#/$defs/rating"}, {"type": "null"}]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "attempt": {
      "type": "object",
      "required": ["stage", "artifact_sha256", "started_utc", "generation_ms", "execution_ms", "usage", "cost", "oracle_status", "criteria_results", "diagnostic_feedback_sent"],
      "properties": {
        "stage": {"enum": ["generate", "repair"]},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "started_utc": {"type": "string", "format": "date-time"},
        "generation_ms": {"type": "integer", "minimum": 0},
        "execution_ms": {"type": "integer", "minimum": 0},
        "usage": {
          "type": "object",
          "required": ["basis", "input_tokens", "output_tokens", "reasoning_tokens", "cached_input_tokens"],
          "properties": {
            "basis": {"enum": ["provider_reported", "tokenizer_estimate", "unavailable"]},
            "input_tokens": {"type": ["integer", "null"], "minimum": 0},
            "output_tokens": {"type": ["integer", "null"], "minimum": 0},
            "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
            "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0}
          },
          "additionalProperties": false
        },
        "cost": {
          "type": "object",
          "required": ["basis", "amount", "currency"],
          "properties": {
            "basis": {"enum": ["provider_reported", "price_sheet_estimate", "unavailable"]},
            "amount": {"type": ["string", "null"], "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
            "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"}
          },
          "additionalProperties": false
        },
        "oracle_status": {"enum": ["pass", "fail", "infrastructure_error", "provider_refusal", "provider_timeout", "invalid_artifact"]},
        "criteria_results": {"type": "object", "additionalProperties": {"type": "boolean"}},
        "diagnostic_feedback_sent": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "rating": {
      "type": "object",
      "required": ["rater_id", "rubric_sha256", "requirement_coverage", "clarity", "changeability"],
      "properties": {
        "rater_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
        "rubric_sha256": {"$ref": "#/$defs/sha256"},
        "requirement_coverage": {"type": "integer", "minimum": 1, "maximum": 5},
        "clarity": {"type": "integer", "minimum": 1, "maximum": 5},
        "changeability": {"type": "integer", "minimum": 1, "maximum": 5}
      },
      "additionalProperties": false
    }
  }
}
