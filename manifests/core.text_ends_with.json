{
  "name": "text.ends_with",
  "description": "Returns whether the input text ends with the exact supplied suffix.",
  "phrases": [
    "check text ending"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "description": "Text to inspect; omitted text is read from UTF-8 stdin."
    },
    "suffix": {
      "type": "string",
      "required": true,
      "description": "Exact ending to test; an empty suffix matches."
    }
  },
  "arguments": [
    {
      "literal": "text.ends_with"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "boolean"
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        },
        "suffix": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "boolean"
          }
        }
      }
    },
    "capabilities": [
      "text.transform"
    ]
  },
  "examples": [
    {
      "program": "run text.ends_with with text \"report.csv\" and suffix \".csv\" as value",
      "expected_output": true
    }
  ]
}
