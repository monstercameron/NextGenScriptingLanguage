# Purpose: Review candidate duplicate alerts for safe grouping; prepare bounded evidence and save a review-only model-assisted report.
# Inputs: local source.json evidence, explicit model fixtures, and a private empty environment file.
# Outputs: out/duplicate-alert-review.json; the workflow never changes the source evidence.
accept source_path as text with default "fixtures/007/source.json"
accept report_path as text with default "out/duplicate-alert-review.json"
accept classify_fixture_path as text with default "fixtures/007/judge-evidence-ready.json"
accept draft_fixture_path as text with default "fixtures/007/draft.json"
accept generator_model as text with default "gpt-6-luna"
accept env_file as text with default ".env"
accept live as boolean with default false
# Refuse an output path that aliases an existing evidence or schema file.
run "test" with arguments ["!", source_path, "-ef", report_path]
run cat with path source_path
then jq with flags ["-c", "-S"] and filter "[.alerts|sort_by(.fingerprint,.started)|group_by(.fingerprint)[]|{fingerprint:.[0].fingerprint,alert_ids:map(.id),count:length,service:.[0].service}]" as evidence
if live is true
  then jev.judge with question "Is it safe to propose grouping only alerts with identical fingerprints while preserving their individual IDs?" and minimum 80 and env_file env_file as raw
otherwise
  then jev.judge with question "Is it safe to propose grouping only alerts with identical fingerprints while preserving their individual IDs?" and minimum 80 and fixture classify_fixture_path and env_file env_file as raw
then parse json as decision
take boolean at "/decision" from decision as verdict
take boolean at "/accepted" from decision as accepted
take integer at "/confidence_percent" from decision as confidence
if accepted is true
  if verdict is true
    run cat with path source_path
    then jq with flags ["-c", "-S"] and filter "[.alerts|sort_by(.fingerprint,.started)|group_by(.fingerprint)[]|{fingerprint:.[0].fingerprint,alert_ids:map(.id),count:length,service:.[0].service}]"
    if live is true
      then llm.ask with model generator_model and instruction "Draft a cautious grouping recommendation from exact fingerprints only. Preserve alert IDs and leave the final grouping to an operator." and env_file env_file as draft_raw
    otherwise
      then llm.ask with model generator_model and instruction "Draft a cautious grouping recommendation from exact fingerprints only. Preserve alert IDs and leave the final grouping to an operator." and fixture draft_fixture_path and env_file env_file as draft_raw
    then parse json as generated
    take text at "/text" from generated as draft
    run jq with flags ["-n", "-r", "-j", "--arg", "draft", draft, "--arg", "evidence", evidence] and filter "if ($draft | startswith(\"EVIDENCE:\")) and ([$evidence | scan(\"[A-Z][A-Z0-9]+-[A-Z0-9-]+\") | . as $id | select($draft | contains($id))] | length > 0) then $draft else error(\"draft must start with EVIDENCE and cite an ID in bounded local evidence\") end" as validated_draft
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "alert_grouping_review", "--arg", "status", "draft-for-human-review", "--arg", "classification", "confirmed", "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "--arg", "grouping_note", validated_draft, "--arg", "action", "A human owner reviews this proposed analysis before acting.", "{artifact:$artifact,status:$status,confidence_percent:$confidence,evidence_excerpt:$evidence,grouping_note:$grouping_note,action:$action,classification:$classification}"]
    then save to report_path
  otherwise
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "alert_grouping_review", "--arg", "status", "needs-human-review", "--arg", "classification", "not-confirmed", "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "--arg", "reason", "The accepted result did not match this workflow’s positive label, decision, or score level; generated analysis was withheld.", "--arg", "action", "An owner checks the original records and decides the next step.", "{artifact:$artifact,status:$status,confidence_percent:$confidence,evidence_excerpt:$evidence,grouping_note:null,reason:$reason,action:$action,classification:$classification}"]
    then save to report_path
otherwise
  then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "alert_grouping_review", "--arg", "status", "needs-human-review", "--arg", "classification", "uncertain", "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "--arg", "reason", "The model signal is below the configured 80 percent floor; no generated analysis was requested.", "--arg", "action", "An owner checks the original records and decides the next step.", "{artifact:$artifact,status:$status,confidence_percent:$confidence,evidence_excerpt:$evidence,grouping_note:null,reason:$reason,action:$action,classification:$classification}"]
  then save to report_path
then cat with path report_path
