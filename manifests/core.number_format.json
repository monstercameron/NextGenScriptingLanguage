{
  "name": "number.format",
  "description": "Format a finite number as locale-independent text with optional precision, digit grouping, and percent suffix.",
  "phrases": [
    "number format",
    "value format"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "value": {
      "type": "json",
      "required": true,
      "description": "Finite number to format."
    },
    "precision": {
      "type": "integer",
      "description": "Number of fractional digits for noninteger values; defaults to 0 and must be from 0 through 15."
    },
    "grouping": {
      "type": "boolean",
      "description": "When true, insert commas between groups of three integer digits."
    },
    "percent": {
      "type": "boolean",
      "description": "When true, append a percent sign without scaling the value."
    }
  },
  "arguments": [
    {
      "literal": "number.format"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "text"
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "number"
          }
        },
        "precision": {
          "delivery": "single",
          "schema": {
            "type": "integer"
          }
        },
        "grouping": {
          "delivery": "single",
          "schema": {
            "type": "boolean"
          }
        },
        "percent": {
          "delivery": "single",
          "schema": {
            "type": "boolean"
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        }
      }
    },
    "capabilities": [
      "number.compute"
    ]
  },
  "parameter_alternatives": [
    {
      "message": "precision must be an integer from 0 through 15",
      "any_of": [
        [
          {
            "test": "absent",
            "parameter": "precision"
          }
        ],
        [
          {
            "test": "number_range",
            "parameter": "precision",
            "minimum": 0,
            "maximum": 15
          }
        ]
      ]
    }
  ],
  "examples": [
    {
      "program": "run number.format with value 12345.6 and precision 2 and grouping true as result",
      "expected_output": "12,345.60"
    }
  ]
}
