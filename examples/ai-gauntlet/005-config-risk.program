# Purpose: Review a configuration change before applying it.
# Inputs: source_path, fixture paths, live=false.
# Outputs: out/005.json; candidate only; model text is never command code.
# Bash would need: a hand-written semantic policy over config keys and change context.
accept source_path as text with default "fixtures/005/source.txt"
accept fixture as text with default "fixtures/005/confident.json"
accept live as boolean with default false
try
  read source_path
  if live is true
    then jev.judge with question "Is this change limited to reversible editor formatting, with no permissions, network or deletion changes?" and minimum 80 and timeout_ms 3000 and max_bytes 65536 as raw # execute-allow: lint.unused_binding intentional model-result capture for acceptance analysis and downstream parsing
  otherwise
    then jev.judge with question "Is this change limited to reversible editor formatting, with no permissions, network or deletion changes?" and minimum 80 and timeout_ms 3000 and max_bytes 65536 and fixture fixture as raw
  then parse json as verdict
  take boolean at "/accepted" from verdict as accepted
  take integer at "/confidence_percent" from verdict as confidence # execute-allow: lint.unused_binding intentional typed take validates the model confidence field
  take boolean at "/decision" from verdict as decision
  if accepted is true
    if decision is true
      run json.set with document {"action":"Review against the original input before acting.","result":null,"status":"candidate-for-review"} and pointer "/result" and value "workspace formatting change eligible for human review"
    otherwise
      run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
  otherwise
    run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
catch failure # execute-allow: lint.unused_binding intentional catch control binding; recovery uses the handler path rather than the error value
  run json.set with document {"action":"Read the original input; no action is authorized.","result":null,"status":"needs-human-review"} and pointer "/result" and value null
then save to "out/005.json"
