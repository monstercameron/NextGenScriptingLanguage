{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Execute Program",
  "scopeName": "source.execute",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#control-flow"
    },
    {
      "include": "#task-group"
    },
    {
      "include": "#job-control"
    },
    {
      "include": "#graph"
    },
    {
      "include": "#condition"
    },
    {
      "include": "#otherwise"
    },
    {
      "include": "#structured-json"
    },
    {
      "include": "#loop-repeat"
    },
    {
      "include": "#loop-foreach"
    },
    {
      "include": "#unsupported"
    },
    {
      "include": "#stdin"
    },
    {
      "include": "#read-stdin"
    },
    {
      "include": "#read"
    },
    {
      "include": "#folder"
    },
    {
      "include": "#save"
    },
    {
      "include": "#timer"
    },
    {
      "include": "#schedule"
    },
    {
      "include": "#stream-limit"
    },
    {
      "include": "#stream-sink"
    },
    {
      "include": "#component"
    },
    {
      "include": "#widget"
    },
    {
      "include": "#program-input"
    },
    {
      "include": "#nested-program-input"
    },
    {
      "include": "#ports"
    },
    {
      "include": "#connect"
    },
    {
      "include": "#place"
    },
    {
      "include": "#layout"
    },
    {
      "include": "#record-event"
    },
    {
      "include": "#event"
    },
    {
      "include": "#widget-item"
    },
    {
      "include": "#ui-action"
    },
    {
      "include": "#program-call"
    },
    {
      "include": "#direct-invocation"
    },
    {
      "include": "#invocation"
    },
    {
      "include": "#implicit-invocation"
    }
  ],
  "repository": {
    "comments": {
      "match": "(#).*$",
      "name": "comment.line.number-sign.execute",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.execute"
        }
      }
    },
    "strings": {
      "name": "string.quoted.double.execute",
      "begin": "\"",
      "end": "\"|$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.execute"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.execute"
        }
      },
      "patterns": [
        {
          "match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9a-fA-F]{4})",
          "name": "constant.character.escape.execute"
        },
        {
          "match": "\\\\.|\\\\(?=$)",
          "name": "invalid.illegal.escape.execute"
        },
        {
          "match": "[\\x00-\\x1f]",
          "name": "invalid.illegal.control-character.execute"
        }
      ]
    },
    "values": {
      "patterns": [
        {
          "include": "#strings"
        },
        {
          "include": "#comments"
        },
        {
          "include": "#lists"
        },
        {
          "include": "#objects"
        },
        {
          "match": "\\bnull\\b",
          "name": "constant.language.null.execute"
        },
        {
          "match": "(?<![\\w.+-])-?[0-9]+(?:\\.[0-9]+)?[eE][+-]?[0-9]+(?![\\w.])|(?<![\\w.+-])-?[0-9]+\\.[0-9]+(?![\\w.])",
          "name": "constant.numeric.float.execute"
        },
        {
          "match": "(?<![\\w.+-])-?[0-9]+(?![\\w.])",
          "name": "constant.numeric.integer.execute"
        },
        {
          "match": "\\b(?:true|false)\\b",
          "name": "constant.language.boolean.execute"
        },
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
          "name": "variable.other.readwrite.execute"
        }
      ]
    },
    "objects": {
      "name": "meta.mapping.json.execute",
      "begin": "\\{",
      "end": "\\}|(?=$)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.mapping.begin.execute"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.mapping.end.execute"
        }
      },
      "patterns": [
        {
          "match": ",",
          "name": "punctuation.separator.sequence.execute"
        },
        {
          "match": ":",
          "name": "punctuation.separator.key-value.execute"
        },
        {
          "include": "#values"
        }
      ]
    },
    "lists": {
      "name": "meta.sequence.list.execute",
      "begin": "\\[",
      "end": "\\]|(?=$)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.brackets.begin.execute"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.brackets.end.execute"
        }
      },
      "patterns": [
        {
          "match": ",",
          "name": "punctuation.separator.sequence.execute"
        },
        {
          "include": "#values"
        }
      ]
    },
    "cache": {
      "match": "\\b(and)[ \\t]+(cache)(?=[ \\t]*(?:#.*)?$)",
      "captures": {
        "1": {
          "name": "keyword.operator.parameter.execute"
        },
        "2": {
          "name": "storage.modifier.cache.execute"
        }
      }
    },
    "bindings": {
      "match": "\\b(as)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)(?=[ \\t]*(?:and[ \\t]+keep[ \\t]+status[ \\t]+as[ \\t]+[A-Za-z_][A-Za-z0-9_]*[ \\t]*)?(?:and[ \\t]+cache[ \\t]*)?(?:#.*)?$)",
      "captures": {
        "1": {
          "name": "keyword.operator.binding.execute"
        },
        "2": {
          "name": "variable.other.definition.execute"
        }
      }
    },
    "parameters": {
      "name": "meta.argument.execute",
      "begin": "\\b(with|and)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)[ \\t]+",
      "beginCaptures": {
        "1": {
          "name": "keyword.operator.parameter.execute"
        },
        "2": {
          "name": "variable.parameter.execute"
        }
      },
      "end": "(?<=\\S)(?=[ \\t]+(?:and|as)\\b)|(?=[ \\t]*#)|$",
      "patterns": [
        {
          "include": "#values"
        }
      ]
    },
    "unsupported": {
      "match": "^[ \\t]*(?:else|for|loop)\\b",
      "name": "invalid.illegal.unsupported-control.execute"
    },
    "control-flow": {
      "patterns": [
        {
          "match": "^[ \\t]*(try)(?=[ \\t]*(?:#.*)?$)",
          "captures": {
            "1": {
              "name": "keyword.control.exception.execute"
            }
          }
        },
        {
          "match": "^[ \\t]*(catch)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)(?=[ \\t]*(?:#.*)?$)",
          "captures": {
            "1": {
              "name": "keyword.control.exception.execute"
            },
            "2": {
              "name": "variable.other.definition.execute"
            }
          }
        },
        {
          "match": "^[ \\t]*(finally)(?=[ \\t]*(?:#.*)?$)",
          "captures": {
            "1": {
              "name": "keyword.control.exception.execute"
            }
          }
        },
        {
          "match": "^[ \\t]*(break|continue|return)(?=[ \\t]*(?:#.*)?$)",
          "captures": {
            "1": {
              "name": "keyword.control.transfer.execute"
            }
          }
        }
      ]
    },
    "task-group": {
      "match": "^[ \\t]*(parallel|race)[ \\t]+(at[ \\t]+most)[ \\t]+([0-9]+)[ \\t]+(as)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)(?=[ \\t]*(?:#.*)?$)",
      "captures": {
        "1": {
          "name": "keyword.control.task-group.execute"
        },
        "2": {
          "name": "keyword.other.task-group.execute"
        },
        "3": {
          "name": "constant.numeric.integer.execute"
        },
        "4": {
          "name": "keyword.operator.binding.execute"
        },
        "5": {
          "name": "variable.other.definition.execute"
        }
      }
    },
    "job-control": {
      "patterns": [
        {
          "match": "^[ \\t]*(spawn)[ \\t]+(as)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)(?=[ \\t]*(?:#.*)?$)",
          "captures": {
            "1": {
              "name": "keyword.control.job.execute"
            },
            "2": {
              "name": "keyword.operator.binding.execute"
            },
            "3": {
              "name": "variable.other.definition.job.execute"
            }
          }
        },
        {
          "match": "^[ \\t]*(inspect)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)[ \\t]+(as)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)(?=[ \\t]*(?:#.*)?$)",
          "captures": {
            "1": {
              "name": "keyword.control.job.execute"
            },
            "2": {
              "name": "variable.other.job.execute"
            },
            "3": {
              "name": "keyword.operator.binding.execute"
            },
            "4": {
              "name": "variable.other.definition.execute"
            }
          }
        },
        {
          "match": "^[ \\t]*(await)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)(?:[ \\t]+(and)[ \\t]+(keep[ \\t]+status)[ \\t]+(as)[ \\t]+([A-Za-z_][A-Za-z0-9_]*))?(?:[ \\t]+(and)[ \\t]+(keep[ \\t]+result)[ \\t]+(as)[ \\t]+([A-Za-z_][A-Za-z0-9_]*))?(?=[ \\t]*(?:#.*)?$)",
          "captures": {
            "1": {
              "name": "keyword.control.job.execute"
            },
            "2": {
              "name": "variable.other.job.execute"
            },
            "3": {
              "name": "keyword.operator.parameter.execute"
            },
            "4": {
              "name": "storage.modifier.status.execute"
            },
            "5": {
              "name": "keyword.operator.binding.execute"
            },
            "6": {
              "name": "variable.other.definition.execute"
            },
            "7": {
              "name": "keyword.operator.parameter.execute"
            },
            "8": {
              "name": "storage.modifier.result.execute"
            },
            "9": {
              "name": "keyword.operator.binding.execute"
            },
            "10": {
              "name": "variable.other.definition.execute"
            }
          }
        },
        {
          "match": "^[ \\t]*(cancel)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)(?=[ \\t]*(?:#.*)?$)",
          "captures": {
            "1": {
              "name": "keyword.control.job.execute"
            },
            "2": {
              "name": "variable.other.job.execute"
            }
          }
        }
      ]
    },
    "graph": {
      "patterns": [
        {
          "match": "^[ \\t]*(graph)[ \\t]+([A-Za-z_][A-Za-z0-9_-]*)(?=[ \\t]*(?:#.*)?$)",
          "captures": {
            "1": {
              "name": "keyword.declaration.graph.execute"
            },
            "2": {
              "name": "entity.name.type.graph.execute"
            }
          }
        },
        {
          "match": "^[ \\t]*(end)[ \\t]+(graph)(?=[ \\t]*(?:#.*)?$)",
          "captures": {
            "1": {
              "name": "keyword.control.graph.execute"
            },
            "2": {
              "name": "keyword.control.graph.execute"
            }
          }
        },
        {
          "include": "#graph-edge"
        },
        {
          "include": "#graph-result-event"
        },
        {
          "include": "#graph-timer"
        },
        {
          "include": "#graph-listener"
        },
        {
          "include": "#graph-render"
        }
      ]
    },
    "graph-result-event": {
      "match": "^[ \\t]*(emit)[ \\t]+(result)[ \\t]+(from)[ \\t]+([A-Za-z_][A-Za-z0-9_-]*)[ \\t]+(to)[ \\t]+([A-Za-z_][A-Za-z0-9_-]*)(?=[ \\t]*(?:#.*)?$)",
      "captures": {
        "1": {
          "name": "keyword.control.graph.execute"
        },
        "2": {
          "name": "keyword.other.result.execute"
        },
        "3": {
          "name": "keyword.operator.connection.execute"
        },
        "4": {
          "name": "variable.other.graph-node.execute"
        },
        "5": {
          "name": "keyword.operator.connection.execute"
        },
        "6": {
          "name": "variable.other.graph-port.execute"
        }
      }
    },
    "graph-edge": {
      "name": "meta.graph-edge.execute",
      "begin": "^[ \\t]*(bind)[ \\t]+([A-Za-z_][A-Za-z0-9_-]*)(\\.)([A-Za-z_][A-Za-z0-9_-]*)[ \\t]+(to)[ \\t]+([A-Za-z_][A-Za-z0-9_-]*)(\\.)([A-Za-z_][A-Za-z0-9_-]*)",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.graph.execute"
        },
        "2": {
          "name": "variable.other.graph-node.execute"
        },
        "3": {
          "name": "punctuation.accessor.execute"
        },
        "4": {
          "name": "variable.other.graph-port.execute"
        },
        "5": {
          "name": "keyword.operator.connection.execute"
        },
        "6": {
          "name": "variable.other.graph-node.execute"
        },
        "7": {
          "name": "punctuation.accessor.execute"
        },
        "8": {
          "name": "variable.other.graph-port.execute"
        }
      },
      "patterns": [
        {
          "match": "\\bwith[ \\t]+capacity\\b",
          "name": "keyword.other.graph-edge.execute"
        },
        {
          "match": "\\b[0-9]+\\b",
          "name": "constant.numeric.integer.execute"
        },
        {
          "match": "\\b(?:lossless|latest)\\b|\\bdrop[ \\t]+(?:newest|oldest)\\b",
          "name": "constant.language.graph-policy.execute"
        },
        {
          "include": "#comments"
        }
      ]
    },
    "graph-timer": {
      "match": "^[ \\t]*(every)[ \\t]+([0-9]+)[ \\t]+(milliseconds?|seconds?|minutes?|hours?)[ \\t]+(as)[ \\t]+([A-Za-z_][A-Za-z0-9_-]*)(?=[ \\t]*(?:#.*)?$)",
      "captures": {
        "1": {
          "name": "keyword.control.timer.execute"
        },
        "2": {
          "name": "constant.numeric.integer.execute"
        },
        "3": {
          "name": "support.type.duration.execute"
        },
        "4": {
          "name": "keyword.operator.binding.execute"
        },
        "5": {
          "name": "variable.other.graph-node.execute"
        }
      }
    },
    "graph-listener": {
      "match": "^[ \\t]*(listen[ \\t]+to)[ \\t]+(stdin)[ \\t]+(as)[ \\t]+([A-Za-z_][A-Za-z0-9_-]*)(?=[ \\t]*(?:#.*)?$)",
      "captures": {
        "1": {
          "name": "keyword.control.listen.execute"
        },
        "2": {
          "name": "constant.language.stdin.execute"
        },
        "3": {
          "name": "keyword.operator.binding.execute"
        },
        "4": {
          "name": "variable.other.graph-node.execute"
        }
      }
    },
    "graph-render": {
      "name": "meta.graph-render.execute",
      "begin": "^[ \\t]*(render)[ \\t]+(quickshell|tui)(:)(text|button)\\b",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.graph.execute"
        },
        "2": {
          "name": "support.type.renderer.execute"
        },
        "3": {
          "name": "punctuation.separator.colon.execute"
        },
        "4": {
          "name": "support.type.renderer-component.execute"
        }
      },
      "patterns": [
        {
          "match": "\\bwith[ \\t]+properties\\b",
          "name": "keyword.other.property.execute"
        },
        {
          "include": "#bindings"
        },
        {
          "include": "#values"
        }
      ]
    },
    "stdin": {
      "match": "^[ \\t]*(listen[ \\t]+to)[ \\t]+(stdin)(?=[ \\t]*(?:#|$))",
      "captures": {
        "1": {
          "name": "keyword.control.listen.execute"
        },
        "2": {
          "name": "constant.language.stdin.execute"
        }
      }
    },
    "read": {
      "name": "meta.read.execute",
      "begin": "^[ \\t]*(read(?:[ \\t]+file)?)(?=[ \\t]|$)",
      "end": "$",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#bindings"
        },
        {
          "include": "#values"
        }
      ],
      "beginCaptures": {
        "1": {
          "name": "keyword.control.io.execute"
        }
      }
    },
    "folder": {
      "name": "meta.folder.execute",
      "begin": "^[ \\t]*(use[ \\t]+folder)(?=[ \\t]|$)",
      "end": "$",
      "patterns": [
        {
          "include": "#values"
        }
      ],
      "beginCaptures": {
        "1": {
          "name": "keyword.control.cwd.execute"
        }
      }
    },
    "save": {
      "name": "meta.save.execute",
      "begin": "^[ \\t]*(then[ \\t]+save[ \\t]+to(?:[ \\t]+file)?)(?=[ \\t]|$)",
      "end": "$",
      "patterns": [
        {
          "include": "#values"
        }
      ],
      "beginCaptures": {
        "1": {
          "name": "keyword.control.io.execute"
        }
      }
    },
    "timer": {
      "name": "meta.timer.execute",
      "begin": "^[ \\t]*(every)(?=[ \\t]|$)",
      "end": "$",
      "patterns": [
        {
          "include": "#duration"
        },
        {
          "include": "#values"
        }
      ],
      "beginCaptures": {
        "1": {
          "name": "keyword.control.timer.execute"
        }
      }
    },
    "duration": {
      "match": "\\b(?:milliseconds?|seconds?|minutes?|hours?)\\b",
      "name": "support.type.duration.execute"
    },
    "schedule": {
      "name": "meta.schedule.execute",
      "begin": "^[ \\t]*(on[ \\t]+schedule)(?=[ \\t]|$)",
      "end": "$",
      "patterns": [
        {
          "include": "#values"
        }
      ],
      "beginCaptures": {
        "1": {
          "name": "keyword.control.schedule.execute"
        }
      }
    },
    "stream-limit": {
      "name": "meta.stream-limit.execute",
      "begin": "^[ \\t]*(take[ \\t]+the[ \\t]+first)(?=[ \\t]|$)",
      "end": "$",
      "patterns": [
        {
          "include": "#line-unit"
        },
        {
          "include": "#values"
        }
      ],
      "beginCaptures": {
        "1": {
          "name": "keyword.control.limit.execute"
        }
      }
    },
    "line-unit": {
      "match": "\\blines?\\b",
      "name": "support.type.record.execute"
    },
    "stream-sink": {
      "match": "^[ \\t]*(show[ \\t]+each[ \\t]+line)(?=[ \\t]*(?:#|$))",
      "captures": {
        "1": {
          "name": "keyword.control.output.execute"
        }
      }
    },
    "component": {
      "name": "meta.component.execute",
      "begin": "^[ \\t]*(define[ \\t]+a[ \\t]+program[ \\t]+named)[ \\t]+([A-Za-z][A-Za-z0-9_]*)",
      "end": "$",
      "patterns": [
        {
          "include": "#comments"
        }
      ],
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.program.execute"
        },
        "2": {
          "name": "entity.name.type.component.execute"
        }
      }
    },
    "widget": {
      "name": "meta.widget.execute",
      "begin": "^[ \\t]*(show[ \\t]+a)[ \\t]+(heading|text[ \\t]+field|list|table|text[ \\t]+panel|badge|button|line[ \\t]+chart|bar[ \\t]+chart)[ \\t]+(named)[ \\t]+([A-Za-z][A-Za-z0-9_]*)",
      "end": "$",
      "patterns": [
        {
          "include": "#widget-properties"
        },
        {
          "include": "#values"
        }
      ],
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.widget.execute"
        },
        "2": {
          "name": "support.type.widget.execute"
        },
        "3": {
          "name": "keyword.declaration.name.execute"
        },
        "4": {
          "name": "entity.name.tag.widget.execute"
        }
      }
    },
    "widget-properties": {
      "match": "\\b(?:with[ \\t]+(?:text|value|key)|labelled)\\b",
      "name": "keyword.other.property.execute"
    },
    "ports": {
      "match": "^[ \\t]*(accept|offer)[ \\t]+([A-Za-z][A-Za-z0-9_]*)[ \\t]+(as)[ \\t]+(text)\\b",
      "captures": {
        "1": {
          "name": "keyword.declaration.port.execute"
        },
        "2": {
          "name": "variable.parameter.port.execute"
        },
        "3": {
          "name": "keyword.operator.type.execute"
        },
        "4": {
          "name": "support.type.text.execute"
        }
      }
    },
    "connect": {
      "match": "^[ \\t]*(connect)[ \\t]+([A-Za-z][A-Za-z0-9_]*)[ \\t]+(from)[ \\t]+([A-Za-z][A-Za-z0-9_]*)[ \\t]+(to)[ \\t]+([A-Za-z][A-Za-z0-9_]*)[ \\t]+(in)[ \\t]+([A-Za-z][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.connect.execute"
        },
        "2": {
          "name": "variable.other.port.execute"
        },
        "3": {
          "name": "keyword.operator.connection.execute"
        },
        "4": {
          "name": "variable.other.component.execute"
        },
        "5": {
          "name": "keyword.operator.connection.execute"
        },
        "6": {
          "name": "variable.other.port.execute"
        },
        "7": {
          "name": "keyword.operator.connection.execute"
        },
        "8": {
          "name": "variable.other.component.execute"
        }
      }
    },
    "place": {
      "match": "^[ \\t]*(place)[ \\t]+([A-Za-z][A-Za-z0-9_]*)[ \\t]+(on[ \\t]+the)[ \\t]+(left|right)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.layout.execute"
        },
        "2": {
          "name": "variable.other.component.execute"
