{
  "name": "head",
  "description": "Prints the requested number of leading lines from standard input.",
  "binary": "head",
  "accepts_stdin": true,
  "cacheable": true,
  "parameters": {
    "lines": {
      "type": "integer",
      "required": true
    }
  },
  "arguments": [
    {
      "literal": "-n"
    },
    {
      "parameter": "lines"
    }
  ],
  "contract": {
    "version": 1,
    "backend": "command",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "raw"
    },
    "capabilities": [
      "process.exec"
    ],
    "effects": []
  }
}
