{
  "name": "json.sort_by",
  "description": "Sorts the root array by each item value selected by pointer, using string order by default or numeric order when numeric is true.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "pointer": {
      "type": "string",
      "required": false,
      "description": "JSON Pointer evaluated relative to each item to obtain its string or numeric sort key."
    },
    "document": {
      "type": "list",
      "items": "json",
      "required": true,
      "description": "Root JSON array to sort; stdin is used when omitted."
    },
    "numeric": {
      "type": "boolean",
      "required": false,
      "description": "Set true to compare numeric keys as numbers; false or omission requires string keys."
    }
  },
  "arguments": [
    {
      "literal": "json.sort_by"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "json"
    },
    "capabilities": [
      "json.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "pointer": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "document": {
          "schema": {
            "type": "list",
            "items": {
              "type": "json"
            }
          },
          "delivery": "single"
        },
        "numeric": {
          "schema": {
            "type": "boolean"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "json"
          }
        }
      }
    }
  },
  "phrases": [
    "json sort_by"
  ],
  "examples": [
    {
      "program": "run json.sort_by with document [{\"name\":\"Ada\",\"score\":9},{\"name\":\"Lin\",\"score\":7}] and pointer \"/score\" and numeric true as result",
      "expected_output": [
        {
          "name": "Lin",
          "score": 7
        },
        {
          "name": "Ada",
          "score": 9
        }
      ]
    }
  ]
}
