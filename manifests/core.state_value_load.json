{
  "name": "state.value_load",
  "description": "Loads a named small text value from the execute state directory. Returns found false with a null value when none has been stored.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "name": {
      "type": "string",
      "required": true,
      "description": "Value name: one or more slash-separated segments of ASCII letters, digits, '-', '_' or '.'. Segments may not be '.' or '..'."
    }
  },
  "arguments": [
    {
      "literal": "state.value_load"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "json",
      "encoding": "json"
    },
    "capabilities": [
      "filesystem.read"
    ],
    "effects": [
      "filesystem.read"
    ],
    "ports": {
      "inputs": {
        "name": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "load state value"
  ]
}
