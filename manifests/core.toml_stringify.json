{
  "name": "toml.stringify",
  "description": "Serializes a JSON record as TOML, writing scalar values and arrays before nested tables; null values are rejected because TOML has no null.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "value": {
      "type": "record",
      "required": true,
      "fields": {},
      "additional_properties": {
        "type": "json"
      },
      "description": "Record to serialize; nested JSON values must be representable in the supported TOML subset."
    }
  },
  "arguments": [
    {
      "literal": "toml.stringify"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "json"
    },
    "capabilities": [
      "text.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "value": {
          "schema": {
            "type": "record",
            "fields": {},
            "additionalProperties": {
              "type": "json"
            }
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "toml stringify"
  ],
  "examples": [
    {
      "program": "run toml.stringify with value {\"name\": \"Ada\"} as value",
      "expected_output": "name = \"Ada\"\n"
    }
  ]
}
