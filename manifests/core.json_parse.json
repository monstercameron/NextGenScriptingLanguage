{
  "name": "json.parse",
  "description": "Parses JSON text into a typed JSON value, taking text from the parameter or stdin.",
  "binary": "@execute-applet",
  "accepts_stdin": true,
  "parameters": {
    "text": {
      "type": "string",
      "description": "JSON source text to parse; when omitted, the applet reads JSON from stdin."
    }
  },
  "arguments": [
    {
      "literal": "json.parse"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "json",
      "encoding": "json"
    },
    "capabilities": [
      "json.convert"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "text": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "stdin": {
          "schema": {
            "type": "text"
          },
          "delivery": "single",
          "encoding": "raw"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "json"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "json parse"
  ],
  "examples": [
    {
      "program": "run json.parse with text \"{\\\"name\\\":\\\"Ada\\\"}\" as result",
      "expected_output": {
        "name": "Ada"
      }
    }
  ]
}
