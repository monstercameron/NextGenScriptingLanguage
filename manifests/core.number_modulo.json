{
  "name": "number.modulo",
  "description": "Return the signed remainder after dividing two integers with quotient truncated toward zero.",
  "phrases": [
    "number modulo",
    "left modulo"
  ],
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "left": {
      "type": "json",
      "required": true,
      "description": "Integer dividend."
    },
    "right": {
      "type": "json",
      "required": true,
      "description": "Nonzero integer divisor."
    }
  },
  "arguments": [
    {
      "literal": "number.modulo"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "backend": "in_process",
    "version": 1,
    "output": {
      "encoding": "json",
      "type": "integer"
    },
    "lifecycle": {
      "kind": "oneshot"
    },
    "effects": [],
    "ports": {
      "inputs": {
        "left": {
          "delivery": "single",
          "schema": {
            "type": "number"
          }
        },
        "right": {
          "delivery": "single",
          "schema": {
            "type": "number"
          }
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "integer"
          }
        }
      }
    },
    "capabilities": [
      "number.compute"
    ]
  },
  "examples": [
    {
      "program": "run number.modulo with left -17 and right 5 as result",
      "expected_output": -2
    }
  ]
}
