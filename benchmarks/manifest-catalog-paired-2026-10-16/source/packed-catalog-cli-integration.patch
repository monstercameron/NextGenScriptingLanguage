+pub fn render_for_workflow_with_manifest_catalog(
+    request: &WorkflowServiceRequest<'_>,
+    manifest_catalog: &Path,
+) -> Result<String> {
+    render_for_workflow_with_launchd_home_and_catalog(request, None, Some(manifest_catalog))
+}
