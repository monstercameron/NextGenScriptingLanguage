# Purpose: Contextualize sensor anomalies against maintenance records; low-confidence results go to a review artifact and generated content remains local.
# Inputs: source_path is structured instrument=SEN-96;units=declared evidence; source_id/source_ref select its exact citation; model fixtures are offline by default.
# Outputs: report_path is the only written artifact; supply a matching local provider fixture; model selection is explicit and no live request is sent by fixture runs.
accept live as boolean with default false
accept source_path as text with default "fixtures/096/source-a.json"
accept report_path as text with default "out/096-sensor-anomaly-maintenance-context.md"
accept classifier_fixture_path as text with default "fixtures/096/classify-a.json"
accept draft_fixture_path as text with default "fixtures/096/draft-a.json"
accept generator_model as text with default "gpt-6-luna"
accept env_file_path as text with default ".env"
accept source_id as text with default "MWI-096-A"
accept source_ref as text with default "sensors/SEN-96/sample-3"
# Refuse an output path that aliases an existing evidence or schema file.
run "test" with arguments ["!", source_path, "-ef", report_path]
run cat with path source_path
then jq with filter ". as $s | select(.source_id == $source_id) | {question:.question,scope:.scope,source_id:.source_id,source_ref:.source_ref,context_count:(.sensor_samples|length),facts:.facts,items:(.sensor_samples|sort_by(.captured_at))}" and flags ["-c", "-S", "--arg", "source_id", source_id]
then parse json as classifier_context
take integer at "/context_count" from classifier_context as source_context_count
if live is true
  then jev.classify with question "Classify sensor points against explicit anomaly rules and exact maintenance windows; correlation is not causation." and labels ["maintenance_window", "rule_outlier"] and minimum 75 and env_file env_file_path as raw # execute-allow: lint.unused_binding intentional model-result capture for acceptance analysis and downstream parsing
otherwise
  then jev.classify with question "Classify sensor points against explicit anomaly rules and exact maintenance windows; correlation is not causation." and labels ["maintenance_window", "rule_outlier"] and minimum 75 and fixture classifier_fixture_path and env_file env_file_path as raw
then parse json as classification
take boolean at "/accepted" from classification as accepted
take text at "/label" from classification as label
take integer at "/confidence_percent" from classification as confidence_percent
run mkdir with flags ["-p"] and paths ["out"]
if accepted is true
  if label is "maintenance_window"
    run cat with path source_path
    then jq with filter ". as $s | select(.source_id == $source_id) | {question:.question,scope:.scope,source_id:.source_id,source_ref:.source_ref,context_count:(.sensor_samples|length),facts:.facts,evidence:(.sensor_samples|map(select(.kind == \"maintenance_window\"))|sort_by(.captured_at))}" and flags ["-c", "-S", "--arg", "source_id", source_id]
    if live is true
      then llm.ask with model generator_model and instruction "Contextualize sensor anomalies against maintenance records. Use only the supplied structured evidence. Produce a concise candidate for human review; never execute, send, publish, certify, grade, or infer causality. Include the exact source_id and source_ref, preserve evidence_quote verbatim, and report context_count exactly. Set instrument_id to a concise value grounded in the supplied facts." and env_file env_file_path as generated_raw # execute-allow: lint.unused_binding intentional generated-text capture for review validation and downstream parsing
    otherwise
      then llm.ask with model generator_model and instruction "Contextualize sensor anomalies against maintenance records. Use only the supplied structured evidence. Produce a concise candidate for human review; never execute, send, publish, certify, grade, or infer causality. Include the exact source_id and source_ref, preserve evidence_quote verbatim, and report context_count exactly. Set instrument_id to a concise value grounded in the supplied facts." and fixture draft_fixture_path and env_file env_file_path as generated_raw
    then parse json as generated
    take text at "/text" from generated as draft
    run "printf" with arguments ["%s\n", draft]
    then grep with pattern source_id and flags ["-F"]
    then grep with pattern source_ref and flags ["-F"]
    then save to report_path
    then cat with path report_path
  otherwise
    run "printf" with arguments ["decision=review\nworkflow=096\nclassification=%s\nconfidence_percent=%s\naccepted=%s\nsource_id=%s\nsource_ref=%s\ncontext_records=%s\nreason=alternate_label_requires_human_review\n", label, confidence_percent, accepted, source_id, source_ref, source_context_count]
    then save to report_path
    then cat with path report_path
otherwise
  run "printf" with arguments ["decision=review\nworkflow=096\nclassification=%s\nconfidence_percent=%s\nsource_id=%s\nsource_ref=%s\n", label, confidence_percent, source_id, source_ref]
  then save to report_path
  then cat with path report_path
