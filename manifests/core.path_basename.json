{
  "name": "path.basename",
  "description": "Returns the final slash-delimited path component, optionally removing a matching nonempty suffix while preserving a component that would become empty.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "path": {
      "type": "path",
      "required": true,
      "description": "Path whose final component is requested; `/` separates components."
    },
    "suffix": {
      "type": "string",
      "description": "Optional exact suffix to remove from the basename; an empty suffix is ignored."
    }
  },
  "arguments": [
    {
      "literal": "path.basename"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "json"
    },
    "capabilities": [
      "path.inspect"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "path": {
          "schema": {
            "type": "path"
          },
          "delivery": "single"
        },
        "suffix": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "path basename"
  ],
  "examples": [
    {
      "program": "run path.basename with path \"/srv/log/app.log\" and suffix \".log\" as value",
      "expected_output": "app"
    }
  ]
}
