{
  "name": "number.multiply",
  "description": "Multiply two finite numbers and return their product.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "left": {
      "type": "json",
      "required": true,
      "description": "First finite number to multiply."
    },
    "right": {
      "type": "json",
      "required": true,
      "description": "Second finite number to multiply."
    }
  },
  "arguments": [
    {
      "literal": "number.multiply"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "number",
      "encoding": "json"
    },
    "capabilities": [
      "number.compute"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "left": {
          "schema": {
            "type": "number"
          },
          "delivery": "single"
        },
        "right": {
          "schema": {
            "type": "number"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "number"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "number multiply"
  ],
  "examples": [
    {
      "program": "run number.multiply with left 6 and right 7 as result",
      "expected_output": 42
    }
  ]
}
