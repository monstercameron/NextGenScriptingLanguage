# Purpose: Compare a discovered third-party license inventory with the declared attribution set and draft an owner-facing review queue.
# Inputs: Sorted license rows use LIC-* package IDs and exact package/version/license triples.
# Outputs: out/069-license-attribution-map.json: missing declaration evidence and attribution follow-up.
accept live as boolean with default false
accept source_path as text with default "fixtures/069/source-high.txt"
accept report_path as text with default "out/069-license-attribution-map.json"
accept classify_fixture_path as text with default "fixtures/069/classify-high.json"
accept draft_fixture_path as text with default "fixtures/069/draft.json"
accept generator_model as text with default "gpt-6-luna"
accept env_file as text with default ".env"
accept reference_path as text with default "fixtures/069/reference-high.tsv"
# Refuse an output path that aliases an existing evidence or schema file.
run "test" with arguments ["!", source_path, "-ef", report_path]
run "test" with arguments ["!", reference_path, "-ef", report_path]
run comm with flags ["-23"] and files [source_path, reference_path] as evidence
if live is true
  then jev.classify with question "Which discovered package license entries are absent from the supplied attribution inventory?" and labels ["attribution-gap", "needs-human"] and minimum 80 and env_file env_file as class_raw # execute-allow: lint.unused_binding intentional model-result capture for acceptance analysis and downstream parsing
otherwise
  then jev.classify with question "Which discovered package license entries are absent from the supplied attribution inventory?" and labels ["attribution-gap", "needs-human"] and minimum 80 and fixture classify_fixture_path and env_file env_file as class_raw
then parse json as classification
take text at "/label" from classification as label
take integer at "/confidence_percent" from classification as confidence
take boolean at "/accepted" from classification as accepted
if accepted is true
  if label is "attribution-gap"
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "label", label, "--argjson", "confidence", confidence, "--arg", "evidence", evidence, "{label:$label,confidence_percent:$confidence,evidence:$evidence}"]
    if live is true
      then llm.ask with model generator_model and instruction "Draft a license attribution follow-up for the missing LIC-* lines. Cite the exact package/version/license evidence and ask legal or release owners to verify obligations; do not provide a legal conclusion." and env_file env_file as draft_raw # execute-allow: lint.unused_binding intentional generated-text capture for review validation and downstream parsing
    otherwise
      then llm.ask with model generator_model and instruction "Draft a license attribution follow-up for the missing LIC-* lines. Cite the exact package/version/license evidence and ask legal or release owners to verify obligations; do not provide a legal conclusion." and fixture draft_fixture_path and env_file env_file as draft_raw
    then parse json as draft_result
    take text at "/text" from draft_result as draft
    run jq with flags ["-n", "-r", "--arg", "draft", draft, "--arg", "evidence", evidence] and filter "($draft | rtrimstr(\"\\n\")) as $candidate | if ($candidate | startswith(\"EVIDENCE:\")) and ([$evidence | scan(\"[A-Z][A-Z0-9]+-[A-Z0-9-]+\") | . as $id | select($candidate | contains($id))] | length > 0) then $candidate else error(\"draft must start with EVIDENCE and cite an ID present in the bounded evidence\") end" as validated_draft
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "third_party_license_attribution_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "draft", validated_draft, "--arg", "action", "Release owner and counsel validate notices and obligations.", "{artifact:$artifact,status:\"draft-for-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,attribution_followup:$draft,action:$action}"]
    then save to report_path
  otherwise
    then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "third_party_license_attribution_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "review_action", "No package metadata or release artifact is modified.", "{artifact:$artifact,status:\"needs-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,attribution_followup:null,reason:\"Classifier selected the human-review label above the confidence threshold; no LLM draft was requested.\",action:$review_action}"]
    then save to report_path
  then cat with path report_path
otherwise
  then "jq" with arguments ["-n", "-c", "-S", "--arg", "artifact", "third_party_license_attribution_review", "--arg", "classification", label, "--argjson", "confidence_percent", confidence, "--arg", "source_path", source_path, "--arg", "evidence", evidence, "--arg", "review_action", "No package metadata or release artifact is modified.", "{artifact:$artifact,status:\"needs-human-review\",classification:$classification,confidence_percent:$confidence_percent,source_path:$source_path,evidence_excerpt:$evidence,attribution_followup:null,reason:\"Classifier confidence is below the configured 80 percent threshold; no LLM draft was requested.\",action:$review_action}"]
  then save to report_path
then cat with path report_path
