{
  "name": "path.dirname",
  "description": "Returns the slash-delimited parent portion of a path, using `.` when it has no parent and `/` for root-level paths.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "path": {
      "type": "path",
      "required": true,
      "description": "Path whose parent component is requested; `/` separates components."
    }
  },
  "arguments": [
    {
      "literal": "path.dirname"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "json"
    },
    "capabilities": [
      "path.inspect"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "path": {
          "schema": {
            "type": "path"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "path dirname"
  ],
  "examples": [
    {
      "program": "run path.dirname with path \"/srv/log/app.log\" as value",
      "expected_output": "/srv/log"
    }
  ]
}
