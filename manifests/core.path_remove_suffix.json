{
  "name": "path.remove_suffix",
  "description": "Removes one exact suffix from a path string, returning the original string when it does not end with that suffix.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "path": {
      "type": "string",
      "required": true,
      "description": "Path text to transform."
    },
    "suffix": {
      "type": "string",
      "required": true,
      "description": "Nonempty exact ending to remove when present."
    }
  },
  "arguments": [
    {
      "literal": "path.remove_suffix"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "json"
    },
    "capabilities": [
      "path.inspect"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "path": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        },
        "suffix": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "schema": {
            "type": "text"
          },
          "delivery": "single"
        }
      }
    }
  },
  "phrases": [
    "path remove_suffix"
  ],
  "examples": [
    {
      "program": "run path.remove_suffix with path \"backup.tar.gz\" and suffix \".tar.gz\" as value",
      "expected_output": "backup"
    }
  ]
}
