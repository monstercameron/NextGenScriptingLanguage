{
  "name": "ps",
  "description": "Lists process information using the selected platform ps flags. Output reflects live host process state, so results change between runs and are never cached.",
  "binary": "ps",
  "cacheable": false,
  "parameters": {
    "flags": {
      "type": "list",
      "items": "string"
    }
  },
  "arguments": [
    {
      "when_present": "flags",
      "append": [
        {
          "spread": "flags"
        }
      ]
    }
  ],
  "contract": {
    "version": 1,
    "backend": "command",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "type": "text",
      "encoding": "raw"
    },
    "capabilities": [
      "process.exec"
    ],
    "effects": []
  }
}
