{
  "name": "time.diff",
  "description": "Subtracts the right Unix epoch second from the left and returns the difference in the selected unit, retaining whole results as integers.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "left": {
      "type": "integer",
      "required": true,
      "description": "Unix timestamp in whole seconds that is subtracted from."
    },
    "right": {
      "type": "integer",
      "required": true,
      "description": "Unix timestamp in whole seconds to subtract."
    },
    "unit": {
      "type": "string",
      "required": true,
      "enum": [
        "seconds",
        "minutes",
        "hours",
        "days"
      ],
      "description": "Unit for the returned difference: seconds, minutes, hours, or days."
    }
  },
  "arguments": [
    {
      "literal": "time.diff"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "number"
    },
    "capabilities": [
      "clock.read"
    ],
    "effects": [
      "clock.read"
    ],
    "ports": {
      "inputs": {
        "left": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "right": {
          "schema": {
            "type": "integer"
          },
          "delivery": "single"
        },
        "unit": {
          "schema": {
            "type": "text",
            "enum": [
              "seconds",
              "minutes",
              "hours",
              "days"
            ]
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "number"
          }
        }
      }
    }
  },
  "phrases": [
    "time diff"
  ],
  "examples": [
    {
      "program": "run time.diff with left 3600 and right 0 and unit \"minutes\" as value",
      "expected_output": 60
    }
  ]
}
