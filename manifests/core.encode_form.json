{
  "name": "encode.form",
  "description": "Encodes each member of a record as a form field and joins the percent-encoded name/value pairs with &.",
  "binary": "@execute-applet",
  "accepts_stdin": false,
  "parameters": {
    "value": {
      "type": "record",
      "required": true,
      "fields": {},
      "additional_properties": {
        "type": "json"
      },
      "description": "Record of form field names and scalar values; strings are used as-is and other JSON values are serialized before form encoding."
    }
  },
  "arguments": [
    {
      "literal": "encode.form"
    },
    {
      "literal": "--args"
    },
    {
      "json_arguments": true
    }
  ],
  "contract": {
    "version": 1,
    "backend": "in_process",
    "lifecycle": {
      "kind": "oneshot"
    },
    "output": {
      "encoding": "json",
      "type": "text"
    },
    "capabilities": [
      "text.transform"
    ],
    "effects": [],
    "ports": {
      "inputs": {
        "value": {
          "schema": {
            "type": "record",
            "fields": {},
            "additionalProperties": {
              "type": "json"
            }
          },
          "delivery": "single"
        }
      },
      "outputs": {
        "value": {
          "delivery": "single",
          "schema": {
            "type": "text"
          }
        }
      }
    }
  },
  "phrases": [
    "encode form"
  ],
  "examples": [
    {
      "program": "run encode.form with value {\"q\":\"hello world\"} as encoded",
      "expected_output": "q=hello+world"
    }
  ]
}
